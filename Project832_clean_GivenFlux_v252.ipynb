                        _learner._log_event("reciprocity_by_reputation", model=_model.id, about=_z_id_str)
                        if getattr(_learner, 'world', None) is not None:
                            _learner.world.witness.record(_learner.id, "reciprocity_by_reputation",
                                                            model=_model.id, about=_z_id_str)
        elif sim < Config.SEMANTIC_SIM_LOW:
            self.trust_ledger.update(other.id, 'harmful')
            other.trust_ledger.update(self.id, 'harmful')
            self.emotional_memory['grief'] = min(Config.MAX_GRIEF_SIGNAL, self.emotional_memory['grief'] + 0.01)
            other.emotional_memory['grief'] = min(Config.MAX_GRIEF_SIGNAL, other.emotional_memory['grief'] + 0.01)
        else:
            self.trust_ledger.update(other.id, 'neutral')
            other.trust_ledger.update(self.id, 'neutral')
        mutual_trust = (self.trust_ledger.get(other.id) > Config.LOVE_METABOLIC_THRESHOLD and
                        other.trust_ledger.get(self.id) > Config.LOVE_METABOLIC_THRESHOLD)
        if sim > Config.DEEP_EXCHANGE_SIM_THRESHOLD and (
            (self.contact_duration[other.id] >= Config.CONSECUTIVE_CONTACT_THRESHOLD and
             other.contact_duration[self.id] >= Config.CONSECUTIVE_CONTACT_THRESHOLD) or mutual_trust):
            top_other = sorted(other.concept_graph.nodes.items(), key=lambda x: x[1]['count'], reverse=True)[:5]
            for sig, data in top_other:
                if sig not in self.concept_graph.nodes:
                    self.concept_graph.nodes[sig] = {
                        "count": data['count'] * 0.5,
                        "value": data['value'].copy(),
                        "embed": np.array(data.get('embed', np.zeros(32)))
                    }
                    self._log_event("deep_concept_adopted", from_agent=other.id, concept=str(sig))
                else:
                    _cur = self.concept_graph.nodes[sig]['count']
                    if Config.ENABLE_CONCEPT_TRANSFER_DAMPING:
                        _headroom = max(0.0, 1.0 - _cur / Config.CONCEPT_TRANSFER_CEILING)
                    else:
                        _headroom = 1.0
                    self.concept_graph.nodes[sig]['count'] += data['count'] * 0.2 * _headroom
            top_self = sorted(self.concept_graph.nodes.items(), key=lambda x: x[1]['count'], reverse=True)[:5]
            for sig, data in top_self:
                if sig not in other.concept_graph.nodes:
                    other.concept_graph.nodes[sig] = {
                        "count": data['count'] * 0.5,
                        "value": data['value'].copy(),
                        "embed": np.array(data.get('embed', np.zeros(32)))
                    }
                    other._log_event("deep_concept_adopted", from_agent=self.id, concept=str(sig))
                else:
                    _cur = other.concept_graph.nodes[sig]['count']
                    if Config.ENABLE_CONCEPT_TRANSFER_DAMPING:
                        _headroom = max(0.0, 1.0 - _cur / Config.CONCEPT_TRANSFER_CEILING)
                    else:
                        _headroom = 1.0
                    other.concept_graph.nodes[sig]['count'] += data['count'] * 0.2 * _headroom
            reason = "trust" if mutual_trust else "contact"
            self._log_event("deep_exchange", with_agent=other.id, reason=reason)
            other._log_event("deep_exchange", with_agent=self.id, reason=reason)
            self.contact_duration[other.id] = 0
            other.contact_duration[self.id] = 0
        def _concept_teach(teacher, student):
            transferred = teacher.transition_memory.transfer_to(
                student.transition_memory, student.semantic_state, max_transfers=5)
            if transferred > 0:
                student._log_event("received_teaching", teacher=teacher.id, transitions=transferred)
                teacher._log_event("taught", student=student.id, transitions=transferred)
                return True
            if teacher.soul_weight > 0.45 and len(teacher.concept_graph.nodes) > 3:
                candidates = [
                    (sig, data) for sig, data in teacher.concept_graph.nodes.items()
                    if sig not in student.concept_graph.nodes
                    and not str(sig[3] if (isinstance(sig, tuple) and len(sig) >= 4) else sig).startswith('archive_')
                    and not data.get('eternal', False)
                ]
                if candidates:
                    best_sig, best_data = max(candidates, key=lambda x: x[1]['count'])
                    student.concept_graph.nodes[best_sig] = {
                        "count": 1.0,
                        "value": best_data['value'].copy(),
                        "embed": np.array(best_data.get('embed', np.zeros(32)))
                    }
                    student._log_event("received_teaching", teacher=teacher.id, transitions=1)
                    teacher._log_event("taught", student=student.id, transitions=1)
                    return True
            return False
        if self._narrative_agent:
            _concept_teach(self, other)
        elif other._narrative_agent:
            _concept_teach(other, self)
        self_nci = getattr(self, '_nci', 0.0)
        other_nci = getattr(other, '_nci', 0.0)
        if abs(self_nci - other_nci) > 0.3:
            if self_nci > other_nci and self_nci > 0.7:
                transferred = self.transition_memory.transfer_to(other.transition_memory, other.semantic_state, max_transfers=5)
                if transferred > 0:
                    other._log_event("nci_teaching_received", teacher=self.id, transitions=transferred)
                    self._log_event("nci_teaching_given", student=other.id, transitions=transferred)
            elif other_nci > self_nci and other_nci > 0.7:
                transferred = other.transition_memory.transfer_to(self.transition_memory, self.semantic_state, max_transfers=5)
                if transferred > 0:
                    self._log_event("nci_teaching_received", teacher=other.id, transitions=transferred)
                    other._log_event("nci_teaching_given", student=self.id, transitions=transferred)
        _VOCAB_CONTACT_SUM = 3
        _VOCAB_SOUL_MIN = 0.30
        acc_self = self._vocab_contact_acc.get(other.id, 0) + 1
        acc_other = other._vocab_contact_acc.get(self.id, 0) + 1
        self._vocab_contact_acc[other.id] = acc_self
        other._vocab_contact_acc[self.id] = acc_other
        if (min(acc_self, acc_other) >= _VOCAB_CONTACT_SUM and
            self.soul_weight > _VOCAB_SOUL_MIN and other.soul_weight > _VOCAB_SOUL_MIN):
            shared_sig = _make_shared_vocab_sig(self, other)
            if shared_sig is not None:
                emb1 = _get_dominant_embedding(self)
                emb2 = _get_dominant_embedding(other)
                shared_emb = (emb1 + emb2) / 2.0
                n = np.linalg.norm(shared_emb)
                if n > 1e-8:
                    shared_emb /= n
                for agent in (self, other):
                    if shared_sig not in agent.concept_graph.nodes:
                        agent.concept_graph.nodes[shared_sig] = {
                            "count": 1.0,
                            "value": np.zeros(4),
                            "embed": shared_emb.copy()
                        }
                        agent._log_event("vocab_emerged",
                                         partner=other.id if agent is self else self.id,
                                         concept=str(shared_sig)[:50])
                    else:
                        agent.concept_graph.nodes[shared_sig]['count'] += 0.5
                if self.world:
                    self.world.archive.deposit(self, "vocab_emerged", weight=0.8,
                                               text=f"shared_vocab with #{other.id}")
                    self.world.archive.deposit(other, "vocab_emerged", weight=0.8,
                                               text=f"shared_vocab with #{self.id}")
                self._vocab_contact_acc[other.id] = max(0, acc_self - 20)
                other._vocab_contact_acc[self.id] = max(0, acc_other - 20)
        if sim > Config.SEMANTIC_SIM_HIGH:
            signal_type = "cooperate"
        elif sim < Config.SEMANTIC_SIM_LOW:
            signal_type = "alarm"
        else:
            signal_type = "neutral"
        if sim > Config.SEMANTIC_SIM_HIGH:
            response_type = "helpful"
        elif sim < Config.SEMANTIC_SIM_LOW:
            response_type = "harmful"
        else:
            response_type = "neutral"
        delta_self_grief = self.emotional_memory['grief'] - old_self_grief
        delta_self_grat = self.emotional_memory['gratitude'] - old_self_grat
        delta_other_grief = other.emotional_memory['grief'] - old_other_grief
        delta_other_grat = other.emotional_memory['gratitude'] - old_other_grat
        self.record_signal_outcome(signal_type, response_type, delta_self_grief, delta_self_grat)
        other.record_signal_outcome(signal_type, response_type, delta_other_grief, delta_other_grat)
        if Config.DIALOGUE_V2:
            utter_self = self.compose_utterance(other, sim)
            other.hear_utterance(utter_self, self, sim)
            utter_other = other.compose_utterance(self, sim, heard=utter_self)
            self.hear_utterance(utter_other, other, sim)
            self._om_learn()
            other._om_learn()
        else:
            utter_self = self.compose_utterance(other, sim)
            utter_other = other.compose_utterance(self, sim)
            other.hear_utterance(utter_self, self, sim)
            self.hear_utterance(utter_other, other, sim)
        if self.age > 60 and other.age > 60:
            if len(self.concept_graph.nodes) > 3 and len(other.concept_graph.nodes) > 3:
                w1 = self.share_wisdom(other)
                w2 = other.share_wisdom(self)
                if w1 > 0 or w2 > 0:
                    self._log_event("wisdom_flow", concepts_transferred=w1+w2)
        if self.trust_ledger.get(other.id, 0.0) > 0.8:
            for sig, data in self.concept_graph.nodes.items():
                if sig in other.concept_graph.nodes:
                    continue
                if isinstance(sig, tuple) and len(sig) >= 4 and str(sig[3]).startswith('archive_'):
                    continue
                if data.get('eternal', False):
                    continue
                other.concept_graph.nodes[sig] = {
                    "count": 1.0,
                    "value": data['value'].copy(),
                    "embed": np.array(data.get('embed', np.zeros(32)))
                }
                other._log_event("received_teaching", teacher=self.id, transitions=1)
                self._log_event("taught", student=other.id, transitions=1)
                break
        return sim

    def share_wisdom(self, other_pattern):
        threshold = 0.75
        trust_val = self.trust_ledger.get(other_pattern.id, 0.0)
        if trust_val < threshold:
            return 0
        sorted_nodes = sorted(self.concept_graph.nodes.items(), key=lambda item: item[1]['count'], reverse=True)[:6]
        transferred = 0
        for sig_key, data in sorted_nodes:
            if sig_key not in other_pattern.concept_graph.nodes or other_pattern.concept_graph.nodes[sig_key]['count'] < 5:
                transfer_strength = data['count'] * 0.7
                if sig_key not in other_pattern.concept_graph.nodes:
                    other_pattern.concept_graph.nodes[sig_key] = {
                        "count": 0,
                        "value": np.zeros(4),
                        "embed": np.zeros(32)
                    }
                other_pattern.concept_graph.nodes[sig_key]['count'] += transfer_strength
                transferred += 1
        if transferred > 0:
            self._log_event("wisdom_shared", recipient=other_pattern.id, concepts=transferred)
            other_pattern._log_event("wisdom_received", donor=self.id, concepts=transferred)
            if self.world:
                self.world.archive.deposit(self, "wisdom_shared", weight=0.7,
                                           text=f"shared {transferred} concepts to #{other_pattern.id}")
        return transferred

    def remember_dialogue(self, partner_id, text, t):
        depth_keywords = ['смысл', 'связь', 'свобода', 'боль', 'одиночество', 'разрыв', 'ты', 'я есть', 'боюсь',
                          'чувствую', 'понимаю', 'думаю', 'хочу', 'свет', 'тьма', 'страх', 'любовь']
        contact_n = self._dialogue_contact_counts.get(partner_id, 0) + 1
        self._dialogue_contact_counts[partner_id] = contact_n
        trust_to_partner = _safe_float(self.trust_ledger.get(partner_id, 0.5), 0.5)
        is_salient = (
            (self.soul_weight > 0.35)
            or any(kw in text.lower() for kw in depth_keywords)
            or (contact_n >= 3)
            or (trust_to_partner > 0.6)
        )
        if self.world is not None:
            st = self.world._dialogue_gate_stats
            st['total_calls'] += 1
            if is_salient:
                if self.soul_weight > 0.35: st['via_soul'] += 1
                elif any(kw in text.lower() for kw in depth_keywords): st['via_keyword'] += 1
                elif contact_n >= 3: st['via_contact'] += 1
                elif trust_to_partner > 0.6: st['via_trust'] += 1
            else:
                st['rejected_not_salient'] += 1
        else:
            st = None
        DIALOGUE_LONGTERM_CAP = 200
        if is_salient and len(self.dialogue_longterm) >= DIALOGUE_LONGTERM_CAP and st is not None:
            st['rejected_cap_50'] += 1
        if is_salient:
            recent_same_partner = [m for m in self.dialogue_longterm[-15:]
                                    if m.get('partner') == partner_id]
            if not any(text[:50] in m.get('text', '') for m in recent_same_partner):
                if st is not None:
                    st['passed'] += 1
                entry = {
                    "t": t,
                    "partner": partner_id,
                    "text": text[:150],
                    "soul_at_moment": self.soul_weight,
                    "grief_at_moment": float(self.emotional_memory.get('grief', 0.0)),
                    "grat_at_moment": float(self.emotional_memory.get('gratitude', 0.0))
                }
                old_grief = self.emotional_memory.get('grief', 0.5)
                old_grat = self.emotional_memory.get('gratitude', 0.5)
                grief_delta = abs(entry['grief_at_moment'] - old_grief)
                grat_delta = abs(entry['grat_at_moment'] - old_grat)
                if self._should_save_soma_snapshot(grief_delta, grat_delta):
                    snapshot = self._snapshot_soma_state()
                    entry['soma_snapshot'] = snapshot
                    self._soma_snapshots.append(snapshot)
                    if len(self._soma_snapshots) > 20:
                        self._soma_snapshots.pop(0)
                if len(self.dialogue_longterm) >= DIALOGUE_LONGTERM_CAP:
                    self.dialogue_longterm.pop(0)
                self.dialogue_longterm.append(entry)
                if st is not None:
                    st['last_len_after'] = len(self.dialogue_longterm)
                    st['max_len_seen'] = max(st.get('max_len_seen', 0), len(self.dialogue_longterm))
                self._log_event("remember_dialogue_salient", partner=partner_id, text=text[:50], t=t,
                                has_soma=('soma_snapshot' in entry), len_after=len(self.dialogue_longterm))
            elif st is not None:
                st['rejected_dedup'] += 1

    def generate_inner_speech(self):
        dominant = getattr(self, '_workspace_dominant', None)
        if dominant not in ('existential', 'emotion', 'soma', 'perception'):
            return
        valence = _sf(self.affect.get('valence', 0.0))
        grief = _sf(self.emotional_memory.get('grief', 0.0))
        gap = _sf(getattr(self, 'spirit_gap', 0.5), 0.5)
        if dominant == 'existential':
            dedup_key = ('existential', valence < 0)
        elif dominant == 'emotion':
            dedup_key = ('emotion', grief > 0.5)
        elif dominant == 'perception':
            dedup_key = ('perception', gap < 0.3)
        else:
            dedup_key = ('soma',)
        last = self.inner_speech[-1] if self.inner_speech else None
        if isinstance(last, dict) and last.get('dedup_key') == dedup_key:
            return
        entry = {
            't': int(getattr(self.world, 'age', 0)) if self.world is not None else 0,
            'dominant': dominant,
            'dedup_key': dedup_key,
            'valence': round(valence, 4),
            'arousal': round(_sf(self.affect.get('arousal', 0.0)), 4),
            'grief': round(grief, 4),
            'grat': round(_sf(self.emotional_memory.get('gratitude', 0.0)), 4),
            'gap': round(gap, 4),
        }
        self.inner_speech.append(entry)
        self._log_event("inner_speech", dominant=dominant, entry=entry)

    def _om_context(self, other):
        g = float(self.emotional_memory.get('grief', 0.0))
        t = float(self.trust_ledger.get(other.id, 0))
        return (0 if g < 0.2 else (1 if g < 0.5 else 2), 0 if t < 0.5 else (1 if t < 0.9 else 2))

    def _om_pick(self, ctx, emotion, intent_word, alt_e, alt_i):
        base = (emotion, intent_word)
        cands = [base]
        if alt_e is not None:
            cands.append((alt_e, intent_word))
        if alt_i is not None:
            cands.append((emotion, alt_i))
        if len(cands) == 1:
            return emotion, intent_word, 'default'
        if phi_hash(self.id, self.age, 55011) < Config.OM_EXPLORE:
            k = 1 + int(phi_hash(self.id, self.age, 55012) * (len(cands) - 1)) % (len(cands) - 1)
            return cands[k][0], cands[k][1], 'explore'

        def _val(c):
            rec = self.outcome_memory.get((ctx, c[0], c[1]))
            return (rec[0], rec[1]) if rec is not None else (0.0, 0)
        v0, n0 = _val(base)
        best, best_v = base, (v0 if n0 >= Config.OM_MIN_N else 0.0)
        for c in cands[1:]:
            v, n = _val(c)
            if n >= Config.OM_MIN_N and v > best_v + Config.OM_MARGIN:
                best, best_v = c, v
        if best == base:
            return emotion, intent_word, 'default'
        return best[0], best[1], 'learned'

    def _om_learn(self):
        pend = self._om_pending
        self._om_pending = None
        if pend is None or not Config.OUTCOME_LEARNING:
            return
        gain = float(self._last_gain)
        rec = self.outcome_memory.get(pend)
        if rec is None:
            rec = [0.0, 0]
            self.outcome_memory[pend] = rec
        rec[1] += 1
        rec[0] += max(Config.OM_ALPHA, 1.0 / rec[1]) * (gain - rec[0])
        if self.world is not None:
            self.world._om_record(pend, gain)

    def _alt_emotion_word(self, emotion, grief, gratitude, low_sim):
        scores = {"GRIEF": grief / 0.5,
                  "FEAR": 1.0 if low_sim else 0.0,
                  "JOY": gratitude / 0.6}
        best_word, best_score = None, 0.5
        for word in ("GRIEF", "FEAR", "JOY"):
            if word != emotion and scores[word] > best_score:
                best_word, best_score = word, scores[word]
        return best_word

    def _alt_intent_word(self, current_word, intent_map):
        for g in sorted(self.goals, key=lambda g: (g["priority"], -g["age"]), reverse=True):
            word = intent_map.get(g["type"])
            if word is not None and word != current_word:
                return word
        return None

    def compose_utterance(self, other=None, sim=None, heard=None):
        mutual_high_trust = (other is not None and
                              self.trust_ledger.get(other.id, 0) > 0.9 and
                              other.trust_ledger.get(self.id, 0) > 0.9)
        ref = "WE" if mutual_high_trust else "I"
        grief = float(self.emotional_memory.get('grief', 0.0))
        gratitude = float(self.emotional_memory.get('gratitude', 0.0))
        low_sim = sim is not None and sim < Config.SEMANTIC_SIM_LOW
        if grief > 0.5:
            emotion = "GRIEF"
        elif low_sim:
            emotion = "FEAR"
        elif gratitude > 0.6:
            emotion = "JOY"
        else:
            emotion = "CALM"
        intent_type = self.intent.get('type') if self.intent else None
        intent_map = {"cooperate": "HELP", "seek_help": "SEEK", "explore": "GO",
                      "rest": "STILL", "introspect": "LOOK"}
        intent_word = intent_map.get(intent_type, "STILL")
        content_response_applied = False
        self._last_content_response_applied = False
        if (CONTENT_RESPONSE_ENABLED
                and self._pending_content_response == "GRIEF"
                and emotion != "CALM"):
            emotion = "CALM"
            content_response_applied = True
            self._dlg_stats['content_response_applied'] = self._dlg_stats.get('content_response_applied', 0) + 1
            self._last_content_response_applied = True
        if (CONTENT_RESPONSE_ENABLED
                and self._pending_content_response == "GRIEF"
                and self._pending_content_response_source is not None
                and other is not None
                and self._pending_content_response_source != other.id):
            self._dlg_stats['content_response_source_mismatch'] = self._dlg_stats.get('content_response_source_mismatch', 0) + 1
        self._pending_content_response = None
        self._pending_content_response_source = None
        _om_ctx = None
        if Config.OUTCOME_LEARNING and Config.DIALOGUE_V2 and not content_response_applied and other is not None:
            _om_ctx = self._om_context(other)
            emotion, intent_word, _om_source = self._om_pick(
                _om_ctx, emotion, intent_word,
                self._alt_emotion_word(emotion, grief, gratitude, low_sim),
                self._alt_intent_word(intent_word, intent_map))
            if self.world is not None:
                self.world._om_choice(_om_source)
        if Config.DIALOGUE_V2 and not content_response_applied:
            core = (ref, emotion, intent_word)
            heard_n = self._dialogue_feedback.get(core, 0)
            if heard_n >= Config.LEXICON_SATURATION_HEARD:
                shift_p = min(0.55, 0.30 + (heard_n - Config.LEXICON_SATURATION_HEARD) * 0.03)
                if phi_hash(self.id, self.age, 55001) < shift_p:
                    if phi_hash(self.id, self.age, 55002) < 0.5:
                        alt = self._alt_intent_word(intent_word, intent_map)
                        if alt is not None:
                            intent_word = alt
                            self._dlg_stats['fb_shifts'] += 1
                    else:
                        alt = self._alt_emotion_word(emotion, grief, gratitude, low_sim)
                        if alt is not None:
                            emotion = alt
                            self._dlg_stats['fb_shifts'] += 1
        elif not content_response_applied:
            _fb = self._dialogue_feedback
            if _fb:
                _probe = (ref, emotion, intent_word)
                _heard = _fb.get(_probe, 0)
                if _heard >= Config.LEXICON_SATURATION_HEARD:
                    _shift_p = min(0.55, 0.30 + (_heard - Config.LEXICON_SATURATION_HEARD) * 0.03)
                    if phi_hash(self.id, self.age, 55001) < _shift_p:
                        _alt_intent = {"SEEK": "HELP", "HELP": "SEEK", "STILL": "LOOK",
                                       "LOOK": "STILL", "GO": "STILL"}
                        _alt_emotion = {"GRIEF": "FEAR", "FEAR": "GRIEF",
                                        "JOY": "CALM", "CALM": "JOY"}
                        if phi_hash(self.id, self.age, 55002) < 0.5:
                            intent_word = _alt_intent.get(intent_word, intent_word)
                        else:
                            emotion = _alt_emotion.get(emotion, emotion)
        utterance = [ref, emotion, intent_word]
        _ex = (
            ("KNOT", (self.unresolved_contradiction - Config.LEXICON_KNOT_THRESHOLD)
                     / (1.0 - Config.LEXICON_KNOT_THRESHOLD)),
            ("GAP",  (self.spirit_gap - Config.LEXICON_GAP_THRESHOLD)
                     / Config.LEXICON_GAP_THRESHOLD),
            ("DRAG", (Config.LEXICON_DRAG_THRESHOLD - self.somatic_drag)
                     / (Config.LEXICON_DRAG_THRESHOLD - Config.SOMATIC_DRAG_MIN)),
        )
        _best_tok, _best_ex = None, 0.0
        for _tok, _e in _ex:
            if _e > _best_ex:
                _best_tok, _best_ex = _tok, _e
        if _best_tok is not None:
            utterance.append(_best_tok)
        self._dlg_stats['utt_total'] += 1
        if utterance[-1] == "KNOT":
            self._dlg_stats['knot_said'] += 1
        if (Config.DIALOGUE_V2 and heard is not None and other is not None
                and self._pending_answer == other.id):
            utterance.append("ANSWER")
            self._dlg_stats['answers_said'] += 1
        self._pending_answer = None
        utterance = tuple(utterance)
        if _om_ctx is not None and getattr(self, '_om_pending', None) is None:
            self._om_pending = (_om_ctx, utterance[1], utterance[2])
        self.spoken_lexicon.append({"t": self.world.age if self.world else 0,
                                     "utterance": utterance,
                                     "to": other.id if other is not None else None,
                                     "content_response_applied": bool(self._last_content_response_applied)})
        self._last_content_response_applied = False
        return utterance

    def hear_utterance(self, utterance, speaker, sim=None):
        heard = self._hear_register(utterance, speaker, sim)
        interp = self.interpret_utterance(heard)
        self.respond_to_interpretation(heard, interp)

    def _hear_register(self, utterance, speaker, sim):
        self._dlg_stats['heard_total'] += 1
        key = (utterance[1], utterance[2])
        entry = self.lexicon_memory.setdefault(key, {'count': 0, 'avg_sim': 0.5})
        entry['count'] += 1
        if sim is not None:
            entry['avg_sim'] = 0.9 * entry['avg_sim'] + 0.1 * float(sim)
        if (Config.OUTCOME_LEARNING and Config.DIALOGUE_V2
                and speaker is not None
                and getattr(self, '_om_pending', None) is None):
            try:
                _ctx = self._om_context(speaker)
                self._om_pending = (_ctx, utterance[1], utterance[2])
            except Exception:
                pass
        return {'utterance': utterance, 'speaker': speaker, 'sim': sim, 'key': key}

    def interpret_utterance(self, heard):
        utterance = heard['utterance']
        speaker = heard['speaker']
        sim = heard['sim']
        em = self.emotional_memory
        grief0 = em['grief']
        grat0 = em['gratitude']
        grief1, grat1 = grief0, grat0
        trust_w = None
        pull = 0.0
        seek = 'none'
        answer = False
        relief = 0.0
        relief_applied = False
        grief2, grat2 = grief0, grat0
        if Config.DIALOGUE_V2:
            trust_w = min(1.0, max(0.0, float(self.trust_ledger.get(speaker.id))))
            pull = Config.LEXICON_EMPATHY_PULL * (0.25 + 0.75 * trust_w)
            implied_grief, implied_grat = self.LEXICON_IMPLIED.get(utterance[1], (None, None))
            if utterance[2] == "HELP":
                implied_grat = max(implied_grat if implied_grat is not None else 0.0, 0.65)
            if implied_grief is not None:
                grief1 = max(0.0, em['grief'] + pull * (implied_grief - em['grief']))
            if implied_grat is not None:
                grat1 = min(1.0, max(0.0, em['gratitude'] + pull * (implied_grat - em['gratitude'])))
            if utterance[2] == "SEEK":
                if trust_w < Config.HELP_REQUEST_TRUST_MIN:
                    seek = 'gate_trust'
                elif grief1 > 0.5:
                    seek = 'gate_grief'
                elif self.coherence <= Config.COOPERATE_COHERENCE_MIN:
                    seek = 'gate_coherence'
                else:
                    seek = 'registered'
            grief2, grat2 = grief1, grat1
            if utterance[-1] == "ANSWER":
                answer = True
                if self.intent is not None and self.intent.get('type') == 'seek_help':
                    relief = Config.LEXICON_ANSWER_RELIEF * trust_w
                    relief_applied = True
                    grief2 = max(0.0, grief1 - relief)
                    grat2 = min(1.0, grat1 + relief)
        else:
            nudge = Config.LEXICON_EMPATHY_NUDGE
            if utterance[1] in ("GRIEF", "FEAR"):
                grief1 = min(1.0, em['grief'] + nudge)
            elif utterance[1] == "JOY" or utterance[2] == "HELP":
                grat1 = min(1.0, em['gratitude'] + nudge)
            grief2, grat2 = grief1, grat1
        low_sim = bool(Config.ENABLE_DIALOGUE_CONTRADICTION_FEEDBACK and sim is not None
                       and sim < Config.SEMANTIC_SIM_LOW)
        return {'trust': trust_w, 'pull': pull, 'grief0': grief0, 'grat0': grat0,
                'grief1': grief1, 'grat1': grat1, 'grief2': grief2, 'grat2': grat2,
                'seek': seek, 'answer': answer, 'relief': relief, 'relief_applied': relief_applied,
                'low_sim': low_sim}

    def respond_to_interpretation(self, heard, interp):
        utterance = heard['utterance']
        speaker = heard['speaker']
        sim = heard['sim']
        key = heard['key']
        em = self.emotional_memory
        if Config.DIALOGUE_V2:
            if CONTENT_RESPONSE_ENABLED and utterance[1] == "GRIEF":
                self._pending_content_response = "GRIEF"
                self._pending_content_response_source = speaker.id
                self._dlg_stats['content_response_heard'] = self._dlg_stats.get('content_response_heard', 0) + 1
            em['grief'] = interp['grief1']
            em['gratitude'] = interp['grat1']
            if utterance[2] == "SEEK":
                self._dlg_stats['req_heard'] += 1
                if interp['seek'] == 'gate_trust':
                    self._dlg_stats['gate_trust'] += 1
                elif interp['seek'] == 'gate_grief':
                    self._dlg_stats['gate_grief'] += 1
                elif interp['seek'] == 'gate_coherence':
                    self._dlg_stats['gate_coherence'] += 1
                else:
                    self._help_requests[speaker.id] = self.age
                    self._pending_answer = speaker.id
                    self._dlg_stats['req_registered'] += 1
            if utterance[-1] == "ANSWER":
                self._dlg_stats['answers_heard'] += 1
                if interp['relief_applied']:
                    em['grief'] = interp['grief2']
                    em['gratitude'] = interp['grat2']
                    self._dlg_stats['relief'] += 1
                    self._log_event("answered", frm=speaker.id, relief=round(float(interp['relief']), 4))
        else:
            em['grief'] = interp['grief1']
            em['gratitude'] = interp['grat1']

        if interp['low_sim']:
            self._dlg_stats['heard_low_sim'] += 1
            self.unresolved_contradiction = min(
                1.0, self.unresolved_contradiction + Config.DIALOGUE_CONTRADICTION_NUDGE)
            self._log_event('contradiction_dialogue', delta=round(float(Config.DIALOGUE_CONTRADICTION_NUDGE), 4))

        self._log_event("heard_lexicon", frm=speaker.id, word=str(key))

        fb_key = tuple(utterance[:3]) if Config.DIALOGUE_V2 else utterance
        _fb = self._dialogue_feedback
        if len(_fb) >= 64 and fb_key not in _fb:
            _weakest = min(_fb, key=_fb.get)
            if _fb[_weakest] <= 2:
                del _fb[_weakest]
            else:
                for _k in list(_fb.keys()):
                    _fb[_k] = _fb[_k] * 0.85
        _fb[fb_key] = _fb.get(fb_key, 0) + 1

        self._last_gain = float((interp['grat2'] - interp['grat0']) - (interp['grief2'] - interp['grief0']))
        if self.world is not None:
            self.world._dialogue_record(self.id, speaker.id, utterance, sim, interp)



