        out[k] = {"count": c, "rate_per_1000_at": round(1000 * c / max(at, 1), 3)}
    return out


def sec_J_temporal(log_raw, ledger_raw):
    snaps = log_raw.get("agent_snaps", []); speaks = log_raw.get("speaks", [])
    rows_led = ledger_raw.get("rows", []) if ledger_raw else []
    if not rows_led: return {"n/a": "нет ledger rows"}
    nw = rows_led[-1]["t"] // W + 1
    out = []
    for w in range(nw):
        sw = [s for s in speaks if w * W <= s.get("t", -1) < (w + 1) * W and s.get("utt")]
        sn = [s for s in snaps if w * W <= s.get("t", -1) < (w + 1) * W]
        emo = Counter(s["utt"][1] for s in sw if len(s["utt"]) > 1)
        lw = rows_led[w * W:(w + 1) * W]
        out.append({"w": w, "n_mean": sum(r.get("n", 0) for r in lw) / len(lw) if lw else None,
                    "speaks": len(sw), "GRIEF": emo.get("GRIEF", 0), "JOY": emo.get("JOY", 0), "CALM": emo.get("CALM", 0),
                    "p50_grief": _stat([s.get("grief") for s in sn]).get("p50"),
                    "p50_uc": _stat([s.get("uc") for s in sn]).get("p50"),
                    "p50_gap": _stat([s.get("gap") for s in sn]).get("p50"),
                    "p50_drag": _stat([s.get("drag") for s in sn]).get("p50"),
                    "p50_tension": _stat([s.get("tension") for s in sn]).get("p50")})
    return {"windows": out}


def sec_K_anomalies(log_raw, ledger_raw):
    an = []; snaps = log_raw.get("agent_snaps", []); events = log_raw.get("events", [])
    seen = set(); last_t_per_id = {}
    rows_log = log_raw.get("tick_rows", []); rows_led = ledger_raw.get("rows", []) if ledger_raw else []
    bounded_01 = ("uc", "grief", "grat", "gap", "drag", "soul", "scar")
    for s in snaps:
        key = (s.get("t"), s.get("id"))
        if key in seen: an.append(("dup_snap", s.get("t"), s.get("id")))
        seen.add(key); pid = s.get("id"); t = s.get("t")
        if pid in last_t_per_id and t < last_t_per_id[pid]: an.append(("time_backwards", t, pid))
        last_t_per_id[pid] = t
        for f in bounded_01:
            v = s.get(f)
            if v is None: continue
            if not isinstance(v, (int, float, np.integer, np.floating)): continue
            v = float(v)
            if not np.isfinite(v): an.append(("nan_or_inf", t, pid, f, v)); continue
            if not (-1e-6 <= v <= 1 + 1e-6): an.append(("out_of_range", t, pid, f, round(v, 4)))
        t_v = s.get("tension")
        if isinstance(t_v, (int, float)) and np.isfinite(float(t_v)) and float(t_v) < -1e-6:
            an.append(("out_of_range", t, pid, "tension", t_v))
    events_checked = min(len(events), 100_000)
    for e in events[:events_checked]:
        if e.get("type") == "trust_change" and e.get("deltas"):
            for pid, _p, new_v, _d in e["deltas"]:
                if isinstance(new_v, (int, float)) and (new_v < -1e-6 or new_v > 1 + 1e-6):
                    an.append(("trust_out_of_range", e.get("t"), e.get("pid"), pid, new_v))
    if rows_log and rows_led:
        common = min(len(rows_log), len(rows_led))
        for i in range(common):
            if rows_log[i].get("n") != rows_led[i].get("n"):
                an.append(("pop_mismatch", i, rows_log[i].get("n"), rows_led[i].get("n"))); break
    for k in ("events", "speaks", "dialogues"):
        if len(log_raw.get(k, [])) >= RECORD_CAP: an.append(("record_cap_reached", k, len(log_raw.get(k, []))))
    return {"count": len(an), "first_50": an[:50], "events_checked": events_checked, "events_total": len(events)}


def sec_L_energy(log_raw):
    out = {}
    header = log_raw.get("header", {}); tick_rows = log_raw.get("tick_rows", [])
    snap = header.get("energy_snapshot")
    if not snap:
        out["n/a"] = "no energy_snapshot (лог старше правок Cell 6b)"; return out
    out["final"] = {"t": snap.get("t"), "field": snap.get("field"), "agent_inventory": snap.get("agent_inventory"),
                    "total": snap.get("total"), "step_total": snap.get("step_total"),
                    "step_measured": snap.get("step_measured"), "ticks": snap.get("ticks")}
    src = snap.get("src", {}) or {}
    out["creators_top"] = sorted(((n, float(v[0])) for n, v in src.items()), key=lambda kv: -kv[1])[:12]
    out["sinks_top"] = sorted(((n, float(v[1])) for n, v in src.items() if float(v[1]) < 0), key=lambda kv: kv[1])[:12]
    out["creators_sum"] = sum(float(v[0]) for v in src.values())
    out["sinks_sum"] = sum(float(v[1]) for v in src.values())
    out["balance_x1"] = out["creators_sum"] + out["sinks_sum"]
    x2 = snap.get("x2", {}) or {}
    x2_items = sorted(((n, float(v[0]) + float(v[1])) for n, v in x2.items()), key=lambda kv: -abs(kv[1]))
    out["x2_items"] = x2_items[:15]; out["x2_sum"] = sum(v for _, v in x2_items)
    series = []
    for r in tick_rows:
        if "E_field" in r: series.append({"t": r["t"], "field": r.get("E_field"), "inv": r.get("E_inv"), "total": r.get("E_total")})
    out["series"] = series
    if len(series) >= 2:
        out["field_drift"] = series[-1]["field"] - series[0]["field"]
        if series[0]["inv"] is not None and series[-1]["inv"] is not None: out["inv_drift"] = series[-1]["inv"] - series[0]["inv"]
    return out


def _audit_path_for(log_path):
    base = os.path.basename(log_path)
    if base.startswith("rich_log_"): base = base[len("rich_log_"):]
    if base.endswith(".json"): base = base[:-5]
    return f"{DIR}/audit_{base}.json"


def sec_M_audit(audit_path):
    if not audit_path or not os.path.exists(audit_path):
        return {"n/a": f"нет файла аудита: {audit_path} (прогон без Config.AUDIT_DIR или старая версия движка)"}
    with open(audit_path, "r", encoding="utf-8") as f: A = json.load(f)
    S = A["summary"]; rows = A.get("rows", []); atk = A.get("attacks", []); dlg = A.get("dialogue", []); cfg = A.get("config", {})
    out = {"path": audit_path, "ticks": S.get("ticks"), "config": cfg}
    F = {"counters": S.get("feral", {})}
    if atk:
        hit = np.array([bool(a["hit"]) for a in atk]); raw = np.array([a["raw"] for a in atk]); kp = np.array([a["kill_prob"] for a in atk])
        n = int(hit.size); k = int(hit.sum()); lo, hi = _wilson(k, n)
        F.update({"n_rolled": n, "hits": k, "misses": n - k, "hit_rate": k / n, "miss_rate": 1 - k / n,
                  "miss_ci95": (1 - hi, 1 - lo), "kill_prob_mean": float(kp.mean()), "kill_prob_q": _q(kp), "raw_q": _q(raw),
                  "raw_ge_095_share": float((raw >= 0.95).mean()),
                  "factor_means": {key: float(np.mean([a[key] for a in atk])) for key in ("fury_factor", "size_factor", "vuln_factor", "crowd_factor", "weary", "lf", "prey_age")}})
        win = {}
        for a, h_ in zip(atk, hit):
            w = a["t"] // 100; e = win.setdefault(w, [0, 0, 0.0]); e[0] += 1; e[1] += int(h_); e[2] += a["kill_prob"]
        F["by_window"] = {int(w): {"n": v[0], "hit_rate": v[1] / v[0], "kp_mean": v[2] / v[0]} for w, v in sorted(win.items())}
        def _scale_for(ceil, target_hit):
            lo, hi = 1e-4, 50.0
            if ceil * float(np.mean(1.0 - np.exp(-raw / lo))) < target_hit: return None
            for _ in range(80):
                mid = (lo + hi) / 2
                if ceil * float(np.mean(1.0 - np.exp(-raw / mid))) > target_hit: lo = mid
                else: hi = mid
            return (lo + hi) / 2
        calib = []
        for target_miss in (0.10, 0.20, 0.30, 0.40):
            for ceil in (0.90, 0.95): calib.append({"target_miss": target_miss, "ceil": ceil, "scale_needed": _scale_for(ceil, 1.0 - target_miss)})
        F["calibration"] = calib
        first, killed = {}, {}
        for a in atk:
            first.setdefault(a["prey"], a["t"])
            if a["hit"]: killed.setdefault(a["prey"], a["t"])
        delays = [killed[p] - first[p] for p in killed]
        F["kill_delay"] = {"prey_attacked": len(first), "prey_killed": len(killed), "attacked_not_killed": len([p for p in first if p not in killed]),
                           "mean_ticks_first_attack_to_kill": float(np.mean(delays)) if delays else None,
                           "p50": float(np.median(delays)) if delays else None, "p90": float(np.quantile(delays, 0.9)) if delays else None,
                           "killed_on_first_attack_share": float(np.mean([d == 0 for d in delays])) if delays else None}
        wall_t = {r["t"]: r.get("wall_on") for r in rows}
        pw = {"ON": [0, 0], "OFF": [0, 0]}
        for a, h_ in zip(atk, hit):
            st = wall_t.get(a["t"])
            if st is None: continue
            key = "ON" if st else "OFF"; pw[key][0] += 1; pw[key][1] += int(h_)
        F["by_wall_phase"] = {k_: {"n": v[0], "hit_rate": (v[1] / v[0]) if v[0] else None} for k_, v in pw.items()}
    out["feral"] = F
    E = {}
    for key in ("x1", "x2"):
        blk = S.get(key, {}); R = blk.get("residual", {})
        E[key] = {"dE_total": blk.get("dE_total"), "logged_net": blk.get("logged_net"), "residual_sum": R.get("sum"),
                  "residual_abs": R.get("abs"), "residual_max_abs": R.get("max_abs"), "residual_max_t": R.get("max_t"),
                  "abs_flow_sum": blk.get("abs_flow_sum"), "gap": S.get("gap_between_ticks", {}).get(key),
                  "outside_window": S.get("outside_window", {}).get(key),
                  "top_flows": sorted(((n_, v["net"], v["pos"], v["neg"], v["n"]) for n_, v in blk.get("ledger", {}).items()), key=lambda kv: -abs(kv[1]))[:12]}
    E["memo"] = S.get("memo", {})
    ser = []
    for r in rows[::max(1, len(rows) // 16)]: ser.append({"t": r["t"], "E1": r["E1"], "E2": r["E2"], "pop": r["pop"], "feral": r["feral"]})
    E["series"] = ser; out["energy"] = E
    D = {"ledger": S.get("dialogue", {})}
    cols = S.get("dialogue_columns", [])
    if dlg and cols:
        ix = {c: i for i, c in enumerate(cols)}
        by_band = {}; by_cross = {}; by_seek = Counter()
        for rec in dlg:
            tr = rec[ix["trust"]]
            band = "n/a" if tr is None else ("trust<0.5" if tr < 0.5 else ("trust0.5-0.9" if tr < 0.9 else "trust>=0.9"))
            b = by_band.setdefault(band, [0, 0.0, 0.0]); b[0] += 1; b[1] += rec[ix["d_grief"]]; b[2] += abs(rec[ix["d_grief"]])
            cs = rec[ix["cross_side"]] if "cross_side" in ix else None
            key = f"cross={cs}|wall={rec[ix['wall']]}" if "wall" in ix else f"cross={cs}"
            c = by_cross.setdefault(key, [0, 0.0, 0.0]); c[0] += 1; c[1] += rec[ix["d_grief"]]; c[2] += rec[ix["d_grat"]]
            by_seek[rec[ix["seek"]]] += 1
        D["by_trust_band"] = {k_: {"n": v[0], "mean_d_grief": v[1] / v[0], "mean_abs_d_grief": v[2] / v[0]} for k_, v in by_band.items()}
        D["by_cross_wall"] = {k_: {"n": v[0], "mean_d_grief": v[1] / v[0], "mean_d_grat": v[2] / v[0]} for k_, v in by_cross.items()}
        D["seek_outcomes"] = dict(by_seek)
    out["dialogue"] = D
    out["modes"] = S.get("mode_snapshots", [])
    O = dict(S.get("outcome_learning", {}))
    win = {}
    for r in rows:
        if r.get("om_n"):
            e = win.setdefault(r["t"] // 100, [0, 0.0, 0, 0, 0]); e[0] += r["om_n"]; e[1] += r["om_gain_mean"] * r["om_n"]
            e[2] += r.get("om_learned", 0); e[3] += r.get("om_explore", 0); e[4] += r.get("om_default", 0)
    O["curve"] = {int(w): {"n": v[0], "mean_gain": v[1] / v[0], "learned_share": v[2] / max(1, v[2] + v[3] + v[4])} for w, v in sorted(win.items())}
    out["outcome"] = O
    W = {"cycle": S.get("wall_cycle"), "events": S.get("wall_events", [])}
    ph = {"ON": [], "OFF": []}
    for r in rows:
        if "wall_on" in r: ph["ON" if r["wall_on"] else "OFF"].append(r)
    W["by_phase"] = {}
    for k_, rr in ph.items():
        if rr:
            W["by_phase"][k_] = {"ticks": len(rr), "pop_mean": float(np.mean([r["pop"] for r in rr])),
                                 "feral_mean": float(np.mean([r["feral"] for r in rr])),
                                 "births_per_tick": float(np.mean([r["births"] for r in rr])),
                                 "removed_per_tick": float(np.mean([r["removed"] for r in rr]))}
    out["wall"] = W
    return out


def sec_N_signal(audit_path):
    """[N] СИГНАЛ v3.0: читает summary['signal'] из audit JSON (отдельного forms_*.json больше нет)."""
    if not audit_path or not os.path.exists(audit_path):
        return {"n/a": f"нет файла аудита: {audit_path}"}
    with open(audit_path, "r", encoding="utf-8") as f: A = json.load(f)
    S = (A.get("summary") or {}).get("signal")
    if not S:
        return {"n/a": "в аудите нет summary['signal'] (ячейка SIGNAL v3.0 не была выполнена до движка)"}
    rows = A.get("rows", [])
    tot = lambda k: sum((r.get(k) or 0) for r in rows)
    st = S.get("stats", {}); snap = S.get("snapshot", {})
    ok, part, dbt = tot("sig_rec_recognized"), tot("sig_rec_partial"), tot("sig_rec_doubt")
    none_, smiss = tot("sig_rec_none"), tot("sig_rec_stress_missed")
    heard = (ok + part + dbt + none_ + smiss) or 1
    el = S.get("emitter_windows", {}); lv = S.get("listener_verdicts", {}); sv = S.get("sender_verdicts", {})
    cs = tot("sig_choice_signal")
    scr = ((A.get("summary") or {}).get("patches") or {}).get("scream") or {}
    return {"version": S.get("version"), "emits": tot("sig_emits"), "cry_emits": tot("sig_cry_emit"),
            "scream_total": scr.get("total", 0), "scream_as_form": scr.get("cry_as_form", 0),
            "form_full_blocked": st.get("form_full_blocked", 0), "emit_no_energy": tot("sig_emit_no_energy"),
            "listens": tot("sig_listens"), "provenance_share": S.get("provenance_share"),
            "recognition_share": {"recognized": ok / heard, "partial": part / heard, "doubt": dbt / heard,
                                  "none": none_ / heard, "stress_missed": smiss / heard},
            "emitter_windows": el, "listener_verdicts": lv, "sender_verdicts": sv,
            "trust_up": tot("sig_trust_up"), "trust_down": tot("sig_trust_down"),
            "choice": {"signal": cs, "influenced": tot("sig_choice_influenced"), "blocked_by_barrier": tot("sig_choice_blocked"),
                       "reinforced": tot("sig_choice_reinforced")},
            "forms": snap, "goal_models": S.get("goal_models"), "in_flight": S.get("in_flight"),
            "errors": sum(v for k, v in st.items() if k.startswith("err_")), "last_err": S.get("last_err")}


def _print_N(log_path):
    print("\n" + "-" * 78)
    print("[N] СИГНАЛ v3.0: цикл сигнал → распознавание → исход → выбор")
    N = sec_N_signal(_audit_path_for(log_path))
    for k, v in N.items():
        if isinstance(v, float): v = round(v, 4)
        print(f"  {k}: {v}")
    return N


