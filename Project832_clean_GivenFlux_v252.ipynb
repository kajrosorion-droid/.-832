        grief_now = _sf(self.emotional_memory.get('grief', 0.0))
        gap_now = _sf(getattr(self, 'spirit_gap', 0.0))
        drag_now = _sf(getattr(self, 'somatic_drag', 1.0), 1.0)
        is_heavy_reflection = (grief_now > 0.5) or (gap_now > 0.7) or (drag_now < 0.6)
        if is_heavy_reflection:
            has_comfort_goal = any(g.get('type') in ['rest', 'cooperate'] for g in getattr(self, 'goals', []))
            if not has_comfort_goal:
                goal_type = "cooperate" if getattr(self, '_substate', '') == 'longing' else "rest"
                self.goals.append({
                    "type": goal_type,
                    "priority": 3.0,
                    "target": None,
                    "age": 0,
                    "persistence": 40,
                    "_source": "introspection_insight"
                })
                self._log_event("goal_shift_from_introspection", target=goal_type)
        if drag_now < 0.6:
            self._self_narrative.append({
                "t": int(self.age),
                "type": "somatic_state",
                "somatic_drag": round(drag_now, 4),
                "_source": "somatic_drag",
            })
        if (Config.ENABLE_SUFFERING_ANALYTICS and
                self.emotional_memory.get('grief', 0.0) > 0.5 and self._pain_context):
            worst = max(self._pain_context, key=lambda p: p['grief'])
            if worst.get('nearest_id') is not None:
                self._reflection_topics['suffering_with_cause'] += 1
                if self._reflection_topics['suffering_with_cause'] % 5 == 1:
                    self._log_event(
                        "suffering_hypothesis", target=worst['nearest_id'],
                        grief=worst['grief'], gap=worst['gap'],
                    )
                    _suspicion_strength = min(2.0, worst['grief'] * 2.0)
                    self.trust_ledger.update(worst['nearest_id'], 'harmful',
                                              multiplier=_suspicion_strength)
                    self._log_event('causal_inference_trust_penalty',
                                     target=worst['nearest_id'],
                                     strength=round(float(_suspicion_strength), 3))
        found_topics = []
        if grief_now > 0.5: found_topics.append('pain')
        if gap_now > 0.6: found_topics.append('gap')
        if _sf(getattr(self, 'soul_weight', 0.5), 0.5) < 0.3: found_topics.append('identity')
        if _sf(getattr(self, 'unresolved_contradiction', 0.0)) > 0.6: found_topics.append('meaning')
        if _sf(self.emotional_memory.get('gratitude', 0.0)) > 0.6: found_topics.append('connection')
        if _sf(getattr(self, 'cognitive_tension', 0.0)) > 0.5: found_topics.append('why')
        for topic in found_topics:
            self._reflection_topics[topic] += 1
        meta_question = None
        for topic, count in list(self._reflection_topics.items()):
            if count >= 2:
                meta_question = f"topic={topic} count={count}"
                self._reflection_topics[topic] = 0
                break
        if meta_question:
            self._meta_questions.append(meta_question)
            if self._self_narrative and isinstance(self._self_narrative[-1], dict):
                self._self_narrative[-1]['meta'] = meta_question
            self.epistemic_scar = min(1.0, self.epistemic_scar + Config.META_OBSERVATION_SCAR)
            if self._root_question is None:
                self._root_question = meta_question
                self._log_event("root_question_formed", question=meta_question[:60])
                if self.world is not None:
                    self.world.witness.record(self.id, "root_question_formed", question=meta_question[:60])
            if Config.UNCLOSABLE_QUESTION_FLOOR > self.unresolved_contradiction:
                self._log_event('contradiction_cognition_floor', delta=round(Config.UNCLOSABLE_QUESTION_FLOOR - self.unresolved_contradiction, 4))
            self.unresolved_contradiction = max(self.unresolved_contradiction, Config.UNCLOSABLE_QUESTION_FLOOR)
        soma = getattr(self, 'soma_vector', np.zeros(7))
        if len(soma) >= 5 and intro_entry is not None:
            intro_entry['body'] = {
                'move_cost': round(_sf(soma[4]), 4),
                'stress': round(_sf(soma[0]), 4),
            }
        current_topics = set(found_topics[:4])
        self._topic_history.append(current_topics)
        if len(self._topic_history) >= 5:
            early = set().union(*list(self._topic_history)[:3])
            recent = set().union(*list(self._topic_history)[-3:])
            overlap = len(early & recent) / max(1, len(early | recent))
            if overlap < 0.6:
                if self.world:
                    arc_text = f"old_topics={sorted(early)} new_topics={sorted(recent)} overlap={overlap:.3f}"
                    self.world.archive.deposit(self, "developmental_arc", weight=0.9, text=arc_text)
                    self._log_event("developmental_arc", old=early, new=recent)
                self._topic_history.clear()
        return result


