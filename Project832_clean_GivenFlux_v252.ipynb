            _lf_map = _conv((_own != 0).astype(np.float32) * _valid, _disk, mode="wrap") / np.maximum(_conv(_valid, _disk, mode="wrap"), 1e-9)

            for p in alive:
                g = getattr(p, "_lang_gene", None)
                _cells = list(p.cells)
