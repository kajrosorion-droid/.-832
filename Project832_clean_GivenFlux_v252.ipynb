_sg_ECHO_CH = tuple(CH[n] for n in _sg_CHAN_NAMES if n.startswith('signal_') and CH.get(n) is not None)


def _coop_refresh(eng):
    """Раз в тик: сколько кооператоров рядом с каждым кооператором (для группового сбора). O(число клеток)."""
    eng._coop_group = {}
    mode = Config.COOP_HARVEST_MODE
    if mode == 'off':
        return
    if mode != 'group':
        raise ValueError(f"COOP_HARVEST_MODE: ожидалось 'off' или 'group', получено {mode!r}")
    W = int(Config.WORLD_SIZE)
    R = float(Config.COOP_RADIUS)
    if R <= 0.0:
        raise ValueError(f"COOP_RADIUS: ожидалось > 0, получено {R!r}")
    pts = []
    for p in eng.patterns:
        it = getattr(p, 'intent', None)
        if not p.alive or not p.cells or not it or it.get('type') != 'cooperate':
            continue
        arr = np.array(list(p.cells), dtype=np.float64)
        d = ((arr - arr[0] + W / 2.0) % W) - W / 2.0          # центр масс на торе
        c = (arr[0] + d.mean(axis=0)) % W
        pts.append((p.id, float(c[0]), float(c[1])))
    if len(pts) < 2:
        return
    nb = max(1, int(math.ceil(W / R)))
    grid = {}
    for i, (_, x, y) in enumerate(pts):
        grid.setdefault((int(x // R) % nb, int(y // R) % nb), []).append(i)
    r2 = R * R
    for i, (pid, x, y) in enumerate(pts):
        gx, gy = int(x // R) % nb, int(y // R) % nb
        n = 0
        for key in {((gx + a) % nb, (gy + b) % nb) for a in (-1, 0, 1) for b in (-1, 0, 1)}:
            for j in grid.get(key, ()):
                if j == i:
                    continue
                dx = abs(pts[j][1] - x); dx = min(dx, W - dx)
                dy = abs(pts[j][2] - y); dy = min(dy, W - dy)
                if dx * dx + dy * dy <= r2:
                    n += 1
        if n > 0:
            eng._coop_group[pid] = n


def _sg_echo_mode():
    mode = Config.SIG_ECHO_MODE
    if mode not in ('off', 'structure'):
        raise ValueError(f"SIG_ECHO_MODE: ожидалось 'off' или 'structure', получено {mode!r}")
    return mode


def _sg_echo_base(book):
    if book.echo_base is None:
        seed = int(Config.SIG_ECHO_SEED)
        ranked = sorted(_sg_ECHO_CH, key=lambda ch: phi_hash(seed, int(ch), 91011))
        n = max(1, min(int(Config.SIG_ECHO_N_CH), len(ranked)))
        book.echo_base = {ch: 0.4 + 0.6 * float(phi_hash(seed, int(ch), 91021)) for ch in ranked[:n]}
    return book.echo_base


def _sg_echo_step(eng, book, t):
    """Один раз за тик: если эхо доступно — вписать форму в поле; иначе поле чистое (эха нет)."""
    book.echo_spec = None
    if _sg_echo_mode() == 'off' or not _sg_ECHO_CH:
        return
    seed = int(Config.SIG_ECHO_SEED)
    period = int(Config.SIG_ECHO_PERIOD)
    if period <= 0:
        raise ValueError(f"SIG_ECHO_PERIOD: ожидалось > 0, получено {period!r}")
    cycle, phase = divmod(int(t), period)
    if phase >= int(Config.SIG_ECHO_DURATION) or float(phi_hash(seed, cycle, 91001)) >= float(Config.SIG_ECHO_AVAIL_PROB):
        return
    W = int(Config.WORLD_SIZE)
    x0 = int(Config.SIG_ECHO_X) if Config.SIG_ECHO_X is not None else int(phi_hash(seed, 0, 91031) * W)
    y0 = int(Config.SIG_ECHO_Y) if Config.SIG_ECHO_Y is not None else int(phi_hash(seed, 1, 91032) * W)
    sigma = float(Config.SIG_ECHO_RADIUS)
    if sigma <= 0.0:
        raise ValueError(f"SIG_ECHO_RADIUS: ожидалось > 0, получено {sigma!r}")
    base = _sg_echo_base(book)
    mut_p = float(Config.SIG_ECHO_MUT_PERIOD)
    spec = {}
    for ch, a in base.items():
        ph = 2.0 * math.pi * float(phi_hash(seed, int(ch), 91041))
        drift = 1.0 + float(Config.SIG_ECHO_MUT_AMP) * math.sin(2.0 * math.pi * int(t) / mut_p + ph)
        spec[ch] = max(0.0, a * drift)
    spec = _sg_normalize(spec)
    if not spec:
        return
    ix = np.arange(W)
    ax = np.abs(ix - x0); ay = np.abs(ix - y0)
    dx = np.minimum(ax, W - ax).astype(np.float64)
    dy = np.minimum(ay, W - ay).astype(np.float64)
    g = np.exp(-(dx[:, None] ** 2 + dy[None, :] ** 2) / (2.0 * sigma ** 2))
    for ch, v in spec.items():
        field = eng.field
        field[:, :, ch] = np.minimum(1.0, field[:, :, ch] + float(v) * float(Config.SIG_ECHO_GAIN) * g)
    book.echo_spec = spec
    book.st['echo_active_ticks'] += 1
    if phase == 0:
        book.st['echo_cycles'] += 1


# ------------------------------------------------------------
# Состояние прогона (живёт в движке)
# ------------------------------------------------------------
class SignalBook:
    def __init__(self):
        self.st = Counter()                 # счётчики за весь прогон
        self.prev = Counter()               # для разностей по тикам и по 50 тикам
        self.tx = deque(maxlen=8192)        # form_tx: журнал эмиссий (t, x, y, pid, spectrum, form, ctx, action)
        self.pend = []                      # окна оценки последствий (emit / listen)
        self.base = {c: {} for c in SIG_COMPS}  # база исхода по контексту: ключ -> [среднее, n]
        self.absm = {c: [0.0, 0] for c in SIG_COMPS}
        self.alive_prev = {}                # для наблюдения гибели рядом
        self.amb = (None, {})               # фон по каналам (кэш на тик)
        self.rows = []
        self.err = None
        self.echo_base = None               # структура эха (канал → амплитуда), считается один раз по seed
        self.echo_spec = None               # что эхо пишет в поле в этом тике; None — эха сейчас нет


def _sg_book(world):
    b = getattr(world, '_sig', None)
    if b is None:
        b = SignalBook()
        world._sig = b
    return b


def _sg_err(book, tag, e):
    book.st['err_' + tag] += 1
    msg = f"{tag}: {e!r}"
    if book.err is None:
        import traceback
        print(f"[SIGNAL] ⚠️ {msg}\n{traceback.format_exc()}", flush=True)
    book.err = msg


# ------------------------------------------------------------
# Утилиты спектра
# ------------------------------------------------------------
def _sg_normalize(spec):
    d = {ch: float(v) for ch, v in spec.items() if ch in _sg_CH_SET and float(v) >= Config.SIG_MIN_INTENSITY}
    if not d:
        return None
    n = float(np.linalg.norm(list(d.values())))
    return {ch: v / n for ch, v in d.items()} if n > 1e-6 else None


def _sg_cos(a, b):
    keys = set(a) | set(b)
    if not keys:
        return 0.0
    va = np.array([a.get(k, 0.0) for k in keys]); vb = np.array([b.get(k, 0.0) for k in keys])
    na, nb = float(np.linalg.norm(va)), float(np.linalg.norm(vb))
    return float(va @ vb / (na * nb)) if na > 1e-9 and nb > 1e-9 else 0.0


def _sg_match(spec, obs):
    """(cos, |разница норм|) на общих каналах — как в SPECTRUM, чтобы пороги сохранили смысл."""
    common = set(spec) & set(obs)
    if not common:
        return 0.0, float('inf')
    a = np.array([spec[c] for c in common]); b = np.array([obs[c] for c in common])
    na, nb = float(np.linalg.norm(a)), float(np.linalg.norm(b))
    if na < 1e-6 or nb < 1e-6:
        return 0.0, float('inf')
    return float(a @ b / (na * nb)), float(abs(na - nb))


def _sg_disc(R):
    o = _sg_DISC.get(R)
    if o is None:
        d = np.arange(-R, R + 1)
        gx, gy = np.meshgrid(d, d, indexing='ij')
        m = (gx * gx + gy * gy) <= R * R
        o = (gx[m].astype(np.int64), gy[m].astype(np.int64))
        _sg_DISC[R] = o
    return o


def _sg_dist2(ax, ay, bx, by, W):
    dx = abs(ax - bx); dx = min(dx, W - dx)
    dy = abs(ay - by); dy = min(dy, W - dy)
    return dx * dx + dy * dy


def _sg_ambient(book, field, t):
    k = (id(field), int(t))
    if book.amb[0] != k:
        book.amb = (k, {ch: float(field[:, :, ch].mean()) for ch in SIGNAL_CHANNELS})
    return book.amb[1]


def _sg_heard(book, field, t, cx, cy):
    """Нормированный спектр, который слышен в точке (cx, cy) выше фона. None — тишина."""
    W = Config.WORLD_SIZE
    dx, dy = _sg_disc(Config.SIG_LISTEN_RADIUS)
    means = field[(cx + dx) % W, (cy + dy) % W][:, _sg_CH_IDX].mean(axis=0)
    thr = Config.SIG_THRESHOLD
    amb = _sg_ambient(book, field, t)
    out = {}
    for ch, v in zip(_sg_CH_IDX, means):
        v = float(v)
        if Config.SIG_ABOVE_AMBIENT and amb.get(ch, 0.0) >= thr:
            v -= amb[ch]
        if v >= thr:
            out[ch] = v
    return _sg_normalize(out) if out else None


def _sg_mood(p):
    return float(p.emotional_memory.get('gratitude', 0.0)) - float(p.emotional_memory.get('grief', 0.0))


def _sg_ctx(p):
    """Ситуация агента: (полоса горя | тип намерения). Строка — чтобы всё оставалось JSON-безопасным."""
    g = float(p.emotional_memory.get('grief', 0.0))
    it = p.intent.get('type') if isinstance(p.intent, dict) else None
    return f"{0 if g < 0.2 else (1 if g < 0.5 else 2)}|{it}"


def _sg_action(p):
    return str(p.intent.get('type', '*')) if isinstance(p.intent, dict) else '*'


def _sg_stress(p):
    mx = float(getattr(Config, 'MAX_METRIC', 1.0)) or 1.0
    return float(min(1.0, max(0.0, float(getattr(p, 'alarm_level', 0.0)),
                              float(getattr(p, 'cognitive_tension', 0.0)) / mx)))


def _sg_trust(p, other_id):
    return float(p.trust_ledger.get(other_id))      # по умолчанию TRUST_BASE, как у самого ledger


# ------------------------------------------------------------
# Опыт формы: ожидание (m, tr, en) по ключам "ctx|action"
# ------------------------------------------------------------
def _sg_exp_keys(ctx, action):
    return dict.fromkeys((f"{ctx}|{action}", f"*|{action}", f"{ctx}|*", "*|*"))


def _sg_exp_get(form, ctx, action):
    exp = (form or {}).get('exp') or {}
    for k in _sg_exp_keys(ctx, action):
        rec = exp.get(k)
        if rec is not None and rec['n'] >= Config.SIG_MIN_N:
            return rec
    return None


def _sg_exp_add(form, ctx, action, vec, w):
    exp = form.setdefault('exp', {})
    for k in _sg_exp_keys(ctx, action):
        rec = exp.setdefault(k, {'m': 0.0, 'tr': 0.0, 'en': 0.0, 'n': 0})
        rec['n'] += 1
        a = float(w) / (rec['n'] - 1 + float(w))
        for c in SIG_COMPS:
            rec[c] += a * (float(vec[c]) - rec[c])


def _sg_value(form, ctx):
    """Ценность формы для выбора формы к испусканию: уверенность × tanh(среднее ожидание)."""
    rec = _sg_exp_get(form, ctx, '*')
    if rec is None:
        return 0.0
    return rec['n'] / (rec['n'] + Config.SIG_CONF_K) * math.tanh((rec['m'] + rec['tr'] + rec['en']) / 3.0)


def _sg_adv(book, raw, key):
    """Исход минус база контекста, в единицах собственного разброса. None — база ещё прогревается."""
    adv, mature = {}, True
    for c in SIG_COMPS:
        b = book.base[c].setdefault(key, [0.0, 0])
        adv[c] = raw[c] - b[0]
        if b[1] < Config.SIG_WARMUP:
            mature = False
        b[1] += 1
        b[0] += max(0.02, 1.0 / b[1]) * (raw[c] - b[0])
        am = book.absm[c]
        am[1] += 1
        am[0] += max(0.01, 1.0 / am[1]) * (abs(adv[c]) - am[0])
    if not mature:
        return None
    return {c: float(np.clip(adv[c] / max(book.absm[c][0], Config.SIG_FLOORS[c]),
                             -Config.SIG_Z_CLIP, Config.SIG_Z_CLIP)) for c in SIG_COMPS}


def _sg_verdict(z):
    v = 0.5 * (z['m'] + z['en'])
    return -1 if v <= -Config.SIG_VERDICT_Z else (1 if v >= Config.SIG_VERDICT_Z else 0)


def _sg_new_ref():
    return {'n': 0, 'm': 0.0, 'tr': 0.0, 'en': 0.0, 's_m': 0.0, 's_tr': 0.0, 's_en': 0.0}


# ------------------------------------------------------------
# Агент
# ------------------------------------------------------------
class SignalMixin:
    def _sig_init(self):
        if not hasattr(self, 'signal_forms'):
            self.signal_forms = []
            self._sig_seq = 0
            self._sig_emit_until = -1
            self._sig_last_emit_t = -1000
            self._sig_emit_spec = None
            self._sig_recent = deque(maxlen=8)
            self._sig_open = 0
            self._goal_models = {}
            self._goal_ref = _sg_new_ref()
            self._goal_snap = None
            self._goal_tick = -1

    def __init__(self, pid, cells, parent=None, world=None):
        super().__init__(pid, cells, parent, world)
        self._sig_init()
        if parent is not None and getattr(parent, 'signal_forms', None):
            for f in parent.signal_forms[:Config.SIG_MAX_FORMS]:
                if phi_hash(self.id, _stable_hash(f['label']) & 0xFFFF, 99001) < Config.SIG_INHERIT_SKIP:
                    continue
                m = self._sig_mutate(f)
                if m is not None:
                    self._sig_add(m, 'mut')

    # ---------- формы ----------
    def _sig_new_form(self, spec, how):
        self._sig_seq += 1
        return {'spectrum': spec, 'uses': 0, 'born_t': int(self.age), 'exp': {}, 'vh': 0, 'vm': 0,
                'label': f'{how}_{self.id}_{self._sig_seq}', 'cpt': 0, 'dn': 0}

    def _sig_mutate(self, form):
        spec = dict(form['spectrum'])
        for ch in list(spec):
            seed = _stable_hash(str(ch)) & 0xFFFFFF
            if phi_hash(seed, 42, 88) < 0.3:
                v = spec[ch] + (phi_hash(seed, 1, 99) - 0.5) * 2 * Config.SIG_MUT_STD
                if v < Config.SIG_MIN_INTENSITY:
                    del spec[ch]
                else:
                    spec[ch] = min(1.5, v)
        spec = _sg_normalize(spec)
        return self._sig_new_form(spec, 'mut') if spec else None

    def _sig_add(self, form, how):
        """Единственное место, где форма попадает в список. Лимит строгий; вытесняет только то, что перестало работать."""
        st = _sg_book(self.world).st if self.world is not None else Counter()
        if len(self.signal_forms) >= Config.SIG_MAX_FORMS:
            worn = [f for f in self.signal_forms
                    if _sg_exp_get(f, '*', '*') is not None and _sg_exp_get(f, '*', '*')['n'] >= Config.SIG_DISP_MIN_N
                    and not f.get('cpt') and _sg_value(f, '*') <= Config.SIG_DISP_MAX_VALUE]
            if not worn:
                st['form_full_blocked'] += 1
                return False
            victim = min(worn, key=lambda f: _sg_value(f, '*'))
            self.signal_forms.remove(victim)
            st['form_displaced'] += 1
        self.signal_forms.append(form)
        st['form_new_' + how] += 1
        return True

    def _sig_proto(self):
        s = {}
        g = float(self.emotional_memory.get('grief', 0.0)); r = float(self.emotional_memory.get('gratitude', 0.0))
        al = float(getattr(self, 'alarm_level', 0.0)); tn = float(getattr(self, 'cognitive_tension', 0.0))
        it = self.intent.get('type') if isinstance(self.intent, dict) else None
        if g > 0.4: s[CH['signal_grief']] = min(1.0, g)
        if r > 0.4: s[CH['signal_gratitude']] = min(1.0, r)
        if al > 0.3: s[CH['signal_alarm']] = min(1.0, al)
        if tn < 0.05: s[CH['signal_silence']] = 0.5
        if it in ('cooperate', 'explore', 'rest', 'seek_help'):
            s[CH['intent_' + it]] = 0.7
        if not s:
            s[CH['signal_curiosity']] = 0.3
        return _sg_normalize(s)

    # ---------- инстинкт (v251) ----------
    def _sig_is_alarm(self, form):
        return float(form['spectrum'].get(CH['signal_alarm'], 0.0)) >= Config.SIG_ALARM_MIN_W

    def _sig_in_panic(self):
        return (float(getattr(self, 'alarm_level', 0.0)) > Config.SIG_INSTINCT_ALARM
                or float(getattr(self, 'energy', 1.0)) < Config.SIG_INSTINCT_ENERGY)

    def _sig_alarm_form(self, ctx):
        """Форма для инстинктивного крика: лучшая из имеющихся тревожных (по ценности), иначе новая чистая тревога."""
        alarms = [f for f in self.signal_forms if self._sig_is_alarm(f)]
        if alarms:
            return max(alarms, key=lambda f: (_sg_value(f, ctx), f['spectrum'].get(CH['signal_alarm'], 0.0)))
        f = self._sig_new_form({CH['signal_alarm']: 1.0}, 'panic')
        return f if self._sig_add(f, 'panic') else None

    def _sig_alarm_heard(self, tick):
        """Узнана ли чужая тревога за последние SIG_ADRENALINE_WINDOW тиков."""
        for (te, form, _s, _src, _ctx, state, _cat) in reversed(self._sig_recent):
            if tick - te > Config.SIG_ADRENALINE_WINDOW:
                break
            if state in ('recognized', 'partial') and self._sig_is_alarm(form):
                return True
        return False

    def _sig_pick(self, ctx):
        # Инстинкт: паника или голод — не выбор по вероятности, а рефлекс (форму выбираем, но крик обязателен).
        if Config.SIG_INSTINCT and self._sig_in_panic():
            f = self._sig_alarm_form(ctx)
            if f is not None:
                if self.world is not None:
                    _sg_book(self.world).st['instinct_alarm'] += 1
                return f
        if not self.signal_forms:
            spec = self._sig_proto()
            if spec is None:
                return None
            f = self._sig_new_form(spec, 'proto')
            return f if self._sig_add(f, 'proto') else None
        return max(self.signal_forms, key=lambda f: _sg_value(f, ctx))

    # ---------- испускание ----------
    def _sig_emit(self, field, form, t, ctx):
        """Испустить форму. Стоит энергии. True — сигнал реально ушёл в поле."""
        if form is None or not self.cells or not Config.SIG_ENABLE:
            return False
        now = int(t)
        if now - self._sig_last_emit_t < Config.SIG_EMIT_COOLDOWN:
            return False
        bk = _sg_book(self.world)
        cost = float(Config.SIG_EMIT_COST)
        if float(self.energy) < cost + Config.SIG_EMIT_RESERVE:
            bk.st['emit_no_energy'] += 1
            return False
        self._x2_change('X2.signal_emit', float(self.energy) - cost)
        bk.st['emit_energy_x1000'] += int(round(cost * 1000))
        self._sig_last_emit_t = now
        self._sig_emit_until = now + Config.SIG_EMIT_DURATION
        self._sig_emit_spec = dict(form['spectrum'])
        form['uses'] = int(form.get('uses', 0)) + 1
        cx, cy = self.get_center()
        W = Config.WORLD_SIZE
        bk.tx.append((now, int(cx) % W, int(cy) % W, self.id, dict(form['spectrum']), form, ctx, _sg_action(self)))
        bk.st['emits'] += 1
        return True

    def _sig_cry(self, field, t):
        """Инстинктивный крик как ФОРМА сигнала: тот же журнал bk.tx и то же окно исхода, что у контактной паники.
        Энергию здесь не списываем: оплату (action 'scream') берёт вызывающий слой. True — форма ушла в журнал."""
        if not Config.SIG_ENABLE or not self.cells or self.world is None:
            return False
        ctx = _sg_ctx(self)
        form = self._sig_alarm_form(ctx)
        if form is None:
            return False
        bk = _sg_book(self.world)
        now = int(t)
        W = Config.WORLD_SIZE
        self._sig_last_emit_t = now
        self._sig_emit_until = now + Config.SIG_EMIT_DURATION
        self._sig_emit_spec = dict(form['spectrum'])
        form['uses'] = int(form.get('uses', 0)) + 1
        cx, cy = self.get_center()
        bk.tx.append((now, int(cx) % W, int(cy) % W, self.id, dict(form['spectrum']), form, ctx, _sg_action(self)))
        bk.st['emits'] += 1
        bk.st['cry_emit'] += 1
        bk.pend.append({'kind': 'emit', 'owner': self.id, 'other': None, 't0': now, 'form': form, 'ctx': ctx,
                        'action': _sg_action(self), 'cat': 'cry', 'w': 1.0,
                        'own': {'m': _sg_mood(self), 'en': float(self.energy), 'tr': 0.0}})
        return True

    def _sig_apply_emission(self, field, t):
        if t >= self._sig_emit_until or self._sig_emit_spec is None or not self.cells:
            return
        for (x, y) in self.cells:
            for ch, v in self._sig_emit_spec.items():
                field[x, y, ch] = min(1.0, field[x, y, ch] + v * Config.SIG_EMIT_GAIN)

    def exchange_meanings(self, other, field, t):
        sim = super().exchange_meanings(other, field, t)
        if not Config.SIG_ENABLE or not Config.DIALOGUE_V2 or self.world is None:
            return sim
        try:
            ctx = _sg_ctx(self)
            form = self._sig_pick(ctx)
            if form is not None and self._sig_emit(field, form, t, ctx):
                _sg_book(self.world).pend.append({
                    'kind': 'emit', 'owner': self.id, 'other': other.id, 't0': int(t), 'form': form, 'ctx': ctx,
                    'action': _sg_action(self), 'cat': 'emit', 'w': 1.0,
                    'own': {'m': _sg_mood(self), 'en': float(self.energy), 'tr': _sg_trust(self, other.id)}})
        except Exception as e:
            _sg_err(_sg_book(self.world), 'emit', e)
        return sim

    # ---------- восприятие и распознавание ----------
    def _sig_provenance(self, book, cx, cy, t, obs):
        W = Config.WORLD_SIZE
        r2 = (Config.SIG_LISTEN_RADIUS + Config.SIG_TX_PAD) ** 2
        own, foreign, ent = False, {}, None
        for e in reversed(book.tx):
            if t - e[0] > Config.SIG_TX_WINDOW:
                break
            if e[0] > t or _sg_dist2(cx, cy, e[1], e[2], W) > r2 or _sg_cos(e[4], obs) < Config.SIG_TX_COS:
                continue
            if e[3] == self.id:
                own = True
            else:
                foreign.setdefault(e[3], e)
        if (own and foreign) or len(foreign) > 1:
            return 'mixed', None, None
        if foreign:
            pid, ent = next(iter(foreign.items()))
            return 'foreign', pid, ent
        return ('own' if own else 'unknown'), None, None

    def _sig_listen(self, field, t):
        if not self.cells or self.world is None or not Config.SIG_ENABLE:
            return
        bk = _sg_book(self.world); st = bk.st; now = int(t)
        W = Config.WORLD_SIZE
        cx, cy = self.get_center(); cx, cy = int(cx) % W, int(cy) % W
        obs = _sg_heard(bk, field, now, cx, cy)
        if obs is None:
            return
        st['listens'] += 1
        cat, src, ent = self._sig_provenance(bk, cx, cy, now, obs)
        st['prov_' + cat] += 1
        echo_tag = bool(cat == 'unknown' and bk.echo_spec is not None and _sg_cos(bk.echo_spec, obs) >= Config.SIG_TX_COS)
        if echo_tag:
            st['echo_heard'] += 1
        scored = sorted(((*_sg_match(f['spectrum'], obs), f) for f in self.signal_forms), key=lambda x: -x[0])
        state, form, strength = 'none', None, 0.0
        if scored:
            bcos, bnd, bf = scored[0]
            if bcos >= Config.SIG_MATCH_COS and bnd <= Config.SIG_MATCH_NORM:
                state, form, strength = 'recognized', bf, bcos
                if len(scored) > 1 and scored[1][0] >= Config.SIG_MATCH_COS and bcos - scored[1][0] <= Config.SIG_DOUBT_MARGIN:
                    state, strength = 'doubt', 0.5 * bcos
            elif bcos >= Config.SIG_PARTIAL_COS:
                state, form, strength = 'partial', bf, bcos
        if state != 'none' and phi_hash(self.id, now, 77001) < Config.SIG_STRESS_MISS * _sg_stress(self):
            st['rec_stress_missed'] += 1
            state, form = 'stress_missed', None
        st['rec_' + state] += 1
        st['rec_' + state + '_' + cat] += 1
        if echo_tag:
            st['echo_' + state] += 1
        if state == 'none':
            if phi_hash(self.id, self.age, 66001) < Config.SIG_NEW_PROB:
                if self._sig_add(self._sig_new_form(obs, 'heard'), 'heard'):
                    st['adopts'] += 1
            return
        if state in ('partial', 'doubt'):         # зазор: неопределённость давит на поиск, а не на ступор
            self.spirit_gap = float(min(Config.SIG_GAP_CAP, float(self.spirit_gap) + Config.SIG_GAP_BUMP))
            st['gap_bumps'] += 1
        if form is None:
            return
        if cat == 'own':
            st['match_own_emit'] += 1             # своё эхо: узнали, но ничему не учимся
            return
        if Config.SIG_ADRENALINE and state in ('recognized', 'partial') and self._sig_is_alarm(form):
            # шок: чужая тревога узнана — организм напрягается раньше, чем решит, что делать
            self.cognitive_tension = min(Config.MAX_METRIC, float(self.cognitive_tension) + Config.SIG_SHOCK)
            st['adrenaline_shock'] += 1
        ctx = _sg_ctx(self)
        self._sig_recent.append((now, form, strength, src, ctx, state, cat))
        if self._sig_open < Config.SIG_MAX_OPEN:
            self._sig_open += 1
            w = Config.SIG_LISTEN_W if cat == 'foreign' else Config.SIG_LISTEN_W_BLUR
            bk.pend.append({
                'kind': 'listen', 'owner': self.id, 'other': src, 't0': now, 'form': form, 'ctx': ctx,
                'action': _sg_action(self), 'cat': cat, 'w': w,
                'sender': (ent[5], ent[6], ent[7], ent[3]) if ent is not None else None,
                'own': {'m': _sg_mood(self), 'en': float(self.energy),
                        'tr': _sg_trust(self, src) if src is not None else 0.0}})
        else:
            st['listen_window_full'] += 1

    # ---------- ожидание от сигнала → оценка целей ----------
    def _sig_expect(self, t, goal):
        action = str(goal.get('type', '*'))
        acc = {c: 0.0 for c in SIG_COMPS}; total = 0.0
        for (te, form, strength, src, ctx, state, cat) in self._sig_recent:
            age = t - te
            if age < 0 or age > Config.SIG_RECENT_TICKS:
                continue
            rec = _sg_exp_get(form, ctx, action)
            if rec is None:
                continue
            conf = rec['n'] / (rec['n'] + Config.SIG_CONF_K)
            srcw = 1.0 if src is None else 0.5 + 0.5 * float(np.clip(_sg_trust(self, src), 0.0, 1.0))
            w = float(strength) * conf * srcw * Config.SIG_RECENT_DECAY ** age
            for c in SIG_COMPS:
                acc[c] += w * rec[c]
            total += w
        if total <= 1e-12:
            return None
        return ({c: float(np.clip(acc[c] / total, -Config.SIG_Z_CLIP, Config.SIG_Z_CLIP)) for c in SIG_COMPS},
                float(total / (total + Config.SIG_REL_K)))

    def _sig_danger(self, t):
        best = 0.0
        for e in self._sig_recent:
            age = t - e[0]
            if 0 <= age <= Config.SIG_RECENT_TICKS and e[1].get('dn', 0) > 0:
                best = max(best, min(1.0, e[1]['dn'] / 20.0) * Config.SIG_RECENT_DECAY ** age)
        return best

    def _goal_rel(self, goal):
        rec = self._goal_models.get(str(goal.get('type', '')))
        ref = self._goal_ref
        if rec is None or rec['n'] < Config.SIG_MIN_N or ref['n'] < 2 * max(2, Config.SIG_MIN_N):
            return None, 0.0
        zs = [float(np.clip((rec[c] - ref[c]) / max(ref['s_' + c], Config.SIG_GOAL_FLOORS[c]),
                            -Config.SIG_Z_CLIP, Config.SIG_Z_CLIP)) for c in SIG_COMPS]
        return float(np.mean(zs)), float(rec['n'] / (rec['n'] + Config.SIG_CONF_K))

    def _goal_learn(self, gtype, d):
        ref = self._goal_ref
        ref['n'] += 1
        a = max(Config.SIG_GOAL_LR, 1.0 / ref['n'])
        for c in SIG_COMPS:
            ref['s_' + c] += a * (abs(d[c] - ref[c]) - ref['s_' + c])
            ref[c] += a * (d[c] - ref[c])
        rec = self._goal_models.setdefault(gtype, {'n': 0, 'm': 0.0, 'tr': 0.0, 'en': 0.0})
        rec['n'] += 1
        b = max(Config.SIG_GOAL_LR, 1.0 / rec['n'])
        for c in SIG_COMPS:
            rec[c] += b * (d[c] - rec[c])

    def _goal_close(self, tick):
        snap, self._goal_snap = self._goal_snap, None
        if snap is None:
            return
        dt = int(tick) - snap['t']
        if dt <= 0 or dt > Config.SIG_GOAL_MAX_GAP:
            return
        trn = self.trust_ledger.entries
        common = [k for k in snap['tr'] if k in trn]
        dtr = (sum(trn[k] - snap['tr'][k] for k in common) / len(common)) if common else 0.0
        self._goal_learn(snap['type'], {'m': (_sg_mood(self) - snap['m']) / dt, 'tr': dtr / dt,
                                        'en': (float(self.energy) - snap['en']) / dt})
        _sg_book(self.world).st['goal_updates'] += 1

    def _goal_open(self, tick):
        if isinstance(self.intent, dict):
            self._goal_snap = {'t': int(tick), 'type': str(self.intent.get('type', '*')), 'm': _sg_mood(self),
                               'en': float(self.energy), 'tr': dict(self.trust_ledger.entries)}
        else:
            self._goal_snap = None

    def _goal_shift(self, goal, t):
        ex = self._sig_expect(t, goal)
        value = 0.0
        if ex is not None:
            vec, rel = ex
            value = rel * math.tanh((vec['m'] + vec['tr'] + vec['en']) / 3.0)
        zg, cg = self._goal_rel(goal)
        if zg is not None:
            tz = math.tanh(zg)
            value += Config.SIG_GOAL_PRIOR_W * cg * tz
            if tz < 0:
                value += Config.SIG_DEATH_W * self._sig_danger(t) * cg * tz   # гибель рядом бьёт по выученно невыгодным целям
        return float(np.clip(Config.SIG_CHOICE_GAIN * value, -Config.SIG_CHOICE_MAX, Config.SIG_CHOICE_MAX))

    def update_intent(self):
        """Слой 5. Сигнал и опыт сдвигают приоритеты целей (центрированно); барьер переключения остаётся в базе."""
        if self.world is None or not Config.SIG_ENABLE:
            return super().update_intent()
        tick = int(self.age)
        if self._goal_tick == tick:
            return super().update_intent()
        self._goal_tick = tick
        bk = _sg_book(self.world); st = bk.st
        if Config.SIG_ADRENALINE:
            # Адреналиновый шунт: тревога узнана недавно → барьер переключения снят, в цели — «помочь» с высоким приоритетом.
            # Это даёт инстинкту ПРАВО переключиться; платит за переключение по-прежнему слой p832 (intent_switch).
            if self._sig_alarm_heard(tick):
                self.last_intent_switch_age = min(self.last_intent_switch_age,
                                                  tick - int(Config.INTENT_SWITCH_COOLDOWN))
                if not any(g.get('_source') == 'adrenaline_alarm' for g in self.goals):
                    self.goals.append({"type": "cooperate", "priority": float(Config.SIG_ADRENALINE_PRIORITY),
                                       "target": None, "age": 0, "persistence": int(Config.SIG_ADRENALINE_PERSIST),
                                       "_source": "adrenaline_alarm"})
                    st['adrenaline_goal_injected'] += 1
                    self._log_event("adrenaline_goal_injected")
            elif (isinstance(self.intent, dict) and self.intent.get('_source') == 'adrenaline_alarm'
                  and not any(g is self.intent for g in self.goals)):
                # адреналин выгорел (цель истекла): иначе накачанная приверженность держала бы агента в «помочь» почти вечно
                self.intent = None
                st['adrenaline_release'] += 1
        try:
            self._goal_close(tick)
        except Exception as e:
            _sg_err(bk, 'goal_close', e)
        shifts, top0, top1 = {}, None, None
        if Config.SIG_CHOICE and self.goals:
            try:
                # Адреналиновая цель — «право переключиться», а не «переупорядочить похожие»: вне сдвига и вне среднего.
                regular = [g for g in self.goals if g.get('_source') != 'adrenaline_alarm']
                raw = {id(g): self._goal_shift(g, tick) for g in regular}
                if raw and any(v != 0.0 for v in raw.values()):
                    mean = sum(raw.values()) / len(raw)
                    lim = Config.SIG_CHOICE_MAX
                    shifts = {k: float(np.clip(v - mean, -lim, lim)) for k, v in raw.items() if abs(v - mean) > 1e-9}
                if shifts:
                    top0 = max(self.goals, key=lambda g: (g.get('priority', 0.0), -g.get('age', 0)))
                    top1 = max(self.goals, key=lambda g: (g.get('priority', 0.0) + shifts.get(id(g), 0.0), -g.get('age', 0)))
            except Exception as e:
                _sg_err(bk, 'choice', e)
                shifts = {}
        prev = self.intent
        for g in self.goals:
            if id(g) in shifts:
                g['priority'] += shifts[id(g)]
        try:
            result = super().update_intent()
        finally:
            for g in self.goals:
                if id(g) in shifts:
                    g['priority'] -= shifts[id(g)]
        if (self.intent is not prev and isinstance(self.intent, dict)
                and self.intent.get('_source') == 'adrenaline_alarm'):
            st['adrenaline_switch'] += 1
        if shifts:
            st['choice_signal'] += 1
            st['choice_bias_abs_x1000'] += int(1000 * sum(abs(v) for v in shifts.values()) / len(shifts))
            if self.intent is not prev:
                st['choice_influenced' if self.intent is not top0 else 'choice_noflip'] += 1
            elif prev is not None and top0 is not prev and top1 is prev:
                st['choice_blocked'] += 1       # сигнал пытался удержать цель, но барьер/приоритет решили иначе
            elif prev is not None and top1 is prev and top0 is prev and shifts.get(id(prev), 0.0) > 0:
                st['choice_reinforced'] += 1
            else:
                st['choice_noflip'] += 1
        try:
            self._goal_open(tick)
        except Exception as e:
            _sg_err(bk, 'goal_open', e)
        return result

    # ---------- сохранение мира ----------
    def dump_extra(self):
        extra = super().dump_extra() if hasattr(super(), 'dump_extra') else {}
        try:
            extra['sig_forms'] = [
                {'spectrum': {str(k): float(v) for k, v in f['spectrum'].items()}, 'uses': int(f.get('uses', 0)),
                 'label': str(f['label']), 'born_t': int(f.get('born_t', 0)), 'vh': int(f.get('vh', 0)),
                 'vm': int(f.get('vm', 0)), 'cpt': int(f.get('cpt', 0)), 'dn': int(f.get('dn', 0)),
                 'exp': [[k, {c: float(r[c]) for c in SIG_COMPS}, int(r['n'])] for k, r in (f.get('exp') or {}).items()]}
                for f in self.signal_forms[-Config.SIG_MAX_FORMS:]]
            extra['sig_seq'] = int(self._sig_seq)
            extra['sig_goal_models'] = {str(g): {**{c: float(v[c]) for c in SIG_COMPS}, 'n': int(v['n'])}
                                        for g, v in self._goal_models.items()}
            extra['sig_goal_ref'] = {k: (int(v) if k == 'n' else float(v)) for k, v in self._goal_ref.items()}
            extra['_lang_gene'] = [float(x) for x in getattr(self, '_lang_gene', [])]
        except Exception as e:
            raise RuntimeError(f"SIGNAL: не удалось сериализовать агента {getattr(self, 'id', '?')}") from e
        return extra

    def load_extra(self, data):
        if hasattr(super(), 'load_extra'):
            super().load_extra(data)
        try:
            self._sig_init()
            self.signal_forms = []
            raw = data.get('sig_forms')
            legacy = raw is None
            for f in (raw if raw is not None else data.get('signal_forms', [])):
                if not isinstance(f, dict):
                    continue
                spec = {}
                for k, v in (f.get('spectrum') or {}).items():
                    try:
                        spec[int(k)] = float(v)
                    except (TypeError, ValueError):
                        pass
                if not spec:
                    continue
                nf = {'spectrum': spec, 'uses': int(f.get('uses', 0)), 'born_t': int(f.get('born_t', 0)),
                      'label': str(f.get('label', '')) or f'legacy_{self.id}', 'exp': {}, 'vh': int(f.get('vh', 0)),
                      'vm': int(f.get('vm', 0)), 'cpt': int(f.get('cpt', 0)), 'dn': int(f.get('dn', 0))}
                for item in (f.get('exp') or []):
                    try:
                        k, vals, n = item
                        nf['exp'][str(k)] = {**{c: float(vals.get(c, 0.0)) for c in SIG_COMPS}, 'n': int(n)}
                    except (TypeError, ValueError):
                        pass
                self.signal_forms.append(nf)
            if legacy:   # опыт форм из SIGNAL→CHOICE v1.2: ключи [ctx, action, source] → "ctx|action", только personal
                fs = data.get('sc_form_state_v12') or []
                if len(fs) == len(self.signal_forms):
                    for nf, ser in zip(self.signal_forms, fs):
                        for item in ((ser or {}).get('exp') or []):
                            try:
                                k, vals, n = item
                                if len(k) == 3 and k[2] == 'personal':
                                    nf['exp'][f"{k[0]}|{k[1]}"] = {**{c: float(vals.get(c, 0.0)) for c in SIG_COMPS}, 'n': int(n)}
                            except (TypeError, ValueError):
                                pass
            self._sig_seq = int(data.get('sig_seq', len(self.signal_forms)))
            gm = data.get('sig_goal_models') or data.get('sc_goal_models') or {}
            self._goal_models = {str(g): {**{c: float(v.get(c, 0.0)) for c in SIG_COMPS}, 'n': int(v.get('n', 0))}
                                 for g, v in gm.items()}
            ref = _sg_new_ref()
            for k, v in (data.get('sig_goal_ref') or data.get('sc_goal_ref') or {}).items():
                if k in ref:
                    ref[k] = int(v) if k == 'n' else float(v)
            self._goal_ref = ref
            self._goal_snap = None
            g = data.get('_lang_gene')
            if g:
                try:
                    self._lang_gene = np.array([float(x) for x in g], dtype=np.float32)
                except (TypeError, ValueError):
                    pass
        except Exception as e:
            print(f"SIGNAL: ошибка загрузки форм: {e!r}")


# ------------------------------------------------------------
# Движок: поле, окна последствий, свидетель, аудит
# ------------------------------------------------------------
def _sg_credit(book, owner, form, ctx, action, z, w, kind):
    """Кредит форме: вектор исхода в её опыт, вердикт в счётчики, концепт после SIG_CONCEPT_MIN подтверждений."""
    if form is None or z is None:
        return 0
    _sg_exp_add(form, ctx, action, z, w)
    v = _sg_verdict(z)
    book.st['credit_' + kind] += 1
    book.st[f'verdict_{kind}_' + ('helped' if v > 0 else ('harmed' if v < 0 else 'none'))] += 1
    if v != 0:
        form['vh' if v > 0 else 'vm'] += 1
        if not form.get('cpt') and max(form['vh'], form['vm']) >= Config.SIG_CONCEPT_MIN:
            form['cpt'] = 1 if form['vh'] >= form['vm'] else -1
            book.st['concepts_' + ('help' if form['cpt'] > 0 else 'harm')] += 1
            try:
                owner._log_event('signal_concept', label=str(form['label']), sign=int(form['cpt']))
            except Exception:
                pass
    return v


def _sg_settle(eng, book, pend, by_id):
    owner = by_id.get(pend['owner'])
    if owner is None:
        book.st['win_owner_gone'] += 1
        return
    st = book.st
    if pend['kind'] == 'listen':
        owner._sig_open = max(0, owner._sig_open - 1)
    other = by_id.get(pend['other']) if pend['other'] is not None else None
    s0 = pend['own']
    d = {'m': _sg_mood(owner) - s0['m'], 'en': float(owner.energy) - s0['en'],
         'tr': (_sg_trust(owner, pend['other']) - s0['tr']) if pend['other'] is not None else 0.0}
    if pend['kind'] == 'emit':
        key = ('C|' if pend.get('cat') == 'cry' else 'E|') + pend['ctx']   # крик — отдельная статистика исходов
    else:
        key = 'L|' + pend['ctx']
    z = _sg_adv(book, d, key)
    if z is None:
        st['win_warmup_' + pend['kind']] += 1
        return
    if pend['kind'] == 'emit':
        v = _sg_credit(book, owner, pend['form'], pend['ctx'], pend['action'], z, 1.0, 'emitter')
        st['cons_' + ('helped' if v > 0 else ('harmed' if v < 0 else 'none'))] += 1
        return
    v = _sg_credit(book, owner, pend['form'], pend['ctx'], pend['action'], z, pend['w'], 'listener')
    snd = pend.get('sender')
    if snd is not None and pend['cat'] == 'foreign':            # кредит отправителю — только если он однозначен и жив
        sform, sctx, sact, spid = snd
        sender = by_id.get(spid)
        if sender is not None and sform in sender.signal_forms:
            _sg_credit(book, sender, sform, sctx, sact, z, Config.SIG_SENDER_W, 'sender')
        if v != 0:                                             # доверие — только по реальному исходу
            owner.trust_ledger.update(spid, 'helpful' if v > 0 else 'harmful',
                                      multiplier=Config.SIG_TRUST_UP if v > 0 else Config.SIG_TRUST_DOWN)
            st['trust_' + ('up' if v > 0 else 'down')] += 1
    else:
        st['no_sender_credit'] += 1


def _sg_witness(eng, book, t):
    W = Config.WORLD_SIZE
    now = {}
    for p in eng.patterns:
        if p.alive and p.cells:
            cx, cy = p.get_center()
            now[p.id] = (int(cx) % W, int(cy) % W, getattr(p, 'role_type', None))
    deaths = [(pid, v) for pid, v in book.alive_prev.items() if pid not in now]
    book.alive_prev = now
    if not deaths:
        return
    by_id = {p.id: p for p in eng.patterns if p.alive}
    r2 = Config.SIG_WIT_RADIUS ** 2
    for pid, (x, y, role) in deaths:
        book.st['deaths_seen'] += 1
        if role == 'feral':
            continue
        for qid, qv in now.items():
            if qv[2] == 'feral' or _sg_dist2(qv[0], qv[1], x, y, W) > r2:
                continue
            q = by_id.get(qid)
            if q is None:
                continue
            for e in reversed(q._sig_recent):
                if t - e[0] > Config.SIG_WIT_WINDOW:
                    break
                e[1]['dn'] = e[1].get('dn', 0) + 1           # форма, звучавшая перед гибелью рядом, получает свидетельство
                book.st['wit_credits'] += 1
                break


_sg_KEYS = ('emits', 'cry_emit', 'emit_no_energy', 'listens', 'adopts', 'prov_foreign', 'prov_mixed', 'prov_own', 'prov_unknown',
         'rec_recognized', 'rec_partial', 'rec_doubt', 'rec_none', 'rec_stress_missed', 'gap_bumps',
         'credit_emitter', 'credit_listener', 'credit_sender', 'trust_up', 'trust_down',
         'cons_helped', 'cons_harmed', 'cons_none',
         'choice_signal', 'choice_influenced', 'choice_noflip', 'choice_blocked', 'choice_reinforced',
         'goal_updates', 'form_displaced', 'form_full_blocked', 'concepts_help', 'concepts_harm',
         'deaths_seen', 'wit_credits')


class SignalEngineMixin:
    def _post_semantic_step(self, t):
        super()._post_semantic_step(t)
        try:
            _coop_refresh(self)
        except Exception as e:
            _sg_err(_sg_book(self), 'coop', e)
        if not Config.SIG_ENABLE:
            return
        bk = _sg_book(self)
        now = int(self.age)
        try:
            _sg_echo_step(self, bk, now)
            for p in self.patterns:
                if p.alive:
                    p._sig_init()
                    p._sig_apply_emission(self.field, now)
            if now % Config.SIG_LISTEN_EVERY == 0:
                for p in self.patterns:
                    if p.alive:
                        try:
                            p._sig_listen(self.field, now)
                        except Exception as e:
                            _sg_err(bk, 'listen', e)
            if bk.pend:
                by_id = {p.id: p for p in self.patterns if p.alive}
                keep = []
                for pend in bk.pend:
                    if now - pend['t0'] < Config.SIG_DELAY:
                        keep.append(pend)
                        continue
                    try:
                        _sg_settle(self, bk, pend, by_id)
                    except Exception as e:
                        _sg_err(bk, 'settle', e)
                bk.pend = keep
            _sg_witness(self, bk, now)
        except Exception as e:
            _sg_err(bk, 'tick', e)

    def _audit_close_tick(self, t, de_x1, res_x1, x2_step0):
        super()._audit_close_tick(t, de_x1, res_x1, x2_step0)
        try:
            bk = _sg_book(self)
            row = {}
            for k in _sg_KEYS:
                row['sig_' + k] = bk.st[k] - bk.prev.get('t_' + k, 0)
                bk.prev['t_' + k] = bk.st[k]
            row['sig_in_flight'] = len(bk.pend)
            self._audit_rows[-1].update(row)
            now = int(self.age)
            if now % 50 == 0 and now > 0:
                print(_sg_line(self, bk, now), flush=True)
        except Exception as e:
            _sg_err(_sg_book(self), 'audit', e)

    def audit_summary(self):
        S = super().audit_summary()
        try:
            S['signal'] = _sg_summary(self, _sg_book(self))
        except Exception as e:
            _sg_err(_sg_book(self), 'summary', e)
        return S


def _sg_snapshot(eng):
    alive = [p for p in eng.patterns if p.alive]
    forms = [f for p in alive for f in getattr(p, 'signal_forms', ())]
    with_exp = [f for f in forms if _sg_exp_get(f, '*', '*') is not None]
    return {'agents': len(alive), 'forms': len(forms), 'forms_avg': round(len(forms) / max(1, len(alive)), 2),
            'forms_max': max((len(getattr(p, 'signal_forms', ())) for p in alive), default=0),
            'forms_with_exp': len(with_exp),
            'concepts_help': sum(1 for f in forms if f.get('cpt', 0) > 0),
            'concepts_harm': sum(1 for f in forms if f.get('cpt', 0) < 0),
            'goal_model_agents': sum(1 for p in alive if getattr(p, '_goal_models', None))}


def _sg_line(eng, bk, now):
    d = lambda k: bk.st[k] - bk.prev.get('l_' + k, 0)
    cs = d('choice_signal')
    s = _sg_snapshot(eng)
    out = (f"[SIGNAL t={now}] emit={d('emits')}(cry={d('cry_emit')},no_en={d('emit_no_energy')}) listen={d('listens')} | "
           f"rec: ok={d('rec_recognized')} part={d('rec_partial')} dbt={d('rec_doubt')} none={d('rec_none')} "
           f"smiss={d('rec_stress_missed')} | src: f={d('prov_foreign')} m={d('prov_mixed')} o={d('prov_own')} "
           f"u={d('prov_unknown')} | credit: em={d('credit_emitter')} ls={d('credit_listener')} sd={d('credit_sender')} "
           f"trust+{d('trust_up')}/-{d('trust_down')} | choice: sig={cs} infl={d('choice_influenced')} "
           f"blk={d('choice_blocked')} rnf={d('choice_reinforced')} "
           f"|b|={(d('choice_bias_abs_x1000') / 1000.0 / max(1, cs)):.3f} | "
           f"adr: inst={d('instinct_alarm')} shock={d('adrenaline_shock')} inj={d('adrenaline_goal_injected')} "
           f"sw={d('adrenaline_switch')} rel={d('adrenaline_release')} | "
           f"forms: avg={s['forms_avg']} max={s['forms_max']} exp={s['forms_with_exp']}/{s['forms']} "
           f"cpt={s['concepts_help']}+/{s['concepts_harm']}- disp={d('form_displaced')} full={d('form_full_blocked')} | "
           f"in_flight={len(bk.pend)} err={sum(d(k) for k in bk.st if k.startswith('err_'))}")
    if bk.err:
        out += f" last_err={bk.err}"
    for k in list(bk.st):
        bk.prev['l_' + k] = bk.st[k]
    return out


def _sg_summary(eng, bk):
    st = bk.st
    snap = _sg_snapshot(eng)
    ln = sum(st['prov_' + c] for c in ('foreign', 'mixed', 'own', 'unknown')) or 1
    cons = st['cons_helped'] + st['cons_harmed'] + st['cons_none']
    gm = {}
    for p in eng.patterns:
        if not p.alive:
            continue
        ref = getattr(p, '_goal_ref', None)
        for g, m in (getattr(p, '_goal_models', {}) or {}).items():
            rel = {c: m[c] - ref[c] for c in SIG_COMPS} if ref and ref['n'] > 0 else {c: 0.0 for c in SIG_COMPS}
            gm.setdefault(g, []).append((m, rel))
    gm_out = {g: {'agents': len(v), 'mean_n': round(float(np.mean([x[0]['n'] for x in v])), 2),
                  **{'rel_' + c: round(float(np.mean([x[1][c] for x in v])), 5) for c in SIG_COMPS}} for g, v in gm.items()}
    return {'version': 'signal-3.0',
            'config': {k: getattr(Config, k) for k in _SIG_CFG if k not in ('SIG_FLOORS', 'SIG_GOAL_FLOORS')},
            'stats': {k: int(v) for k, v in st.items()},
            'snapshot': snap,
            'provenance_share': {c: round(st['prov_' + c] / ln, 4) for c in ('foreign', 'mixed', 'own', 'unknown')},
            'emitter_windows': {'settled': cons, 'helped': st['cons_helped'], 'harmed': st['cons_harmed'], 'none': st['cons_none']},
            'listener_verdicts': {k: int(st['verdict_listener_' + k]) for k in ('helped', 'harmed', 'none')},
            'sender_verdicts': {k: int(st['verdict_sender_' + k]) for k in ('helped', 'harmed', 'none')},
            'goal_models': gm_out,
            'baseline_cells': {c: len(bk.base[c]) for c in SIG_COMPS},
            'coop': {'mode': Config.COOP_HARVEST_MODE, 'agents_in_group': len(getattr(eng, '_coop_group', {})),
                     'extra_energy_from_group': float(getattr(eng, '_coop_extra', 0.0))},
            'echo': {'mode': Config.SIG_ECHO_MODE, 'active_ticks': int(st['echo_active_ticks']), 'cycles': int(st['echo_cycles']),
                     'heard': int(st['echo_heard']),
                     'outcomes': {k: int(st['echo_' + k]) for k in ('recognized', 'partial', 'doubt', 'none', 'stress_missed')}},
            'in_flight': len(bk.pend), 'last_err': bk.err}


Pattern = extend_class(Pattern, SignalMixin)
EvolutionEngine = extend_class(EvolutionEngine, SignalEngineMixin)

print("✅ SIGNAL v3.0: единый механизм (испускание за энергию → распознавание свой/чужой/неизвестный → исход через "
      f"{Config.SIG_DELAY} тиков → кредиты → доверие по исходу → сдвиг приоритетов целей). Единый крик: _sig_cry. Подмен и патчей нет.")
print(f"   лимит форм={Config.SIG_MAX_FORMS} цена испускания={Config.SIG_EMIT_COST} CHOICE_GAIN={Config.SIG_CHOICE_GAIN} "
      f"RECENT={Config.SIG_RECENT_TICKS} WARMUP={Config.SIG_WARMUP} | каналов в алфавите: {len(SIGNAL_CHANNELS)}")
