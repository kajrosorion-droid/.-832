def prey_weariness(prey):
    age_w = min(1.0, prey.age / (2.0 * Config.FERAL_PREY_MIN_AGE))
    gap_w = min(1.0, max(0.0, prey.spirit_gap))
    tired_w = min(1.0, max(0.0, 1.0 - prey._cellular_endurance))
    return 0.6 * age_w + 0.15 * gap_w + 0.25 * tired_w


def is_feral_prey(prey):
    ref = prey.world.prey_age_ref if prey.world is not None else float(Config.FERAL_PREY_MIN_AGE)
    return prey.age > ref and prey_weariness(prey) >= Config.FERAL_PREY_TIRED_SCORE


def find_largest_prey_in_radius(feral, field, world, min_cells=5, radius=20):
    cx, cy = feral.get_center()
    cx = int(cx)
    cy = int(cy)
    max_dist = radius * 1.4142
    candidates = []
    seen_owners = set()
    _bo = getattr(feral, '_feral_backoff', None)
    _now = world.age if world is not None else getattr(feral, 'age', 0)
    for dx in range(-radius, radius + 1):
        for dy in range(-radius, radius + 1):
            x = int((cx + dx) % Config.WORLD_SIZE)
            y = int((cy + dy) % Config.WORLD_SIZE)
            owner = int(field[x, y, CH['owner']])
            if owner != 0 and owner != feral.id and owner not in seen_owners:
                seen_owners.add(owner)
                if _bo is not None and _bo.get(owner, -1) > _now:
                    continue
                prey = world.pattern_dict.get(owner)
                if prey and prey.alive and len(prey.cells) >= min_cells and is_feral_prey(prey):
                    px, py = prey.get_center()
                    dx_vec = px - cx
                    dy_vec = py - cy
                    dist = np.hypot(dx_vec, dy_vec)
                    if dist > 0:
                        score = prey_weariness(prey) - 0.4 * dist / max_dist
                        candidates.append((score, prey, dx_vec / dist, dy_vec / dist, dist))
    if candidates:
        candidates.sort(key=lambda c: c[0], reverse=True)
        _, best_prey, dx_norm, dy_norm, dist = candidates[0]
        return best_prey, (dx_norm, dy_norm), dist
    return None, None, None


