# ============================================================
# Cell 4.3: ХРОНИЧЕСКИЕ ТРИГГЕРЫ ДЛЯ ПРЕВРАЩЕНИЯ В ДЕЗОРГАНИЗАТОРА
# Обновление счётчиков и превращение при превышении порога 500 шагов
# С поддержкой step_scale, потерей клеток, увеличением epistemic_scar
# И ограничением на число превращений (не более 2 раз)
# ============================================================

def update_chronic_counters(p, step_scale=1):
    """Обновляет счётчики хронических состояний агента (вызывается каждый шаг).
    step_scale: масштабирует приращения/затухания (для ускоренной симуляции)."""
    # Автоматическая инициализация, если счётчиков ещё нет
    init_chronic_counters_for_agent(p)

    # 1. Низкая душа (soul_weight) — ПРАВКА: порог 0.48, затухание ослаблено
    if p.soul_weight < 0.48:
        p._low_soul_steps += 1 * step_scale
    else:
        decay = 2 if p.soul_weight > 0.55 else 1
        p._low_soul_steps = max(0, p._low_soul_steps - decay * step_scale)

    # 2. Высокий разрыв духа (spirit_gap) — ПРАВКА: порог 0.68, затухание = 1
    if p.spirit_gap > 0.68:
        p._high_gap_steps += 1 * step_scale
    else:
        decay = 1
        p._high_gap_steps = max(0, p._high_gap_steps - decay * step_scale)

    # 3. Низкий разрыв духа (spirit_gap < 0.3 – слишком ясный)
    if p.spirit_gap < 0.3:
        p._low_gap_steps += 1 * step_scale
    else:
        decay = 2 if p.spirit_gap > 0.5 else 1
        p._low_gap_steps = max(0, p._low_gap_steps - decay * step_scale)

    # 4. Застревание в одном семантическом состоянии
    if hasattr(p, 'semantic_state_age') and p.semantic_state_age > 500:
        p._stuck_state_steps += 1 * step_scale
    else:
        p._stuck_state_steps = max(0, p._stuck_state_steps - 2 * step_scale)

    # 5. Социальная изоляция (нет новых контактов)
    last_contact = max(p.last_contact_step.values()) if p.last_contact_step else -1
    if p.age - last_contact > 500:
        p._loneliness_steps += 1 * step_scale
    else:
        p._loneliness_steps = max(0, p._loneliness_steps - 2 * step_scale)

    # 6. Комбо: высокая когерентность + низкая душа
    if p.coherence > 0.9 and p.soul_weight < 0.25:
        p._high_coherence_low_soul_steps += 1 * step_scale
    else:
        decay = 3 if (p.coherence < 0.7 or p.soul_weight > 0.35) else 1
        p._high_coherence_low_soul_steps = max(0, p._high_coherence_low_soul_steps - decay * step_scale)


def check_chronic_disorganizer(engine, p, t):
    """Проверяет хронические счётчики и при превышении порога превращает в дезорганизатора с потерей клеток.
    Агент может превратиться не более 2 раз за всю жизнь."""
    # На всякий случай инициализируем, если счётчиков нет
    init_chronic_counters_for_agent(p)

    # Защита от повторного падения сразу после искупления
    if getattr(p, '_redemption_cooldown', 0) > p.age:
        return False

    # ФИКС (схлопывание линий, раунд 2): значение 60 было настроено под
    # короткие прогоны (~300 шагов). На длинных прогонах (2000+ шагов) это
    # слишком агрессивно: агенты с нестандартными (уникальными) моделями
    # чаще держат high_gap/low_soul дольше среднего просто из-за того, что
    # их модель хуже предсказывает усреднённое по популяции поле — и они
    # быстро становятся дезорганизаторами, а затем гибнут в compete() (там
    # для дезорганизаторов не действует бонус доверия). Именно так удаляются
    # самые непохожие линии первыми. Подняли до 100 — компромисс между
    # старым 120 (для коротких прогонов) и текущим 60.
    chronic_limit = 100

    triggers = [
        ('_low_soul_steps', p._low_soul_steps > chronic_limit, 'chronic_low_soul'),
        ('_high_gap_steps', p._high_gap_steps > chronic_limit, 'chronic_high_gap'),
        ('_low_gap_steps', p._low_gap_steps > chronic_limit, 'chronic_low_gap'),
        ('_stuck_state_steps', p._stuck_state_steps > chronic_limit, 'chronic_stuck_state'),
        ('_loneliness_steps', p._loneliness_steps > chronic_limit, 'chronic_loneliness'),
        ('_high_coherence_low_soul_steps', p._high_coherence_low_soul_steps > chronic_limit, 'chronic_high_coherence_low_soul'),
    ]

    if not hasattr(Config, 'ENABLE_PROBABILISTIC_FOLD'):
        Config.ENABLE_PROBABILISTIC_FOLD = True

    for attr, condition, reason in triggers:
        # Не превращаем, если агент уже был дезорганизатором 2 или более раз
        if p._times_disorganizer >= 2:
            continue

        if condition:
            # ДОБАВЛЕНО (рекомендация советника: "судьба -- случайность с весом,
            # не гарантия"; ближайший реальный аналог "if fold_count>=3" в этом
            # коде -- именно этот хронический порог, а не отдельный счётчик
            # фолдов). Вместо гарантированного превращения -- вероятность:
            # выше при накопленном шраме, ниже при высоком доверии/благодарности
            # (буфер против отчаяния). phi_hash -- не secrets/random, чтобы не
            # ломать воспроизводимость прогонов (её и так чинили весь проект).
            if Config.ENABLE_PROBABILISTIC_FOLD:
                excess = (getattr(p, attr) - chronic_limit) / max(chronic_limit, 1)
                base_p = min(0.9, 0.05 + excess * 0.1)
                scar_factor = 1.0 + float(getattr(p, 'epistemic_scar', 0.0))
                _trust_vals = list(p.trust_ledger.entries.values()) if hasattr(p, 'trust_ledger') else []
                avg_trust = float(np.mean(_trust_vals)) if _trust_vals else 0.5
                grat = float(p.emotional_memory.get('gratitude', 0.5))
                buffer = max(0.1, 1.0 - 0.5 * avg_trust - 0.3 * grat)
                p_fall = min(0.95, max(0.0, base_p * scar_factor * buffer))
                if phi_hash(p.id, t, 44444) >= p_fall:
                    continue  # "чудо" -- порог перейден, но в этот раз пронесло
            # === ПРЕВРАЩЕНИЕ В ДЕЗОРГАНИЗАТОРА (с потерей клеток) ===
            # ПРАВКА №1: сбрасываем кулдаун искупления, чтобы арка могла запуститься заново
            p._redemption_cooldown = 0   # <--- ДОБАВЛЕНО

            p.role_type = "disorganizer"
            p._times_disorganizer += 1   # Увеличиваем счётчик превращений
            p.emotional_memory['gratitude'] = 0.1
            p.emotional_memory['grief'] = 0.8
            p.semantic_state = "exploring_danger"
            p.intent = {"type": "explore", "priority": 2.0, "age": 0, "persistence": 9999}
            p.intent_commitment = 2.0
            p.disorganizer_age_at_birth = p.age
            p.redemption_timer = Config.REDEMPTION_ARC_STEP_DELAY
            p._deterministic_redemption_triggered = False
            p._forced_soul_collapse_done = False
            p._redemption_arc_step = 0
            p._steps_since_trigger = 0
            p.soul_weight = min(p.soul_weight, 0.3)

            # Увеличиваем epistemic_scar на 0.3 (вместо 0.1)
            p.epistemic_scar = min(1.0, getattr(p, 'epistemic_scar', 0.0) + 0.3)

            # Потеря клеток: только если размер > 100, теряем половину (детерминированно, без рандома)
            if hasattr(p, 'cells') and len(p.cells) > 100:
                cells_list = sorted(list(p.cells))   # детерминированный порядок
                loss_count = len(cells_list) // 2
                if loss_count < 1:
                    loss_count = 1
                to_remove = cells_list[:loss_count]
                for (x, y) in to_remove:
                    p.cells.discard((x, y))
                    if p.world and p.world.field is not None:
                        p.world.field[x, y, CH['owner']] = 0
                p._log_event("disorganizer_cell_loss", lost=loss_count, remaining=len(p.cells))
            else:
                p._log_event("disorganizer_no_cell_loss", reason="size<=100", size=len(p.cells) if hasattr(p, 'cells') else 0)

            # Сброс всех хронических счётчиков (кроме _times_disorganizer)
            p._low_soul_steps = 0
            p._high_gap_steps = 0
            p._low_gap_steps = 0
            p._stuck_state_steps = 0
            p._loneliness_steps = 0
            p._high_coherence_low_soul_steps = 0

            p._log_event(f"disorganizer_by_{reason}", steps=getattr(p, attr, 0))
            engine.witness.record(p.id, f"disorganizer_by_{reason}", steps=getattr(p, attr, 0))
            return True
    return False


def init_chronic_counters_for_agent(p):
    """Инициализирует счётчики у агента, если их нет."""
    if not hasattr(p, '_low_soul_steps'):
        p._low_soul_steps = 0
    if not hasattr(p, '_high_gap_steps'):
        p._high_gap_steps = 0
    if not hasattr(p, '_low_gap_steps'):
        p._low_gap_steps = 0
    if not hasattr(p, '_stuck_state_steps'):
        p._stuck_state_steps = 0
    if not hasattr(p, '_loneliness_steps'):
        p._loneliness_steps = 0
    if not hasattr(p, '_high_coherence_low_soul_steps'):
        p._high_coherence_low_soul_steps = 0
    # Счётчик числа превращений в дезорганизатора
    if not hasattr(p, '_times_disorganizer'):
        p._times_disorganizer = 0


def init_all_chronic_counters(engine):
    """Инициализирует счётчики у всех живых агентов."""
    for p in engine.patterns:
        if p.alive:
            init_chronic_counters_for_agent(p)

print("✅ Cell 4.3 загружена: хронические триггеры с обновлёнными порогами, ослабленным затуханием, chronic_limit=100, сбросом redemption_cooldown при превращении, защитой от повторного падения, потерей клеток, ограничением на 2 превращения")
