                  else "❌ ПРОВЕРКА НЕ ПРОЙДЕНА: результаты ledger нельзя использовать как доказательство"))
    return ok


def periodicity_test(series, n_surr=500, seed=12345, min_cycles=3):
    from scipy.signal import lfilter
    x = np.asarray(series, dtype=float)
    x = x[np.isfinite(x)]
    N = len(x)
    if N < 40:
        return {"ok": False, "reason": "ряд короче 40 точек"}
    tt = np.arange(N)

    def detrend(y):
        return y - np.polyval(np.polyfit(tt[:len(y)], y, 1), tt[:len(y)])

    x = detrend(x)
    if x.std() == 0:
        return {"ok": False, "reason": "ряд константный"}
    freqs = np.fft.rfftfreq(N)
    band = freqs >= (min_cycles / N)
    band[0] = False

    def peak(y):
        y = y - y.mean()
        P = np.abs(np.fft.rfft(y)) ** 2
        k = np.argmax(np.where(band, P, -1.0))
        return P[k] / P[1:].sum(), 1.0 / freqs[k]

    obs_share, obs_period = peak(x)
    phi = float(np.clip(np.dot(x[:-1], x[1:]) / np.dot(x, x), -0.99, 0.99))
    sd_e = x.std() * np.sqrt(1 - phi ** 2)
    rng = np.random.default_rng(seed)
    ge = 0
    for _ in range(n_surr):
        eps = rng.normal(0.0, sd_e, N + 200)
        s = detrend(lfilter([1.0], [1.0, -phi], eps)[200:])
        if peak(s)[0] >= obs_share:
            ge += 1
    return {"ok": True, "n": N, "period": float(obs_period), "peak_share": float(obs_share),
            "phi": phi, "p_red_noise": (1 + ge) / (n_surr + 1), "n_surr": n_surr}


def cluster_test(X, k_max=6, n_null=100, seed=12345):
    from sklearn.cluster import KMeans
    from sklearn.metrics import silhouette_score
    X = np.asarray(X, dtype=float)
    if X.ndim != 2 or X.shape[0] < 20:
        return {"ok": False, "reason": "нужно >= 20 строк"}
    sd = X.std(axis=0)
    keep = sd > 0
    if keep.sum() < 2:
        return {"ok": False, "reason": "меньше двух непостоянных признаков"}
    Z = (X[:, keep] - X[:, keep].mean(axis=0)) / sd[keep]

    def best(M):
        res = (-1.0, None)
        for k in range(2, min(k_max, len(M) - 1) + 1):
            lab = KMeans(n_clusters=k, n_init=10, random_state=seed).fit_predict(M)
            if len(set(lab)) < 2:
                continue
            s = silhouette_score(M, lab)
            if s > res[0]:
                res = (float(s), k)
        return res

    obs_s, obs_k = best(Z)
    rng = np.random.default_rng(seed)
    ge = 0
    for _ in range(n_null):
        M = np.column_stack([rng.permutation(Z[:, j]) for j in range(Z.shape[1])])
        if best(M)[0] >= obs_s:
            ge += 1
    return {"ok": True, "n_rows": int(Z.shape[0]), "features": int(Z.shape[1]),
            "best_k": obs_k, "silhouette": obs_s, "p_permutation_null": (1 + ge) / (n_null + 1),
            "n_null": n_null}


