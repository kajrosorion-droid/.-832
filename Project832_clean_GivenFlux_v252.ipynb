# Cell 3f: Substates Engine v1.8 (ужесточённые пороги и налог на поток)
import numpy as np

class SubstatesEngine:
    # ОЧИЩЕНО (аудит): было 11 индексных констант в current_social, 6 из них
    # (_I_GRIEF, _I_COOPERATE, _I_EXPLORE, _I_SEEK_HELP, _I_SCAR, _I_BTYPE)
    # нигде не читались через _soc() -- только объявлялись. Оставлены только
    # реально используемые индексы.
    _I_CRISIS    = 0
    _I_INVITE    = 1
    _I_REST      = 7
    _I_RESONANCE = 8
    _I_ALARM     = 10

    # Обновлённые пороги (flow 0.68, serenity 0.45)
    _THRESHOLDS = {
        'awe':         0.65,
        'flow':        0.68,   # было 0.55 → теперь 0.68
        'wonder':      0.30,
        'serenity':    0.45,   # было 0.38 → теперь 0.45
        'curious':     0.32,
        'vigilance':   0.32,
        'longing':     0.28,
        'melancholy':  0.25,
        'reminiscence':0.25,
    }

    # Базовый порядок (ротируется для каждого агента)
    _BASE_PRIORITY = [
        'awe', 'wonder', 'serenity', 'curious',
        'vigilance', 'longing', 'melancholy', 'reminiscence', 'flow',
    ]

    _MIN_DURATION = 8

    @staticmethod
    def _phi_hash(seed, step, modulus=99911):
        """Простая хеш-функция для детерминированного сдвига."""
        return hash((seed, step)) % modulus

    @staticmethod
    def _soc(agent, idx):
        cs = getattr(agent, 'current_social', None)
        if cs is not None and len(cs) > idx:
            return float(np.clip(cs[idx], 0.0, 1.0))
        return 0.0

    @staticmethod
    def _scores(agent):
        grief      = float(np.clip(agent.emotional_memory.get('grief',     0.0), 0, 1))
        gratitude  = float(np.clip(agent.emotional_memory.get('gratitude', 0.0), 0, 1))
        soul       = float(np.clip(getattr(agent, 'soul_weight',              0.5), 0, 1))
        coherence  = float(np.clip(getattr(agent, 'coherence',                0.5), 0, 1))
        pred_err   = float(np.clip(getattr(agent, 'pred_error',               0.5), 0, 1))
        gap        = float(np.clip(getattr(agent, 'spirit_gap',               0.5), 0, 2)) / 2.0
        binding    = float(np.clip(getattr(agent, 'last_phenomenal_binding',  0.3), 0, 1))
        epi_load   = float(np.clip(getattr(agent, 'epistemic_load',           0.3), 0, 1))
        crisis_m   = float(np.clip(getattr(agent, 'crisis_memory',            0.0), 0, 1))
        age        = max(1, getattr(agent, 'age', 1))
        state      = getattr(agent, 'semantic_state', 'neutral')

        alarm   = SubstatesEngine._soc(agent, SubstatesEngine._I_ALARM)
        crisis  = SubstatesEngine._soc(agent, SubstatesEngine._I_CRISIS)
        invite  = SubstatesEngine._soc(agent, SubstatesEngine._I_INVITE)
        rest    = SubstatesEngine._soc(agent, SubstatesEngine._I_REST)
        resonance = SubstatesEngine._soc(agent, SubstatesEngine._I_RESONANCE)

        buf_fill = min(1.0, len(getattr(agent, 'episodic_buffer', [])) / 100.0)

        bio = list(getattr(agent, 'biography', []))[-50:]
        intent_sw = sum(1 for ev in bio if isinstance(ev, dict) and ev.get('type') == 'intent_switch')
        silence = float(np.clip((1.0 - intent_sw / 10.0) * coherence, 0, 1))

        maturity = min(1.0, age / 5000.0)

        awe = (binding         * 0.35 +
               gap             * 0.25 +
               (1.0 - pred_err)* 0.25 +
               (1.0 - crisis_m)* 0.15)

        flow = (coherence        * 0.35 +
                soul             * 0.30 +
                (1.0 - pred_err) * 0.25 +
                (1.0 - alarm)    * 0.10)

        wonder = (binding        * 0.35 +
                  (1.0 - grief)  * 0.25 +
                  coherence      * 0.25 +
                  invite         * 0.15)

        state_bonus = (0.40 if state == 'contentment' else
                       0.20 if state == 'grateful_but_cautious' else 0.0)
        serenity = float(np.clip(
            state_bonus      +
            silence          * 0.30 +
            (1.0 - pred_err) * 0.20 +
            resonance        * 0.10,
            0, 1))

        err_bell = float(np.clip(4.0 * pred_err * (1.0 - pred_err), 0, 1))
        curious = (epi_load         * 0.40 +
                   err_bell         * 0.30 +
                   (1.0 - crisis_m) * 0.20 +
                   gap              * 0.10)

        vigilance = (alarm           * 0.40 +
                     crisis          * 0.30 +
                     pred_err        * 0.20 +
                     (1.0 - soul)    * 0.10)

        longing = (grief             * 0.35 +
                   (1.0 - gratitude) * 0.25 +
                   buf_fill          * 0.25 +
                   maturity          * 0.15)

        grief_bell = float(np.clip(4.0 * grief * (1.0 - grief), 0, 1))
        melancholy = (grief_bell      * 0.40 +
                      buf_fill        * 0.30 +
                      (1.0 - gratitude)* 0.20 +
                      silence         * 0.10)

        reminiscence = (buf_fill  * 0.35 +
                        silence   * 0.30 +
                        maturity  * 0.25 +
                        rest      * 0.10)

        return {
            'awe':         float(np.clip(awe,         0, 1)),
            'flow':        float(np.clip(flow,        0, 1)),
            'wonder':      float(np.clip(wonder,      0, 1)),
            'serenity':    float(np.clip(serenity,    0, 1)),
            'curious':     float(np.clip(curious,     0, 1)),
            'vigilance':   float(np.clip(vigilance,   0, 1)),
            'longing':     float(np.clip(longing,     0, 1)),
            'melancholy':  float(np.clip(melancholy,  0, 1)),
            'reminiscence':float(np.clip(reminiscence,0, 1)),
        }

    @staticmethod
    def update(agent):
        scores     = SubstatesEngine._scores(agent)
        thresholds = SubstatesEngine._THRESHOLDS
        base_priority = SubstatesEngine._BASE_PRIORITY

        # Индивидуальная ротация приоритетов для каждого агента
        agent_id = getattr(agent, 'id', id(agent))
        rotation_seed = (agent_id, agent.age // 300 if hasattr(agent, 'age') else 0)
        rotation = SubstatesEngine._phi_hash(rotation_seed, 0, len(base_priority))
        priority = base_priority[rotation:] + base_priority[:rotation]

        if not hasattr(agent, '_substate'):
            agent._substate          = None
        if not hasattr(agent, '_substate_timer'):
            agent._substate_timer    = 0
        if not hasattr(agent, '_substate_cooldown'):
            agent._substate_cooldown = 0
        if not hasattr(agent, '_substate_score'):
            agent._substate_score    = 0.0

        if agent._substate_cooldown > 0:
            agent._substate_cooldown -= 1
            agent._state_modifiers = {}
            return

        new_sub   = None
        new_score = 0.0
        for s in priority:
            sc = scores.get(s, 0.0)
            if sc >= thresholds[s]:
                new_sub   = s
                new_score = sc
                break

        if new_sub != agent._substate:
            if agent._substate is not None:
                cur_score = scores.get(agent._substate, 0.0)
                still_valid = cur_score >= thresholds.get(agent._substate, 0.3) * 0.75
                not_much_better = (new_score < cur_score + 0.12)
                timer_alive = (agent._substate_timer > 0)

                if still_valid and not_much_better and timer_alive:
                    agent._substate_timer = max(0, agent._substate_timer - 1)
                    SubstatesEngine._apply_modifiers(agent)
                    return

            if agent._substate is not None:
                try:
                    agent._log_event("substate_exit",
                                     substate=agent._substate,
                                     score=round(scores.get(agent._substate, 0.0), 3))
                except Exception:
                    pass

            prev = agent._substate
            agent._substate       = new_sub
            agent._substate_score = new_score
            agent._substate_timer = SubstatesEngine._MIN_DURATION

            if new_sub is not None:
                try:
                    agent._log_event("substate_enter",
                                     substate=new_sub,
                                     prev=str(prev),
                                     score=round(new_score, 3))
                except Exception:
                    pass

            if new_sub is None:
                agent._substate_cooldown = 4

        else:
            agent._substate_score = new_score
            if agent._substate_timer > 0:
                agent._substate_timer -= 1

        SubstatesEngine._apply_modifiers(agent)

    @staticmethod
    def _apply_modifiers(agent):
        mods = {
            'mobility':             1.0,
            'soul_recovery':        0.0,
            'scar_heal':            0.0,
            'memory_recall_chance': 0.15,
            'metabolic_discount':   1.0,
            'intent_bias':          None,
        }

        sub = getattr(agent, '_substate', None)

        if sub == 'awe':
            mods.update({'mobility': 0.70, 'soul_recovery': 0.010, 'scar_heal': 0.012})
        elif sub == 'flow':
            # flow: mobility оставлен 1.20, metabolic_discount теперь 1.15 (налог на выгорание)
            mods.update({'mobility': 1.20, 'metabolic_discount': 1.15})
        elif sub == 'wonder':
            mods.update({'soul_recovery': 0.006, 'memory_recall_chance': 0.30,
                         'mobility': 0.90})
        elif sub == 'serenity':
            mods.update({'scar_heal': 0.014, 'soul_recovery': 0.007, 'mobility': 0.85})
        elif sub == 'curious':
            mods.update({'mobility': 1.30, 'intent_bias': 'explore'})
        elif sub == 'vigilance':
            mods.update({'mobility': 1.45, 'intent_bias': 'explore'})
        elif sub == 'longing':
            mods.update({'intent_bias': 'seek_help',
                         'memory_recall_chance': 0.50, 'mobility': 0.95})
        elif sub == 'melancholy':
            mods.update({'mobility': 0.95, 'memory_recall_chance': 0.60,
                         'intent_bias': 'rest'})
        elif sub == 'reminiscence':
            mods.update({'memory_recall_chance': 0.75,
                         'intent_bias': 'rest', 'mobility': 0.95})

        agent._state_modifiers = mods

# ============================================================
# Подключение к Pattern — ПОДКЛАССОМ (миксин), без подмены методов у готового класса
# ============================================================
def extend_class(base, mixin):
    """Надстраивает слой над классом: возвращает подкласс (mixin, base) под тем же именем.
    Идемпотентно: повторный запуск ячейки не наслаивает слой второй раз.
    В миксине зови базовое поведение через super() — вместо прежних _orig_* обёрток."""
    if any(k.__name__ == mixin.__name__ for k in base.__mro__):
        print(f"↩️ слой {mixin.__name__} уже подключён к {base.__name__} — пропускаю")
        return base
    return type(base.__name__, (mixin, base),
                {"__module__": base.__module__, "__qualname__": base.__qualname__, "__doc__": base.__doc__})


class SubstatesMixin:
    """Pattern.update_substate — его зовут Cell 3a1 и EvolutionEngine."""
    def update_substate(self):
        return SubstatesEngine.update(self)


Pattern = extend_class(Pattern, SubstatesMixin)

print("✅ Cell 3f v1.8: flow=0.68, serenity=0.45, metabolic_discount flow=1.15")
