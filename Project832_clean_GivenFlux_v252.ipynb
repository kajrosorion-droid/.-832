LIVING_WORLD_PATH = "/content/drive/MyDrive/832_living_world.json" if is_colab else "832_living_world.json"

# === 3. Вспомогательная функция для очистки numpy-типов ===
def convert_numpy(obj):
    if isinstance(obj, (np.integer,)):
        return int(obj)
    elif isinstance(obj, (np.floating,)):
        return float(obj)
    elif isinstance(obj, (np.bool_,)):
        return bool(obj)
    elif isinstance(obj, np.ndarray):
        return obj.tolist()
    elif isinstance(obj, dict):
        return {k: convert_numpy(v) for k, v in obj.items()}
    elif isinstance(obj, (list, tuple, set)):
        return [convert_numpy(item) for item in obj]
    else:
        return obj

# === 4. Функции сохранения и загрузки ===
def serialize_pattern(p):
    genome_serializable = {k: float(v) for k, v in p.genome.items()}
    concepts_serializable = {}
    for sig, data in p.concept_graph.nodes.items():
        key_str = str(sig)
        # === ИСПРАВЛЕНО: добавлен eternal и правильный fallback для embed (32) ===
        concepts_serializable[key_str] = {
            "count": float(data.get('count', 1.0)),
            "value": list(data.get('value', np.zeros(4))),
            "embed": list(data.get('embed', np.zeros(32))),
            "eternal": bool(data.get('eternal', False))
        }

    # === ИСПРАВЛЕНО: Прямое и безопасное сохранение _self_narrative ===
    raw_narr = list(getattr(p, '_self_narrative', []))  # приводим к списку, чтобы взять срез
    self_narrative_serializable = []
    for entry in raw_narr[-500:]:  # сохраняем последние 500 записей
        if isinstance(entry, dict):
            safe_dict = {}
            for k, v in entry.items():
                try:
                    safe_dict[k] = float(v) if isinstance(v, (int, float, np.integer, np.floating)) else str(v)
                except:
                    safe_dict[k] = str(v)
            self_narrative_serializable.append(safe_dict)
        else:
            try:
                self_narrative_serializable.append(float(entry))
            except:
                self_narrative_serializable.append(0.5)

    result = {
        "id": int(p.id),
        "cells": [[int(x), int(y)] for (x, y) in p.cells],
        "lineage_id": int(p.lineage_id),
        "lineage_born_at_step": int(p.lineage_born_at_step),
        "lineage_total_age": int(getattr(p, 'lineage_total_age', 0)),
        "age": int(p.age),
        "model": p.model.tolist(),
        "belief": p.belief.tolist(),
        "genome": genome_serializable,
        "semantic_state": str(p.semantic_state),
        "emotional_memory": {k: float(v) for k, v in p.emotional_memory.items()},
        "soul_weight": float(p.soul_weight),
        "role_type": str(p.role_type),
        # ВОССТАНОВЛЕНО: эти 8 полей писала предыдущая версия serialize_pattern
        # (Cell 2), но при расширении этой версии (Cell 11) их потеряли молча.
        # unresolved_contradiction — это "Unresolvable Core" по философии 832:
        # Binding Field обязан сохранять хотя бы одно неразрешённое противоречие,
        # иначе Soul-регистр атрофируется. coherence нужен seed_from_ark для
        # сортировки "лучших" агентов при возрождении мира — без него сортировка
        # молча превращалась в сравнение константы 0 для всех сохранённых узоров.
        "unresolved_contradiction": float(getattr(p, 'unresolved_contradiction', 0.0)),
        "spirit_gap": float(getattr(p, 'spirit_gap', 0.5)),
        "coherence": float(getattr(p, 'coherence', 0.5)),
        "pred_error": float(getattr(p, 'pred_error', 0.5)),
        "epistemic_load": float(getattr(p, 'epistemic_load', 0.3)),
        "intent": ({str(k): (float(v) if isinstance(v, (int, float)) else str(v))
                    for k, v in p.intent.items()} if getattr(p, 'intent', None) else None),
        "_forsaken": bool(getattr(p, '_forsaken', False)),
        "_scar_of_light": bool(getattr(p, '_scar_of_light', False)),
        "concept_graph": concepts_serializable,
        "trust_ledger": {str(k): float(v) for k, v in p.trust_ledger.entries.items() if k is not None},
        "arc_tracker_completed": {str(k): int(v) for k, v in p.arc_tracker.completed_arcs.items()},
        "_redemption_depth": float(getattr(p, '_redemption_depth', 0.0)),
        "_redemption_arc_step": int(getattr(p, '_redemption_arc_step', 0)),
        "_deterministic_redemption_triggered": bool(getattr(p, '_deterministic_redemption_triggered', False)),
        "_redemption_cooldown": int(getattr(p, '_redemption_cooldown', 0)),  # NEW: защита от петли
        "disorganizer_age_at_birth": int(getattr(p, 'disorganizer_age_at_birth', 0)),
        "_cellular_endurance": float(getattr(p, '_cellular_endurance', 1.0)),
        "_vocab_contact_acc": {str(k): int(v) for k, v in getattr(p, '_vocab_contact_acc', {}).items()},
        "event_counts": {str(k): int(v) for k, v in p.event_counts.items()},
        "biography": convert_numpy(list(p.biography)),
        # ФИКС: старая версия делала float(v) на каждое значение entry, что упало бы
        # на новом поле 'soma_snapshot' (это вложенный dict с numpy-массивом внутри).
        # convert_numpy() (определена выше в этой же ячейке) рекурсивно и безопасно
        # переводит dict/ndarray/list/tuple/set в JSON-совместимые типы.
        "dialogue_longterm": [
            convert_numpy(entry) for entry in getattr(p, 'dialogue_longterm', [])[-100:]
        ],
        # НОВОЕ: отдельный буфер соматических снимков (Фаза 1 телесной памяти),
        # чтобы он переживал перезагрузку мира независимо от dialogue_longterm.
        "_soma_snapshots": [
            convert_numpy(snap) for snap in getattr(p, '_soma_snapshots', [])[-20:]
        ],
        "self_narrative": self_narrative_serializable,  # NEW: прямое сохранение нарратива
        "_feral_fury": float(getattr(p, '_feral_fury', 0.0)),           # NEW: Варвары
        "_feral_birth": int(getattr(p, '_feral_birth', 0)),
        "_unconquered_strength": float(getattr(p, '_unconquered_strength', 0.0)),  # NEW: Непокоренные
        "_unconquered_type": getattr(p, '_unconquered_type', None),
        "_times_disorganizer": int(getattr(p, '_times_disorganizer', 0)),   # NEW: Хронические триггеры
    }
    # Слои, которым нужно сохранить своё (SPECTRUM: signal_forms и _lang_gene), отдают данные
    # через p.dump_extra() — без подмены этой функции. Если метода нет, просто ничего не добавляется.
    _dump_extra = getattr(p, 'dump_extra', None)
    if callable(_dump_extra):
        result.update(_dump_extra())
    return result

def deserialize_pattern(data, world):
    cells_set = set(tuple(c) for c in data['cells'])
    p = Pattern(
        pid=data['id'],
        cells=cells_set,
        parent=None,
        world=world
    )
    p.age = max(0, data.get('age', 0))
    p.lineage_id = data.get('lineage_id', p.id)
    p.lineage_born_at_step = max(0, data.get('lineage_born_at_step', 0))
    p.lineage_total_age = max(0, data.get('lineage_total_age', 0))
    p.model = np.array(data['model'])
    p.belief = np.array(data['belief'])
    p.genome = {str(k): float(v) for k, v in data['genome'].items()}
    p.semantic_state = data.get('semantic_state', 'neutral')
    p.emotional_memory = {str(k): float(v) for k, v in data['emotional_memory'].items()}
    p.soul_weight = float(data.get('soul_weight', 0.5))
    p.role_type = data.get('role_type', 'normal')
    # ВОССТАНОВЛЕНО (см. комментарий в serialize_pattern выше): эти поля
    # раньше вообще не читались при загрузке, даже когда старые сохранения
    # их содержали. Дефолты взяты из уже существующих в коде getattr(...)
    # fallback'ов (SubstatesEngine._scores и др.), чтобы поведение агентов,
    # загруженных из старых файлов без этих полей, не отличалось от обычного.
    p.unresolved_contradiction = float(data.get('unresolved_contradiction', 0.0))
    p.spirit_gap = float(data.get('spirit_gap', 0.5))
    p.coherence = float(data.get('coherence', 0.5))
