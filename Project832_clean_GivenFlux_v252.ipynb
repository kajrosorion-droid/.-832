def _lang_ensure_field_channels(engine_or_field):
    field = getattr(engine_or_field, 'field', engine_or_field)
    if field is None or not hasattr(field, 'shape'):
        return field
    if field.shape[2] >= Config.CHANNELS:
        return field
    new = np.zeros((field.shape[0], field.shape[1], Config.CHANNELS), dtype=field.dtype)
    new[:, :, :field.shape[2]] = field
    if hasattr(engine_or_field, 'field'):
        engine_or_field.field = new
        return new
    return new


@dataclass
class FieldEvent:
    sender_id: int
    center: Tuple[int, int]
    amplitude: float
    start_t: int
    end_t: int
    radius: int
    decay: float

    def is_active(self, t: int) -> bool:
        return self.start_t <= t < self.end_t

    def get_attenuation(self, point: Tuple[int, int]) -> float:
        cx, cy = self.center
        px, py = point
        dist = math.hypot(cx - px, cy - py)
        if dist > self.radius:
            return 0.0
        return math.exp(-dist / self.decay)


class CommunicationField:
    def __init__(self, config):
        self.config = config
        self.world_size = config.WORLD_SIZE
        self.events: List[FieldEvent] = []
        self.t = 0
        self._noise_cache = {}
        self.tx_registry: Dict[int, Tuple[Tuple[int, int], int]] = {}

    def step(self, t: int):
        self.t = t
        self.events = [ev for ev in self.events if ev.end_t > t]
        self._noise_cache = {}
        if self.tx_registry:
            self.tx_registry = {sid: v for sid, v in self.tx_registry.items()
                                if v[1] > t}

    def add_pulse(self, sender_id, center, amplitude, start_t, duration, radius, decay):
        self.events.append(FieldEvent(sender_id, center, amplitude,
                                      start_t, start_t + duration, radius, decay))

    def register_tx(self, sender_id, center, end_t):
        self.tx_registry[sender_id] = (center, end_t)

    def unregister_tx(self, sender_id):
        self.tx_registry.pop(sender_id, None)

    def nearby_transmitters(self, point, radius, exclude=None):
        wall_on = getattr(self.config, 'ENABLE_CENTER_WALL', False)
        wx = getattr(self.config, 'CENTER_WALL_X', None)
        res = []
        for sid in sorted(self.tx_registry):
            if sid == exclude:
                continue
            c, end_t = self.tx_registry[sid]
            if end_t <= self.t:
                continue
            if wall_on and wx is not None and (c[0] < wx) != (point[0] < wx):
                continue
            if math.hypot(c[0] - point[0], c[1] - point[1]) <= radius:
                res.append(sid)
        return res

    def _get_noise_at(self, x, y):
        key = (x, y)
        if key not in self._noise_cache:
            seed = getattr(self.config, 'DETERMINISTIC_SEED', 777)
            scale = getattr(self.config, 'MORSE_NOISE_SCALE', 0.02)
            h = phi_hash(x + self.t, y + self.t, seed)
            self._noise_cache[key] = (h - 0.5) * scale
        return self._noise_cache[key]

    def get_amplitude_at(self, point):
        total = 0.0
        for ev in self.events:
            if ev.is_active(self.t):
                total += ev.amplitude * ev.get_attenuation(point)
        total += self._get_noise_at(point[0], point[1])
        return max(0.0, total)

    def get_state(self, point, radius):
        cx, cy = point
        samples = []
        for dx in range(-radius, radius + 1):
            for dy in range(-radius, radius + 1):
                nx = (cx + dx) % self.world_size
                ny = (cy + dy) % self.world_size
                samples.append(self.get_amplitude_at((nx, ny)))
        return {'mean': float(np.mean(samples)), 'max': float(np.max(samples)),
                'samples': samples}

    def get_active_events_at(self, point, radius, t):
        result = []
        for ev in self.events:
            if not ev.is_active(t):
                continue
            dist = math.hypot(ev.center[0] - point[0], ev.center[1] - point[1])
            if dist <= radius:
                result.append(ev)
        return result

    def sync_to_field(self, field, channel):
        field = _lang_ensure_field_channels(field)
        for x in range(self.world_size):
            for y in range(self.world_size):
                field[x, y, channel] = self.get_amplitude_at((x, y))


class Transmitter:
    def __init__(self, sender_id, field, config):
        self.sender_id = sender_id
        self.field = field
        self.config = config
        self.timeline: List[Tuple[str, int]] = []
        self.idx = 0
        self.timer = 0
        self.active = False
        self.energy_sent = 0.0
        self.attempts = 0
        self._last_step_t = None
        self.anchor = None
        self.diag = Counter()

    def set_field(self, field):
        self.field = field

    def send_timeline(self, timeline, center, t):
        if self.active or not self.field or not timeline:
            return False
        self.timeline = timeline
        self.idx = 0
        self.timer = 0
        self.active = True
        self._last_step_t = None
        self.attempts += 1
        self.anchor = (int(center[0]), int(center[1]))
        total = sum(d for _, d in timeline)
        self.field.register_tx(self.sender_id, center, int(self.field.t) + total + 1)
        self.diag['tx_started'] += 1
        return True

    def _finish(self):
        self.active = False
        if self.field:
            self.field.unregister_tx(self.sender_id)
        self.diag['tx_completed'] += 1

    def step(self, center, t):
        if not self.active or not self.field:
            return
        if self._last_step_t == t:
            self.diag['tx_double_step_blocked'] += 1
            return
        self._last_step_t = t
        if getattr(self.config, 'MORSE_FREEZE_TX_CENTER', True) and self.anchor is not None:
            center = self.anchor
        if self.idx >= len(self.timeline):
            self._finish()
            return
        ev_type, duration = self.timeline[self.idx]
        if ev_type == 'PULSE':
            if self.timer == 0:
                self.field.add_pulse(self.sender_id, center, 1.0, t + 1, duration,
                                      self.config.MORSE_BROADCAST_RADIUS,
                                      self.config.MORSE_DECAY)
                self.energy_sent += 1.0 * duration
            self.timer += 1
            if self.timer >= duration:
                self.timer = 0
                self.idx += 1
        else:
            self.timer += 1
            if self.timer >= duration:
                self.timer = 0
                self.idx += 1
        if self.idx >= len(self.timeline):
            self._finish()

    def reset(self):
        if self.active:
            self.diag['tx_aborted'] += 1
        if self.field:
            self.field.unregister_tx(self.sender_id)
        self.timeline = []
        self.idx = 0
        self.timer = 0
        self.active = False
        self.energy_sent = 0.0
        self.attempts = 0
        self._last_step_t = None
        self.anchor = None


@dataclass
class Session:
    started_at: Optional[int] = None
    last_signal_at: Optional[int] = None
    signal_energy: float = 0.0
    noise_energy: float = 0.0
    interference_energy: float = 0.0
    buffer: str = ''
    symbols: List[str] = field(default_factory=list)
    sender_candidates: List[int] = field(default_factory=list)
    active_events: List[FieldEvent] = field(default_factory=list)
    dominant_sender: Optional[int] = None
    sender_switches: int = 0
    sender_energy: Dict[int, float] = field(default_factory=dict)


class Receiver:
    def __init__(self, agent_id, field, config):
        self.agent_id = agent_id
        self.field = field
        self.config = config
        self.session = Session()
        self.signal_counter = 0
        self.gap_counter = 0
        self.last_detection_t = -100
        self.noise_floor = 0.01
        self._last_listen_t = None
        self.diag = Counter()
        self.metrics = {
            'attempted': 0, 'detected': 0, 'decoded': 0, 'corrupted': 0,
            'uncertain': 0, 'collision': 0, 'timeout': 0, 'false_positive': 0,
            'energy_received': 0.0, 'mean_confidence': 0.0,
            'unique_senders': set(), 'sender_switches': 0,
        }

    def set_field(self, field):
        self.field = field

    def _build_event(self, t, raw_buffer):
        cfg = self.config
        s = self.session
        total_energy = s.signal_energy + s.noise_energy + s.interference_energy + 1e-6
        confidence = float(np.clip(s.signal_energy / total_energy, 0.0, 1.0))
        interference_ratio = s.interference_energy / max(s.signal_energy, 1e-9)
        reliable = confidence >= cfg.MORSE_CONFIDENCE_THRESHOLD
        uncertain = cfg.MORSE_CORRUPTION_THRESHOLD <= confidence < cfg.MORSE_CONFIDENCE_THRESHOLD
        corrupted = confidence < cfg.MORSE_CORRUPTION_THRESHOLD
        collision_detected = interference_ratio > cfg.MORSE_COLLISION_RATIO_THRESHOLD

        dominant, share, mixed = None, 0.0, False
        if s.sender_energy:
            dominant = max(s.sender_energy.items(), key=lambda kv: (kv[1], -kv[0]))[0]
            tot = sum(s.sender_energy.values())
            share = s.sender_energy[dominant] / tot if tot > 1e-12 else 0.0
            if len(s.sender_energy) >= 2 and tot > 1e-12:
                second = sorted(s.sender_energy.values(), reverse=True)[1]
                mixed = (second / tot) >= cfg.MORSE_MIXED_SHARE
        return {
            'raw_signal': raw_buffer,
            'confidence': confidence, 'corrupted': corrupted,
            'uncertain': uncertain, 'reliable': reliable,
            'collision_detected': collision_detected,
            'sender_candidates': sorted(s.sender_energy),
            'dominant_sender': dominant,
            'dominant_share': share,
            'mixed': mixed,
            'sender_switches': s.sender_switches,
            'signal_energy': s.signal_energy,
            'noise_energy': s.noise_energy,
            'interference_energy': s.interference_energy,
            'interference_ratio': interference_ratio,
            'duration': t - (s.started_at or 0),
        }

    def listen(self, point, t):
        cfg = self.config
        if not self.field or t % cfg.MORSE_LISTEN_INTERVAL != 0:
            return None
        if self._last_listen_t == t:
            self.diag['rx_listen_double_blocked'] += 1
            return None
        self._last_listen_t = t

        active = self.field.get_active_events_at(point, cfg.MORSE_LISTEN_RADIUS, t)
        wall_on = getattr(cfg, 'ENABLE_CENTER_WALL', False)
        wx = getattr(cfg, 'CENTER_WALL_X', None)
        self_side_left = wall_on and point[0] < wx
        exclude_self = bool(getattr(cfg, 'MORSE_SELF_EXCLUDE', True))

        per_sender: Dict[int, float] = {}
        own_contrib = 0.0
        for ev in active:
            if wall_on and (ev.center[0] < wx) != self_side_left:
                continue
            contrib = ev.amplitude * ev.get_attenuation(point)
            if ev.sender_id == self.agent_id:
                own_contrib += contrib
                continue
            per_sender[ev.sender_id] = per_sender.get(ev.sender_id, 0.0) + contrib
        contributions = sorted(((c, sid) for sid, c in per_sender.items() if c > 0.0),
                               key=lambda x: (-x[0], x[1]))

        threshold = cfg.MORSE_SIGNAL_THRESHOLD_MULT * cfg.MORSE_NOISE_SCALE * 0.5
        if exclude_self:
            if own_contrib > threshold:
                self.diag['rx_self_echo_obs'] += 1
            observed_events = sum(per_sender.values())
        else:
            observed_events = sum(per_sender.values()) + own_contrib
        observed = max(0.0, observed_events + self.field._get_noise_at(point[0], point[1]))

        signal_contrib = contributions[0][0] if contributions else 0.0
        top_sender = contributions[0][1] if contributions else None
        interference_contrib = (sum(c for c, _ in contributions[1:])
                                 if len(contributions) > 1 else 0.0)
        noise_contrib = max(0.0, observed - signal_contrib - interference_contrib)

        dot_len = cfg.MORSE_DOT_LEN
        block_gap = dot_len * int(cfg.MORSE_BLOCK_SEPARATOR_MULT)
        end_gap = dot_len * int(cfg.MORSE_SIGNAL_END_MULT)

        if observed > threshold:
            self.signal_counter += 1
            self.gap_counter = 0
            self.last_detection_t = t
            self.metrics['detected'] += 1
            s = self.session
            s.signal_energy += signal_contrib
            s.noise_energy += noise_contrib
            s.interference_energy += interference_contrib
            for c, sid in contributions:
                s.sender_energy[sid] = s.sender_energy.get(sid, 0.0) + c
            if top_sender is not None:
                if s.dominant_sender is None:
                    s.dominant_sender = top_sender
                elif s.dominant_sender != top_sender:
                    s.sender_switches += 1
                    s.dominant_sender = top_sender
            s.active_events = active
            if s.started_at is None:
                s.started_at = t
            s.last_signal_at = t
        else:
            self.gap_counter += 1
            if self.signal_counter > 0:
                duration_ticks = self.signal_counter * cfg.MORSE_LISTEN_INTERVAL
                self.signal_counter = 0
                self.session.buffer += '-' if duration_ticks >= dot_len * 2 else '.'
                self.session.symbols.append(self.session.buffer[-1])
            if self.session.buffer:
                gap_ticks = self.gap_counter * cfg.MORSE_LISTEN_INTERVAL
                if gap_ticks >= end_gap:
                    raw_buffer = self.session.buffer.strip()
                    if raw_buffer:
                        event = self._build_event(t, raw_buffer)
                        if event['reliable']:
                            self.metrics['decoded'] += 1
                        elif event['uncertain']:
                            self.metrics['uncertain'] += 1
                        else:
                            self.metrics['corrupted'] += 1
                        if event['collision_detected']:
                            self.metrics['collision'] += 1
                        self.metrics['energy_received'] += self.session.signal_energy
                        old_count = (self.metrics['decoded'] + self.metrics['corrupted']
                                     + self.metrics['uncertain'])
                        self.metrics['mean_confidence'] = (
                            (self.metrics['mean_confidence'] * (old_count - 1)
                             + event['confidence']) / old_count)
                        self.metrics['unique_senders'].update(event['sender_candidates'])
                        self.metrics['sender_switches'] += self.session.sender_switches
                        self.session = Session()
                        self.gap_counter = 0
                        self.diag['rx_sessions'] += 1
                        return event
                    self.session = Session()
                    self.gap_counter = 0
                elif gap_ticks >= block_gap:
                    if not self.session.buffer.endswith(' '):
                        self.session.buffer += ' '
            if (self.session.started_at is not None
                    and self.session.last_signal_at is not None
                    and (t - self.session.last_signal_at) > cfg.MORSE_TIMEOUT_TICKS):
                self.metrics['timeout'] += 1
                self.diag['rx_timeouts'] += 1
                self.session = Session()
                self.gap_counter = 0
        return None

    def get_metrics(self):
        metrics = dict(self.metrics)
        metrics['unique_senders'] = len(metrics['unique_senders'])
        return metrics

    def reset_metrics(self):
        self.metrics = {k: (set() if k == 'unique_senders'
                             else 0.0 if k in ('mean_confidence', 'energy_received') else 0)
                         for k in self.metrics}


_INTENT_SCALE = np.array([1.0, 1.0, 1.5, 0.3], dtype=np.float32)

NULL_CLUSTER_ID       = -1
CREATE_NEW_CLUSTER_ID = -2


def _agent_intent_vector(agent) -> np.ndarray:
    grief = float(agent.emotional_memory.get('grief', 0.0))
    grat = float(agent.emotional_memory.get('gratitude', 0.0))
    gap = float(getattr(agent, 'spirit_gap', 0.0))
    energy_deficit = max(0.0, 0.3 - float(getattr(agent, 'energy', 0.3)))
    return np.array([grief, grat, gap, energy_deficit], dtype=np.float32)


def _dominant_intent_axis(intent):
    return int(np.argmax(intent / _INTENT_SCALE))


def _lang_gene_init(speaker, parent=None):
    if parent is not None:
        rng = np.random.default_rng(abs(hash((speaker.id, parent.id))) % (2**32))
        mutation = rng.normal(0, Config.LANG_GENE_MUTATION_STD, size=4)
        speaker._lang_gene = np.clip(parent._lang_gene + mutation, 0.05, 0.95).astype(np.float32)
    else:
        rng = np.random.default_rng(abs(hash(speaker.id)) % (2**32))
        speaker._lang_gene = rng.uniform(0.15, 0.85, size=4).astype(np.float32)


def generate_intent_timeline(speaker):
    intent = _agent_intent_vector(speaker)
    norm = float(np.linalg.norm(intent))
    if norm < Config.LANG_MIN_INTENT_NORM:
        return []

    dot_len = Config.MORSE_DOT_LEN
    normalized = np.clip(intent / _INTENT_SCALE, 0.0, 1.0)
    gene = speaker._lang_gene

    c_short = dot_len * Config.LANG_COST_PER_PULSE_TICK
    c_long  = dot_len * 3 * Config.LANG_COST_PER_PULSE_TICK
    gene_mean = float(np.mean(gene))
    c_avg = c_short * (1 - gene_mean) + c_long * gene_mean
    n_aff = int(speaker.energy / max(c_avg, 1e-9))
    K = int(np.clip(n_aff // 4, 0, Config.LANG_PULSES_PER_AXIS_MAX))
    if K < 1:
        return []

    timeline = []
    for axis in range(4):
        value = float(normalized[axis])
        base_long = int(round(value * K * Config.LANG_GENE_GAIN * float(gene[axis])))
        base_long = max(0, min(K, base_long))
        for j in range(K):
            dur = dot_len * 3 if j < base_long else dot_len
            timeline.append(('PULSE', dur))
            if j < K - 1:
                timeline.append(('GAP', dot_len))
        timeline.append(('GAP', dot_len * Config.MORSE_INTER_AXIS_GAP_MULT))
    timeline.append(('GAP', dot_len * Config.MORSE_TRAILING_GAP))

    total_pulse_ticks = sum(d for kind, d in timeline if kind == 'PULSE')
    cost = total_pulse_ticks * Config.LANG_COST_PER_PULSE_TICK
    if cost > speaker.energy:
        return []
    speaker._x2_change('X2.morse_transmit_cost', speaker.energy - cost)
    return timeline


class EmergentLexicon:
    def __init__(self):
        self.clusters: List[str] = []
        self.cluster_targets: Dict[int, float] = {}
        self.cluster_meanings: Dict[int, np.ndarray] = {}
        self.assoc: Dict[int, np.ndarray] = defaultdict(lambda: np.zeros(4, dtype=np.float32))
        self.cluster_uses: Dict[int, int] = defaultdict(int)
        self.cluster_senders: Dict[int, Counter] = defaultdict(Counter)
        self.pending = deque()
        self.log_raw_lengths = deque(maxlen=3000)
        self.log_cluster_count = deque(maxlen=3000)
        self.log_gene_diversity = deque(maxlen=3000)
        self.reinforcement_events = 0
        self.reinforcement_log = deque(maxlen=3000)
        self._axis_switch_diag = {'same': 0, 'switched': 0}
        self._sender_last_axis = {}
        self._ctx_mean = np.zeros(4, dtype=np.float32)
        self.rx_total = 0
        self.rx_null = Counter()
        self.rx_block_counts = Counter()
        self.send_k_counts = Counter()
        self.send_silence = Counter()
        self.send_energy_spent = 0.0
        self.chan = Counter()
        self.fidelity_log = deque(maxlen=3000)
        self.decode_block_count_log    = deque(maxlen=3000)
        self.null_cluster_log          = deque(maxlen=3000)
        self.cluster_meanings_norm_log = deque(maxlen=3000)

    @staticmethod
    def _long_ratio(raw):
        symbols = [c for c in raw if c != ' ']
        if not symbols:
            return 0.5
        return sum(1 for c in symbols if c == '-') / len(symbols)

    def _similarity(self, a, b):
        la = len([c for c in a if c != ' '])
        lb = len([c for c in b if c != ' '])
        len_sim = 1.0 - abs(la - lb) / max(la, lb, 1)
        ra, rb = self._long_ratio(a), self._long_ratio(b)
        ratio_sim = 1.0 - abs(ra - rb)
        return 0.5 * len_sim + 0.5 * ratio_sim

    @staticmethod
    def _decode_to_vector(raw):
        """v4.5: мягкий декодер (как v4.4).
        2..4 блока -> валидно, недостающие оси = 0.
        >4 блоков  -> обрезается до первых 4.
        <2 блоков  -> NULL."""
        if not raw or not raw.strip():
            return None, 0
        blocks = [b for b in raw.split() if b.strip()]
        nb = len(blocks)
        if nb == 0:
            return None, 0
        n_blocks_original = nb
        if nb > 4:
            blocks = blocks[:4]
        if nb < 2:
            return None, n_blocks_original
        vec = np.zeros(4, dtype=np.float32)
        for i, blk in enumerate(blocks[:4]):
            syms = [c for c in blk if c in '.-']
            if not syms:
                continue
            vec[i] = sum(1 for c in syms if c == '-') / len(syms)
        return vec * _INTENT_SCALE, n_blocks_original

    def cluster_id_for(self, raw):
        decoded, n_blocks = self._decode_to_vector(raw)
        if decoded is None:
            return NULL_CLUSTER_ID, None
        norm_d = float(np.linalg.norm(decoded))
        if norm_d < Config.LANG_NULL_DECODED_NORM:
            return NULL_CLUSTER_ID, None
        if not self.cluster_meanings:
            return CREATE_NEW_CLUSTER_ID, decoded
        best_id, best_cos = -1, -1.0
        for cid, m in self.cluster_meanings.items():
            m_norm = float(np.linalg.norm(m)) + 1e-9
            cos = float(np.dot(decoded, m) / (norm_d * m_norm))
            if cos > best_cos:
                best_cos, best_id = cos, cid
        if best_id != -1 and best_cos >= 1.0 - Config.LANG_CLUSTER_TOL:
            return best_id, decoded
        if len(self.cluster_meanings) < Config.LANG_MAX_CLUSTERS:
            return CREATE_NEW_CLUSTER_ID, decoded
        return best_id, decoded

    def register_reception(self, raw, receiver, sender_id, t):
        _receiver_obj = receiver if hasattr(receiver, 'emotional_memory') else None
        if isinstance(receiver, int) and not isinstance(receiver, bool):
            _receiver_id = receiver
        else:
            _receiver_id = getattr(receiver, 'id', -1)

        decoded, n_blocks = self._decode_to_vector(raw)
        self.rx_total += 1
        self.rx_block_counts[n_blocks] += 1
        self.decode_block_count_log.append(n_blocks)

        if decoded is None:
            self.rx_null['quiet' if n_blocks == 0 else 'blocks'] += 1
            self.null_cluster_log.append({
                't': t, 'receiver': _receiver_id, 'sender': sender_id,
                'raw_len': len(raw.replace(' ', '')), 'n_blocks': n_blocks,
            })
            return NULL_CLUSTER_ID

        norm_d = float(np.linalg.norm(decoded))
        self.cluster_meanings_norm_log.append(norm_d)
        if norm_d < Config.LANG_NULL_DECODED_NORM:
            self.rx_null['norm'] += 1
            self.null_cluster_log.append({
                't': t, 'receiver': _receiver_id, 'sender': sender_id,
                'raw_len': len(raw.replace(' ', '')), 'n_blocks': n_blocks,
            })
            return NULL_CLUSTER_ID

        if not self.cluster_meanings:
            cid = CREATE_NEW_CLUSTER_ID
        else:
            best_id, best_cos = -1, -1.0
            for c, m in self.cluster_meanings.items():
                m_norm = float(np.linalg.norm(m)) + 1e-9
                cos = float(np.dot(decoded, m) / (norm_d * m_norm))
                if cos > best_cos:
                    best_cos, best_id = cos, c
            if best_id != -1 and best_cos >= 1.0 - Config.LANG_CLUSTER_TOL:
                cid = best_id
            elif len(self.cluster_meanings) < Config.LANG_MAX_CLUSTERS:
                cid = CREATE_NEW_CLUSTER_ID
            else:
                cid = best_id

        if cid == CREATE_NEW_CLUSTER_ID:
            cid = len(self.cluster_meanings)
            self.cluster_meanings[cid] = decoded.copy()
            self.clusters.append(raw)
        else:
            self.cluster_meanings[cid] = (
                0.9 * self.cluster_meanings[cid] + 0.1 * decoded).astype(np.float32)

        self.cluster_uses[cid] += 1
        if sender_id is not None and sender_id != -1:
            self.cluster_senders[cid][sender_id] += 1

        ratio = self._long_ratio(raw)
        old_target = self.cluster_targets.get(cid, ratio)
        self.cluster_targets[cid] = 0.9 * old_target + 0.1 * ratio

        if _receiver_obj is not None:
            ctx_before = np.array([
                float(_receiver_obj.emotional_memory.get('grief', 0.0)),
                float(_receiver_obj.emotional_memory.get('gratitude', 0.0)),
                float(getattr(_receiver_obj, 'spirit_gap', 0.0)),
                max(0.0, 0.3 - float(getattr(_receiver_obj, 'energy', 0.3))),
            ], dtype=np.float32)
        else:
            ctx_before = np.zeros(4, dtype=np.float32)

        self.pending.append((t, cid, _receiver_id, sender_id, ctx_before))
        self.log_raw_lengths.append(len(raw.replace(' ', '')))
        self.log_cluster_count.append(len(self.clusters))
        return cid

    def reinforce_sender(self, sender, cid):
        if sender is None or not getattr(sender, 'alive', False):
            return
        if cid in (NULL_CLUSTER_ID, CREATE_NEW_CLUSTER_ID):
            return
        gene = getattr(sender, '_lang_gene', None)
        if gene is None:
            return
        learned = self.cluster_meanings.get(cid)
        if learned is None:
            return

        target_vec = np.clip(learned / _INTENT_SCALE, 0.0, 1.0).astype(np.float32)
        intent = _agent_intent_vector(sender)
        if float(np.linalg.norm(intent)) < 1e-6:
            return
        value_norm = np.clip(intent / _INTENT_SCALE, 0.0, 1.0).astype(np.float32)

        denom = Config.LANG_GENE_GAIN * value_norm + 1e-6
        target_gene = np.clip(target_vec / denom, 0.0, 1.0)

        weights = value_norm.copy()
        weights[weights < Config.LANG_AXIS_ACTIVE_MIN] = 0.0
        if float(weights.sum()) < 1e-9:
            return
        weights = weights / float(weights.sum())

        lr = Config.LANG_REINFORCE_LR
        before = gene.copy()
        gene[:] = np.clip(
            (1 - lr * weights) * gene + (lr * weights) * target_gene,
            0.05, 0.95).astype(np.float32)

        self.reinforcement_events += 1
        self.reinforcement_log.append(float(np.mean(np.abs(before - target_gene))))

        axis = _dominant_intent_axis(intent)
        prev = self._sender_last_axis.get(sender.id)
        if prev is not None:
            self._axis_switch_diag['same' if prev == axis else 'switched'] += 1
        self._sender_last_axis[sender.id] = axis

        sender.soul_weight = min(1.0, float(sender.soul_weight)
                                 + Config.LANG_REINFORCE_SOUL_BONUS)

    def resolve_context(self, patterns_by_id, t, window=5):
        while self.pending:
            item = self.pending[0]
            if len(item) == 5:
                t_recv, cid, rid, sid, ctx_before = item
            else:
                t_recv, cid, rid, sid = item
                ctx_before = None
            if t - t_recv < window:
                break
            self.pending.popleft()
            receiver = patterns_by_id.get(rid)
            if receiver is None or not getattr(receiver, 'alive', False):
                continue
            if ctx_before is not None and float(np.linalg.norm(ctx_before)) > 1e-6:
                alpha = 0.02
                centered = ctx_before - self._ctx_mean
                self._ctx_mean = (1 - alpha) * self._ctx_mean + alpha * ctx_before
            else:
                ctx = np.array([
                    float(receiver.emotional_memory.get('grief', 0.0)),
                    float(receiver.emotional_memory.get('gratitude', 0.0)),
                    float(getattr(receiver, 'spirit_gap', 0.0)),
                    max(0.0, 0.3 - float(getattr(receiver, 'energy', 0.3))),
                ], dtype=np.float32)
                centered = ctx
            old_assoc = self.assoc[cid]
            new_assoc = (1 - Config.LANG_HEBB_LR) * old_assoc + Config.LANG_HEBB_LR * centered
            self.assoc[cid] = new_assoc
            norm = float(np.linalg.norm(new_assoc))
            if norm > 1e-6 and sid is not None and sid != -1:
                scaled = new_assoc / _INTENT_SCALE
                probs = np.abs(scaled) / (np.abs(scaled).sum() + 1e-8)
                confidence = float(np.max(probs))
                if confidence > Config.LANG_REINFORCE_CONFIDENCE_MIN:
                    sender = patterns_by_id.get(sid)
                    self.reinforce_sender(sender, cid)
        for cid in list(self.assoc.keys()):
            self.assoc[cid] *= (1.0 - Config.LANG_HEBB_DECAY)

    def log_population_gene_diversity(self, patterns_by_id):
        genes = [p._lang_gene for p in patterns_by_id.values()
                 if getattr(p, 'alive', False)]
        if len(genes) < 2:
            return
        arr = np.stack(genes)
        self.log_gene_diversity.append(float(np.mean(np.std(arr, axis=0))))

    def dominant_meaning_labels(self):
        names = ['grief', 'gratitude', 'spirit_gap', 'energy_deficit']
        if not self.cluster_meanings:
            return {}
        all_mean = np.mean(list(self.cluster_meanings.values()), axis=0)
        out = {}
        for cid, vec in self.cluster_meanings.items():
            centered = vec - all_mean
            if np.linalg.norm(centered) < 1e-3:
                out[cid] = 'ambiguous'
                continue
            scaled = centered / _INTENT_SCALE
            probs = np.abs(scaled) / (np.abs(scaled).sum() + 1e-8)
            if float(np.max(probs)) < Config.LANG_REINFORCE_CONFIDENCE_MIN:
                out[cid] = 'ambiguous'
                continue
            out[cid] = names[int(np.argmax(scaled))]
        return out


def _morse_init_patch(self):
    if not hasattr(self, '_morse_queue'):
        self._morse_queue = deque(maxlen=5)
    if not hasattr(self, '_morse_tx'):
        self._morse_tx = Transmitter(self.id, None, Config)
    if not hasattr(self, '_morse_rx'):
        self._morse_rx = Receiver(self.id, None, Config)
    if not hasattr(self, '_dialogue_cooldown'):
        self._dialogue_cooldown = -1
    for attr in ['_morse_timeline', '_morse_idx', '_morse_timer', '_morse_buffer',
                 '_morse_signal_counter', '_morse_noise_floor', '_morse_last_sender',
                 '_morse_gap_counter', '_morse_last_send_t', '_morse_last_recv_t',
                 '_morse_silence_counter', '_morse_backoff']:
        if not hasattr(self, attr):
            if attr == '_morse_noise_floor':
                setattr(self, attr, 0.01)
            elif attr in ('_morse_last_sender', '_morse_last_send_t', '_morse_last_recv_t'):
                setattr(self, attr, -100 if 'send' in attr or 'recv' in attr else -1)
            else:
                setattr(self, attr, 0)


def _morse_set_field(self, field):
    self._morse_tx.set_field(field)
    self._morse_rx.set_field(field)


def _morse_flush_diag(self, lex=None):
    if lex is None:
        lex = self.world.EMERGENT_LEXICON if getattr(self, 'world', None) is not None else None
    for obj in (self._morse_tx, self._morse_rx):
        d = obj.diag
        if d:
            if lex is not None:
                for k, v in d.items():
                    lex.chan[k] += v
            d.clear()


def _morse_reset_patch(self):
    self._morse_timeline = []
    self._morse_idx = 0
    self._morse_timer = 0
    self._morse_buffer = ''
    self._morse_signal_counter = 0
    self._morse_gap_counter = 0
    self._morse_last_sender = -1
    self._morse_silence_counter = 0
    self._morse_backoff = 0
    self._dialogue_cooldown = -1
    self._morse_queue.clear()
    self._morse_tx.reset()
    self._morse_rx.reset_metrics()
    self._morse_flush_diag()


def _get_center_cell(self):
    cx, cy = self.get_center()
    return int(cx), int(cy)


def _send_morse(self, _unused_text_arg, field, recipient_id=None):
    lex = self.world.EMERGENT_LEXICON if self.world is not None else None

    if not Config.ENABLE_MORSE_COMMUNICATION or not self.alive or not self.cells:
        return
    if self._morse_backoff > 0:
        if lex is not None: lex.send_silence['backoff'] += 1
        return
    if self._morse_tx.active:
        if lex is not None: lex.send_silence['tx_active'] += 1
        return

    center = self._get_center_cell()
    tx_field = self._morse_tx.field
    if Config.MORSE_NAV_ENABLED and tx_field is not None:
        if tx_field.nearby_transmitters(center, Config.MORSE_NAV_RADIUS,
                                        exclude=self.id):
            self._morse_backoff = int(phi_hash(self.id, self.age, 5512)
                                       * Config.MORSE_BACKOFF_MAX) + 1
            if lex is not None:
                lex.send_silence['nav_busy'] += 1
                lex.chan['tx_nav_deferred'] += 1
            return
    if self._morse_rx.field is not None:
        state = self._morse_rx.field.get_state(center, Config.MORSE_LISTEN_RADIUS)
        if state['mean'] > 0.05:
            self._morse_backoff = int(phi_hash(self.id, self.age, 5511)
                                       * Config.MORSE_BACKOFF_MAX) + 1
            if lex is not None: lex.send_silence['busy_channel'] += 1
            return
    if self.age - self._morse_last_send_t < Config.MORSE_SEND_COOLDOWN:
        if lex is not None: lex.send_silence['cooldown'] += 1
        return

    intent_pre = _agent_intent_vector(self)
    if float(np.linalg.norm(intent_pre)) < Config.LANG_MIN_INTENT_NORM:
        if lex is not None: lex.send_silence['no_intent'] += 1
        return

    thr = float(Config.LANG_INTENT_CHANGE_THRESHOLD)
    last = getattr(self, '_last_sent_intent', None)
    if thr > 0.0 and last is not None and last.shape == intent_pre.shape:
        if float(np.linalg.norm(intent_pre - last)) < thr:
            if lex is not None:
                lex.send_silence['no_change'] += 1
            return

    energy_before = float(self.energy)
    timeline = generate_intent_timeline(self)
    if not timeline:
        if lex is not None: lex.send_silence['too_poor'] += 1
        return
    energy_spent = energy_before - float(self.energy)

    n_pulses = sum(1 for k, _ in timeline if k == 'PULSE')
    K_sent = max(1, n_pulses // 4)

    self._last_sent_intent = intent_pre.copy()
    self._last_sent_t = self.age

    if self._morse_tx.send_timeline(timeline, center, self.age):
        self._morse_last_send_t = self.age
        if lex is not None:
            lex.send_k_counts[K_sent] += 1
            lex.send_energy_spent += energy_spent
        self._log_event("morse_enqueue", n_pulses=n_pulses)


def _process_morse_queue(self, field, t):
    if not Config.ENABLE_MORSE_COMMUNICATION or not self.alive or not self.cells:
        return
    if self._morse_backoff > 0:
        self._morse_backoff -= 1
        return
    center = self._get_center_cell()
    if not self._morse_tx.active and self._morse_queue:
        _, recipient = self._morse_queue.popleft()
        timeline = generate_intent_timeline(self)
        if timeline:
            self._morse_tx.send_timeline(timeline, center, t)
            self._log_event("morse_start",
                            n_pulses=sum(1 for k, _ in timeline if k == 'PULSE'))
    self._morse_tx.step(center, t)


def _listen_morse(self, field, t):
    if not Config.ENABLE_MORSE_COMMUNICATION or not self.alive or not self.cells:
        return
    event = self._morse_rx.listen(self._get_center_cell(), t)
    lex = self.world.EMERGENT_LEXICON if self.world is not None else None
    self._morse_flush_diag(lex)
    if not event or lex is None:
        return
    ch = lex.chan
    ch['rx_conf_reliable' if event['reliable'] else
       'rx_conf_uncertain' if event['uncertain'] else 'rx_conf_corrupted'] += 1
    if event['collision_detected']:
        ch['rx_collision_flag'] += 1
    raw = event.get('raw_signal', '')
    if not raw:
        return
    sender = event.get('dominant_sender', None)
    if (sender is None or not isinstance(sender, (int, np.integer))
            or int(sender) in (-1, self.id)):
        ch['rx_dropped_no_sender'] += 1
        return
    if event.get('mixed') and Config.MORSE_DROP_MIXED:
        ch['rx_dropped_mixed'] += 1
        return
    ch['rx_to_lexicon'] += 1
    self._handle_morse_message(raw, int(sender), event)


def _handle_morse_message(self, raw_signal, sender_id, event=None):
    if not raw_signal or sender_id is None or sender_id == -1 or self.world is None:
        return
    lex = self.world.EMERGENT_LEXICON
    cid = lex.register_reception(raw_signal, self, sender_id, self.world.age)

    if cid == NULL_CLUSTER_ID:
        self._log_event("morse_null_cluster",
                        sender=sender_id,
                        raw_len=len(raw_signal.replace(' ', '')))
        return

    sender = self.world.pattern_dict.get(sender_id)
    if (sender is not None
            and hasattr(sender, '_last_sent_intent')
            and hasattr(sender, '_last_sent_t')
            and (self.world.age - sender._last_sent_t) < Config.MORSE_TIMEOUT_TICKS):
        decoded_fid, _ = lex._decode_to_vector(raw_signal)
        if decoded_fid is not None:
            orig = sender._last_sent_intent
            denom = float(np.linalg.norm(orig)) + 1e-9
            fid = 1.0 - float(np.linalg.norm(decoded_fid - orig)) / denom
            fid = max(0.0, min(1.0, fid))
            lex.fidelity_log.append(fid)

    self.remember_dialogue(sender_id, f"[SIGNAL cluster={cid}]",
                            getattr(self.world, 'age', 0))
    if self.world and self.world.archive is not None:
        try:
            self.world.archive.write_queue.append({
                'type': 'raw_signal', 'agent_id': self.id, 'sender_id': sender_id,
                'cluster_id': cid, 'raw_len': len(raw_signal.replace(' ', '')),
                't': getattr(self.world, 'age', 0),
                'soul_weight': float(self.soul_weight),
            })
        except Exception:
            pass
    self.trust_ledger.update(sender_id, 'helpful', multiplier=0.3)

    if event and event.get('reliable', False):
        learned = lex.cluster_meanings.get(cid)
        if (learned is not None
                and float(np.linalg.norm(learned)) > Config.LANG_NULL_DECODED_NORM):
            g, gr, gap, ed = [float(x) for x in learned]
            sig = (round(g, 1), round(gr, 1), round(gap, 1),
                   f"signal_from_{sender_id}")
            self.concept_graph.update(sig, np.array([g, gr, gap, ed]))
            self._log_event("morse_concept_formed",
                            concept=str(sig)[:60], cluster=cid,
                            learned_norm=round(float(np.linalg.norm(learned)), 3))

    self._log_event("morse_handled", sender=sender_id, cluster=cid,
                    raw_len=len(raw_signal.replace(' ', '')))


# ============================================================
# СЛОЙ МОРЗЕ-РЕЧИ — подкласс над Pattern (без подмены методов у готового класса)
# Базовое поведение зовётся через super(). Повторный запуск ячейки безопасен.
# ============================================================
if "extend_class" not in globals():
    raise RuntimeError("Нет extend_class: сначала выполни ячейку Cell 3f (Substates Engine).")


class MorseMixin:
    _morse_init = _morse_init_patch
    _morse_set_field = _morse_set_field
    _morse_reset = _morse_reset_patch
    _morse_flush_diag = _morse_flush_diag
    _get_center_cell = _get_center_cell
    _send_morse = _send_morse
    _process_morse_queue = _process_morse_queue
    _listen_morse = _listen_morse
    _handle_morse_message = _handle_morse_message

    def __init__(self, pid, cells, parent=None, world=None):
        super().__init__(pid, cells, parent, world)
        self._morse_init()
        _lang_gene_init(self, parent=parent)
        if world and hasattr(world, 'morse_field'):
            self._morse_set_field(world.morse_field)

    def should_die(self):
        if super().should_die():
            self._morse_reset()
            return True
        return False

    def update_model(self, field, lineage_counts=None, given_counter=None, t=None, witness=None):
        if Config.ENABLE_MORSE_COMMUNICATION:
            self._process_morse_queue(field, t if t is not None else 0)
            self._listen_morse(field, t if t is not None else 0)
        return super().update_model(field, lineage_counts, given_counter, t, witness)

    def generate_goals(self, field):
        super().generate_goals(field)
        if (Config.ENABLE_MORSE_COMMUNICATION and self.alive and self.intent
                and self.intent.get('type') in ('seek_help', 'cooperate')):
            if phi_hash(self.id, self.age, 8888) < Config.MORSE_SEND_PROB:
                self._send_morse(None, field)

    # Загрузка из сохранения (deserialize_pattern) создаёт агента через Pattern(...),
    # поэтому __init__ выше уже вызывает _morse_init и подключает поле Морзе.
    # Отдельная обёртка над deserialize_pattern не нужна: она и раньше не срабатывала
    # (функция определяется в Cell 17, позже этой ячейки).


Pattern = extend_class(Pattern, MorseMixin)


print("✅ Cell 13 v4.5: мягкий декодер, NAV_RADIUS=6, SEND_COOLDOWN=40.")
