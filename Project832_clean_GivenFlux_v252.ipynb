        _prev = f"{DIR}/rich_log_{_tag}.json.prev"
        if not os.path.exists(_log):
            print(f"[skip] {_tag}: нет {_log}")
            continue
        run_master(_log, _led if os.path.exists(_led) else None, _prev if os.path.exists(_prev) else None)

print("✅ Master Observatory v0.1.9 (с [N] СИГНАЛ v3.0) загружена.")
