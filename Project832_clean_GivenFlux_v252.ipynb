class ImprintStats:
    CASES = ("match", "conflict", "overload", "prior", "quiet")
    BINS = ("repel", "neutral", "attract")
    RGROUPS = ("closing", "neutral", "opening")
    RECEPT_LO = 0.9
    RECEPT_HI = 1.1
    SAMEB_MIN_DIFF = 0.2
    STEER_BIN = 0.05
    MAX_STEP = 2.5

    def __init__(self):
        self.ticks = 0
        self.contacts = 0
        self.case = {c: 0 for c in self.CASES}
        self.case_strain = {c: 0.0 for c in self.CASES}
        self.pairs = set()
        self.tick = self.blank_tick()
        self.prev_center = {}
        self.prev_pair = {}

    @classmethod
    def blank_tick(cls):
        return {"contacts": 0,
                "case": {c: 0 for c in cls.CASES},
                "case_strain": {c: 0.0 for c in cls.CASES},
                "strain_sum": 0.0, "new_imprints": 0, "repeat": 0,
                "repeat_known": 0.0, "repeat_stranger": 0.0, "repeat_differs": 0,
                "recept": {g: {"n": 0, "rec": 0.0, "dgrav": 0.0, "dgrav2": 0.0, "dres": 0.0, "ddanger": 0.0, "strain": 0.0}
                           for g in cls.RGROUPS},
                "sameB": {"n_b": 0, "diff": 0.0, "diff2": 0.0},
                "pairs": [],
                "steer": {b: {"n": 0, "moved": 0, "toward": 0, "proj": 0.0, "proj2": 0.0} for b in cls.BINS}}

    def begin_tick(self):
        self.ticks += 1
        self.tick = self.blank_tick()

    def record(self, aid, bid, res, conf, over, prior, s, s_stranger, repeat, rec, dg, dr, dd):
        top = max(res, conf, over, prior)
        if top < 0.01:
            c = "quiet"
        elif prior >= max(res, conf, over):
            c = "prior"
        elif res >= max(conf, over):
            c = "match"
        elif over >= conf:
            c = "overload"
        else:
            c = "conflict"
        self.contacts += 1
        self.pairs.add((aid, bid))
        self.case[c] += 1
        self.case_strain[c] += s
        tk = self.tick
        tk["contacts"] += 1
        tk["case"][c] += 1
        tk["case_strain"][c] += s
        tk["strain_sum"] += s
        if repeat:
            tk["repeat"] += 1
            tk["repeat_known"] += s
            tk["repeat_stranger"] += s_stranger
            if abs(s - s_stranger) > 0.01:
                tk["repeat_differs"] += 1
        else:
            tk["new_imprints"] += 1
        grp = "closing" if rec < self.RECEPT_LO else ("opening" if rec > self.RECEPT_HI else "neutral")
        rg = tk["recept"][grp]
        rg["n"] += 1
        rg["rec"] += rec
        rg["dgrav"] += dg
        rg["dgrav2"] += dg * dg
        rg["dres"] += dr
        rg["ddanger"] += dd
        rg["strain"] += s
        if aid < bid:
            tk["pairs"].append([aid, bid])

    def record_same_b(self, by_b):
        sb = self.tick["sameB"]
        for bid in sorted(by_b):
            lst = by_b[bid]
            if len(lst) < 2:
                continue
            hi = max(lst, key=lambda x: (x[0], x[2]))
            lo = min(lst, key=lambda x: (x[0], x[2]))
            if hi[0] - lo[0] < self.SAMEB_MIN_DIFF:
                continue
            d = hi[1] - lo[1]
            sb["n_b"] += 1
            sb["diff"] += d
            sb["diff2"] += d * d

    @classmethod
    def steer_bin(cls, g):
        if g > cls.STEER_BIN:
            return "attract"
        if g < -cls.STEER_BIN:
            return "repel"
        return "neutral"

    def track_steering(self, patterns, ws, pull_range):
        cent = {p.id: p.get_center() for p in patterns if p.cells}
        st = self.tick["steer"]
        for (aid, bid), (g, dx, dy) in self.prev_pair.items():
            a0 = self.prev_center.get(aid)
            a1 = cent.get(aid)
            if a0 is None or a1 is None:
                continue
            mx = (a1[0] - a0[0] + ws / 2) % ws - ws / 2
            my = (a1[1] - a0[1] + ws / 2) % ws - ws / 2
            m = float(np.hypot(mx, my))
            if m > self.MAX_STEP:
                continue
            row = st[self.steer_bin(g)]
            row["n"] += 1
            if m > 1e-9:
                pr = float((mx * dx + my * dy) / np.hypot(dx, dy))
                row["moved"] += 1
                row["proj"] += pr
                row["proj2"] += pr * pr
                if pr > 1e-9:
                    row["toward"] += 1
        self.prev_center = cent
        self.prev_pair = {}
        for p in patterns:
            if p.id not in cent:
                continue
            ac = cent[p.id]
            for bid, imp in p.imprints.by_other.items():
                bc = cent.get(bid)
                if bc is None:
                    continue
                dx = (bc[0] - ac[0] + ws / 2) % ws - ws / 2
                dy = (bc[1] - ac[1] + ws / 2) % ws - ws / 2
                d = float(np.hypot(dx, dy))
                if d < 1e-6 or d > pull_range:
                    continue
                self.prev_pair[(p.id, bid)] = (imp.gravity, dx, dy)


