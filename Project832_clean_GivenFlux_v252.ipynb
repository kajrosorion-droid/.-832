                                ]
                            )
                        ) / _tn
                        if _tn > 0
                        else float("nan")
                    )
                else:
                    _crisis = _nbr = _nbrN = float("nan")
                    _feral_near = _bind_loc = float("nan")

                self.agent_snaps.append({
                    "t": int(t),
                    "id": int(p.id),
                    "age": int(p.age),
                    "gene": (
                        [float(x) for x in g]
                        if g is not None else None
                    ),
                    "nci": round(
