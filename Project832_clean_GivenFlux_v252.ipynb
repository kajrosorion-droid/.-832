class PhenomenalReportGenerator:
    @classmethod
    def generate(cls, pattern) -> tuple:
        # Читает уже существующие буферы агента и описывает тренд.
        # _gap_history / _soul_history пишет _apply_periodic_blindness (каждый тик),
        # _self_narrative пишет _post_semantic_step и _introspect_base.
        gap_hist = list(getattr(pattern, '_gap_history', []) or [])
        soul_hist = list(getattr(pattern, '_soul_history', []) or [])
        narrative = list(getattr(pattern, '_self_narrative', []) or [])

        gap_now = gap_hist[-1] if gap_hist else float(getattr(pattern, 'spirit_gap', 0.0))
        soul_now = soul_hist[-1] if soul_hist else float(getattr(pattern, 'soul_weight', 0.5))
        gap_old = gap_hist[-20] if len(gap_hist) >= 20 else gap_now
        soul_old = soul_hist[-20] if len(soul_hist) >= 20 else soul_now

        d_gap = gap_now - gap_old
        d_soul = soul_now - soul_old

        # сколько записей нарратива попало в последние 30 шагов
        recent = narrative[-30:]
        n_bind = sum(1 for e in recent if isinstance(e, dict) and e.get('type') == 'binding')

        # направление
        if d_soul > 0.03 and d_gap < -0.03:
            direction = "собирается"
        elif d_soul < -0.03 and d_gap > 0.03:
            direction = "распадается"
        elif abs(d_gap) < 0.02 and abs(d_soul) < 0.02:
            direction = "стоит на месте"
        else:
            direction = "движется"

        # короткая приписка с текущим state
        state = getattr(pattern, 'semantic_state', 'neutral')
        extra = f" [{state}]" if state and state != 'neutral' else ""

        report = (f"{direction}{extra}: soul {soul_old:.2f}→{soul_now:.2f}, "
                  f"gap {gap_old:.2f}→{gap_now:.2f}, "
                  f"{n_bind} замеров за последние 30 шагов")

        # binding из производной: собирается → выше, распадается → ниже
        binding = float(np.clip(0.5 + 0.5 * (d_soul - d_gap) * 5.0, 0.0, 1.0))
        return report, binding


