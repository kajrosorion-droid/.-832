        ):
            lst = getattr(self, name)
            if len(lst) > RECORD_CAP:
                setattr(
                    self,
                    name,
                    lst[-RECORD_CAP:]
                )

    def save(self, path):
        tmp = path + ".tmp"
        with open(
            tmp,
            "w",
            encoding="utf-8"
        ) as f:
            json.dump(
                {
                    "header": self.header,
                    "tick_rows": self.tick_rows,
                    "agent_snaps": self.agent_snaps,
                    "events": self.events,
                    "dialogues": self.dialogues,
                    "speaks": self.speaks,
                    "cluster_births": self.cluster_births,
                    "errors": dict(self.errors),
                },
                f,
                ensure_ascii=False
            )
        os.replace(tmp, path)

    @classmethod
    def load(cls, path):
        with open(
            path,
            "r",
            encoding="utf-8"
        ) as f:
            d = json.load(f)
        o = cls()
        for k in (
            "header",
            "tick_rows",
            "agent_snaps",
            "events",
            "dialogues",
            "speaks",
            "cluster_births",
        ):
            setattr(o, k, d[k])
        o.errors = Counter(
            d.get("errors", {})
        )
        return o


class RichEngine(LedgerEngine):
    rich = None

    def step(self, t):
        log = self.rich
        if log is not None:
            try:
                log.before_step(self)
            except Exception as e:
                log.errors[
                    f"before:{type(e).__name__}: {e}"[:160]
                ] += 1
        result = super().step(t)
        if log is not None:
            try:
                log.after_step(self, t)
            except Exception as e:
                log.errors[
                    f"after:{type(e).__name__}: {e}"[:160]
                ] += 1
                if t == 30:
                    raise RuntimeError(
                        "Rich log упал на t=30: "
                        + str(dict(log.errors))
                    )
            if (
                log.autosave_path
                and (t + 1) % SAVE_EVERY == 0
            ):
                log.header["complete"] = False
                log.save(log.autosave_path)
        return result


def _run_rich(
    seed,
    steps,
    mult,
    ledger_path,
    rich_path,
    extra_overrides=None,
    verbose=False
):
    ledger = ExperimentLedger(window=100)
    ledger.autosave_path = ledger_path
    ledger.autosave_every = 100

    log = RichLog()
    log.autosave_path = rich_path

    log.header = {
        "seed": int(seed),
        "steps": int(steps),
        "mult": float(mult),
        "empathy_pull_override": EMPATHY_PULL_OVERRIDE,
        "neighbor_sync_override": NEIGHBOR_SYNC_OVERRIDE,
    }

    RichEngine.rich = log

    t0 = time.time()

    try:
        _ov = {
            "PROTECTED_DEATH_PROB_MULT": mult
        }
        if EMPATHY_PULL_OVERRIDE is not None:
            _ov["LEXICON_EMPATHY_PULL"] = (
                EMPATHY_PULL_OVERRIDE
            )
        if NEIGHBOR_SYNC_OVERRIDE is not None:
            _ov["NEIGHBOR_SYNC_NORMALIZED"] = (
                NEIGHBOR_SYNC_OVERRIDE
            )
        if extra_overrides:
            _ov.update(extra_overrides)
        _execute(
            seed,
            steps,
            _ov,
            RichEngine,
            ledger,
            bool(verbose)
        )
        ledger.header["complete"] = True
        log.header["complete"] = True
    finally:
        RichEngine.rich = None
        log.header["wall_seconds"] = round(
            time.time() - t0,
            1
        )
        if ledger.rows:
            ledger.save(ledger_path)
        if log.tick_rows:
            log.save(rich_path)

    return ledger, log


