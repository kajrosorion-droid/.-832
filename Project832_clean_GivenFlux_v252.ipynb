    print("  прогон с наблюдателем #2: готов")
    same_final = fp_plain == fp_led1
    cmp12 = compare_ledgers(led1, led2)
    print(f"\nфинальное состояние: без наблюдателя vs с наблюдателем -> {'СОВПАДАЕТ' if same_final else 'РАЗЛИЧАЕТСЯ'}")
    if not same_final:
