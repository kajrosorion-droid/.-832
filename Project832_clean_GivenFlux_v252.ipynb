        ('dissipation', 'Диссипация (метаболизм, цена действий, крик): объявленная стоимость'),
        ('x2_reset', 'Обнуление запаса X2 (collapse_reset; судьба энергии не установлена)'),
        ('field_physics', 'Физика поля (гравитация, шум Given-seed, остаток field_dynamics)'),
        ('regulators', 'Регуляторы и клипы'),
        ('x2_overwrite', 'Перезапись энергии X2 средним по полю (рождение/деление; путь не установлен)'),
        ('events', 'События (эхо, спасение, спавн, святилище, кожа)'),
        ('internal_x1', 'Перестройка внутри X1 (должна быть ≈ 0)'),
