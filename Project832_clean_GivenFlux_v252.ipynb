        SELF_ERROR_MAX = 0.20; SPIRIT_GAP_MIN = 0.10; MIN_VARIANCE = 0.015; STABILITY_MAX = 0.97
        FERAL_SURPRISE_REQUIRED = 3
        for p in self.patterns:
