# Cell 6b — RichLog / RichEngine / _run_rich
# X2-AUDIT D: after_step добавляет E_field/E_inv/E_total в каждый tick_row,
#             пишет header['energy_snapshot'] (без обрезки top-N) каждые SNAPSHOT_EVERY тиков.

import os
import json
import time
from collections import Counter
import numpy as np

SNAPSHOT_EVERY = 10
SAVE_EVERY = 100
RECORD_CAP = 400_000

_RX_KEYS = (
    "attempted", "detected", "decoded", "corrupted",
    "uncertain", "collision", "timeout", "false_positive"
)


class RichLog:
    def __init__(self):
        self.header = {}
        self.tick_rows = []
        self.events = []
        self.dialogues = []
        self.speaks = []
        self.cluster_births = []
        self.agent_snaps = []

        self._rx_prev = {}
        self._rx_cum = Counter()
        self._pre_state = {}
        self._dlg_refs = {}
        self._spk_refs = {}
        self._dlg_seen = set()
        self._spk_seen = set()
        self._n_clusters_prev = 0
        self._dlg_total = 0
        self._spk_total = 0

        self.errors = Counter()
        self.autosave_path = None

    @staticmethod
    def _state_of(p):
        return {
            "intent": (p.intent.get("type") if p.intent else None),
            "state": str(p.semantic_state),
            "substate": getattr(p, "_substate", None),
            "soul": round(float(p.soul_weight), 4),
            "nci": round(float(getattr(p, "_nci", 0.0)), 4),
            "gap": round(float(getattr(p, "spirit_gap", 0.0)), 4),
            "grief": round(float(p.emotional_memory.get("grief", 0.0)), 4),
            "grat": round(float(p.emotional_memory.get("gratitude", 0.0)), 4),
            "trust_n": len(p.trust_ledger.entries),
            "dlg_n": len(getattr(p, "dialogue_longterm", []) or []),
            "spk_n": len(getattr(p, "spoken_lexicon", []) or []),
            "role": str(p.role_type),
            "shield": float(p.protection_level),
            "narrative": bool(getattr(p, "_narrative_agent", False)),
        }

    @staticmethod
    def _trust_diff(prev, now, limit=10):
        out = []
        for k in set(prev.keys()) | set(now.keys()):
            a = prev.get(k)
            b = now.get(k)
            if a != b and b is not None:
                out.append((
                    int(k),
                    a,
                    float(b),
                    float(b) - float(a if a is not None else 0)
                ))
        out.sort(key=lambda x: -abs(x[3]))
        return out[:limit]

    @staticmethod
    def _speaker_state(p):
        return {
            "uc": round(float(p.unresolved_contradiction), 4),
            "gap": round(float(getattr(p, "spirit_gap", 0.0)), 4),
            "drag": round(float(getattr(p, "somatic_drag", 1.0)), 4),
            "grief": round(float(p.emotional_memory.get("grief", 0.0)), 4),
            "grat": round(float(p.emotional_memory.get("gratitude", 0.0)), 4),
            "soul": round(float(p.soul_weight), 4),
            "intent": (p.intent.get("type") if p.intent else None),
            "role": str(p.role_type),
        }

    def _record_dialogues(self, p):
        cur = list(getattr(p, "dialogue_longterm", None) or [])
        if p.id not in self._dlg_refs:
            self._dlg_refs[p.id] = cur
            return
        seen = {id(e) for e in self._dlg_refs[p.id]}
        new = [e for e in cur if id(e) not in seen]
        for e in new:
            if not isinstance(e, dict):
                continue
            t = e.get("t")
            partner = e.get("partner")
            text = e.get("text", "")
            key = (
                int(p.id),
                t,
                partner,
                str(text)[:40],
            )
            if key in self._dlg_seen:
                continue
            self._dlg_seen.add(key)
            self.dialogues.append({
                "pid": int(p.id),
                "age": int(p.age),
                "t": t,
                "partner": partner,
                "text": str(text)[:200],
                "soul": e.get("soul_at_moment"),
                "grief": e.get("grief_at_moment"),
                "grat": e.get("grat_at_moment"),
            })
            self._dlg_total += 1
            self.events.append({
                "type": "dialogue",
                "t": t,
                "pid": int(p.id),
                "partner": partner,
                "text": str(text)[:120],
            })
        self._dlg_refs[p.id] = cur

    def _record_speaks(self, p):
        cur = list(getattr(p, "spoken_lexicon", None) or [])
        if p.id not in self._spk_refs:
            self._spk_refs[p.id] = cur
            return
        seen = {id(e) for e in self._spk_refs[p.id]}
        new = [e for e in cur if id(e) not in seen]
        for e in new:
            if not isinstance(e, dict):
                continue
            utt = e.get("utterance")
            if isinstance(utt, tuple):
                utt = list(utt)
            t = e.get("t")
            to = e.get("to")
            key = (
                int(p.id),
                t,
                tuple(utt) if isinstance(utt, list) else None,
            )
            if key in self._spk_seen:
                continue
            self._spk_seen.add(key)
            self.speaks.append({
                "pid": int(p.id),
                "age": int(p.age),
                "t": t,
                "to": to,
                "utt": utt,
                "st": self._speaker_state(p),
            })
            self._spk_total += 1
            self.events.append({
                "type": "speak",
                "t": int(t) if t is not None else t,
                "pid": int(p.id),
                "to": to,
                "utt": utt,
            })
        self._spk_refs[p.id] = cur

    def before_step(self, eng):
        snap = {}
        for p in eng.patterns:
            if not p.alive:
                continue
            st = self._state_of(p)
            st["_trust_snap"] = dict(p.trust_ledger.entries)
            snap[p.id] = st
        self._pre_state = snap

    def after_step(self, eng, t):
        lex = getattr(eng, "EMERGENT_LEXICON", None)
        if lex is None:
            self.errors["EMERGENT_LEXICON отсутствует"] += 1
            return

        alive = [p for p in eng.patterns if p.alive]
        alive_ids = {p.id for p in alive}

        for p in alive:
            prev = self._pre_state.get(p.id)
            now = self._state_of(p)
            if prev is not None:
                changed = {
                    k: (prev[k], now[k])
                    for k in now
                    if prev[k] != now[k]
                }
                if changed:
                    self.events.append({
                        "type": "state_change",
                        "t": int(t),
                        "pid": int(p.id),
                        "changes": {
                            k: {
                                "from": v[0],
                                "to": v[1]
                            }
                            for k, v in changed.items()
                        },
                    })
                td = self._trust_diff(
                    prev.get("_trust_snap", {}),
                    dict(p.trust_ledger.entries)
                )
                if td:
                    self.events.append({
                        "type": "trust_change",
                        "t": int(t),
                        "pid": int(p.id),
                        "deltas": td,
                    })
            self._record_dialogues(p)
            self._record_speaks(p)

        for store in (
            self._dlg_refs,
            self._spk_refs,
            self._rx_prev,
            self._pre_state,
        ):
            for pid in [
                k for k in list(store)
                if k not in alive_ids
            ]:
                del store[pid]

        n_cl = len(lex.clusters)

        for cid in range(self._n_clusters_prev, n_cl):
            m = lex.cluster_meanings.get(cid)
            self.cluster_births.append({
                "t": int(t),
                "cid": int(cid),
                "mean": (
                    [float(x) for x in m]
                    if m is not None else None
                ),
                "first_senders": {
                    str(k): int(v)
                    for k, v in
                    lex.cluster_senders.get(cid, {}).items()
                },
                "raw": lex.clusters[cid],
            })
            self.events.append({
                "type": "cluster_birth",
                "t": int(t),
                "cid": int(cid),
                "raw": lex.clusters[cid],
                "first_senders": list(
                    lex.cluster_senders.get(cid, {}).keys()
                ),
            })

        self._n_clusters_prev = max(
            self._n_clusters_prev,
            n_cl
        )

        for p in alive:
            r = getattr(p, "_morse_rx", None)
            m = getattr(r, "metrics", None) if r is not None else None
            if not m:
                continue
            prev = self._rx_prev.get(p.id, {})
            for k in _RX_KEYS:
                v = int(m.get(k, 0))
                inc = max(0, v - prev.get(k, 0))
                if inc:
                    self._rx_cum[k] += inc
                    if k in (
                        "decoded",
                        "corrupted",
                        "uncertain",
                    ):
                        self.events.append({
                            "type": f"rx_{k}",
                            "t": int(t),
                            "pid": int(p.id),
                            "inc": inc,
                        })
            self._rx_prev[p.id] = {
                k: int(m.get(k, 0))
                for k in _RX_KEYS
            }

        if t % SNAPSHOT_EVERY == 0:
            genes = [
                p._lang_gene
                for p in alive
                if getattr(p, "_lang_gene", None) is not None
            ]
            if len(genes) >= 2:
                arr = np.stack(genes)
                gd = float(np.mean(np.std(arr, axis=0)))
                gm = float(np.mean(arr))
            else:
                gd = gm = 0.0
            fid = list(lex.fidelity_log)[-200:]
            self.tick_rows.append({
                "t": int(t),
                "n": len(alive),
                "n_clusters": n_cl,
                "cluster_uses": int(
                    sum(lex.cluster_uses.values())
                ),
                "rx_cum": dict(self._rx_cum),
                "reinf": int(lex.reinforcement_events),
                "gene_div": gd,
                "gene_mean": gm,
                "fidelity": (
                    float(np.mean(fid))
                    if fid else float("nan")
                ),
                "dlg_total": self._dlg_total,
                "spk_total": self._spk_total,
                "send_k": dict(lex.send_k_counts),
                "send_silence": dict(lex.send_silence),
                "send_energy": float(
                    lex.send_energy_spent
                ),
            })

            # ⚡ X2-AUDIT D: энергоснапшот (поле / инвентарь агентов / сумма)
            #   + сырой дамп ledger (src + x2) без обрезки.
            _alive_snap = [p for p in eng.patterns if p.alive]
