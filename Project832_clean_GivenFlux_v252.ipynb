# ============================================================
# Cell 6 -- ExperimentLedger v1.5 (ТОЛЬКО НАБЛЮДАЕТ)
# v1.5.1: функция _frac переименована в _ledger_frac. Одноимённая функция из Master Observatory
#         затирала её, и ExperimentLedger.windows() падал с TypeError (Cell 7). Логика не менялась.
# Ставится ПОСЛЕ Cell 4b (после того как определены EvolutionEngine, Config,
# CH, _CHORUS_STATE_PATH, _load_chorus_state, init_all_chronic_counters).
#
# v1.5: добавлен снимок входных файлов (input_fp) в header каждого прогона --
#   crc32+размер живого мира, архива, хора, ark-seed и eternal-subjects до и
#   после прогона. Нужен, чтобы при расхождении chain с более ранним ledger'ом
#   отличать "разошёлся код" от "разошёлся вход". Старые ledger-файлы читаются,
#   новых полей в них нет -- report() покажет n/a.
#
# Правило проекта: ячейка ничего не утверждает сама. Печатаются только числа,
# посчитанные из записанных данных этого прогона.
# ============================================================
import contextlib
import gc
import io
import json
import os
import shutil
import tempfile
import time
import zlib
from collections import Counter

import numpy as np

LEDGER_SCALARS = ("energy", "epistemic_scar", "soul_weight", "spirit_gap",
                  "coherence", "body_memory", "cognitive_tension", "pred_error")
LEDGER_FINAL_EXTRA = ("protection_level",)
PROTECTED_THRESHOLD = 0.2
_LEDGER_SCALAR_TYPES = (bool, int, float, str)


LEDGER_IMPRINT_EVERY = 10   # как часто писать снимок сети следов (траектории и контакты пишутся каждый тик)


def _agent_crc(p):
    row = []
    for name, value in vars(p).items():
        if isinstance(value, np.generic):
            value = value.item()
        if isinstance(value, _LEDGER_SCALAR_TYPES):
            row.append((name, value))
    return zlib.crc32(repr(row).encode("utf-8"))


def _cells_crc(p):
    return zlib.crc32(repr(sorted(p.cells)).encode("utf-8"))


def _birth_info(p):
    for rec in reversed(list(p.biography)):
        t = rec.get("type", "")
        if t.startswith("born_from_"):
            return t[len("born_from_"):], rec.get("parent_id")
    return "spawn", None


def _config_snapshot():
    return {k: getattr(Config, k) for k in dir(Config)
            if k.isupper() and isinstance(getattr(Config, k), (bool, int, float, str))}


def _state_fingerprint(eng):
    field_crc = zlib.crc32(np.ascontiguousarray(eng.field).tobytes())
    rng_pos = int(eng._given_rng.get_state()[2])
    agents = sorted((int(p.id), _agent_crc(p), _cells_crc(p)) for p in eng.patterns)
    return {"field": field_crc, "rng_pos": rng_pos, "n_agents": len(agents),
            "agents": zlib.crc32(repr(agents).encode("utf-8"))}


def _sig_in_edges(p):
    sig = (round(float(p.pred_error), 2), round(float(p.epistemic_load), 2),
           round(float(p.soul_weight), 2), p.semantic_state)
    return bool(p.concept_graph.edges.get(sig))


def _ledger_frac(rows, key):
    if not all(key in r for r in rows):
        return float("nan")
    vals = [r[key] / r["n"] for r in rows if r["n"]]
    return float(np.mean(vals)) if vals else float("nan")


def _imprint_sum(rows, key):
    """Сумма вложенных числовых словарей imprint-строк по ключу (например 'case')."""
    out = {}
    for r in rows:
        for k, v in r[key].items():
            if isinstance(v, dict):
                d = out.setdefault(k, {})
                for kk, vv in v.items():
                    d[kk] = d.get(kk, 0.0) + vv
            else:
                out[k] = out.get(k, 0.0) + v
    return out


def _imprint_window(ch):
    """Агрегат imprint-статистики по окну строк ledger. None, если блока в строках нет."""
    ims = [r["imprint"] for r in ch if r.get("imprint")]
    if not ims:
        return None
    n = len(ims)
    contacts = int(sum(i["contacts"] for i in ims))
    agents = float(np.mean([i["agents"] for i in ims]))
    return {
        "ticks": n,
        "contacts": contacts,
        "contacts_per_tick": contacts / n,
        "case": _imprint_sum(ims, "case"),
        "case_strain": _imprint_sum(ims, "case_strain"),
        "strain_per_contact": float(sum(i["strain_sum"] for i in ims)) / max(contacts, 1),
        "new": int(sum(i["new"] for i in ims)),
        "repeat": int(sum(i["repeat"] for i in ims)),
        "repeat_known": float(sum(i["repeat_known"] for i in ims)),
        "repeat_stranger": float(sum(i["repeat_stranger"] for i in ims)),
        "repeat_differs": int(sum(i["repeat_differs"] for i in ims)),
        "recept": _imprint_sum(ims, "recept"),
        "sameB": _imprint_sum(ims, "sameB"),
        "steer": _imprint_sum(ims, "steer"),
        "agents": agents,
        "agents_with_imprint": float(np.mean([i["agents_with_imprint"] for i in ims])),
        "imprints_end": int(ims[-1]["imprints"]),
        "strain_mean": float(np.mean([i["strain_mean"] for i in ims])),
        "strain_gt01_frac": float(np.mean([i["strain_gt01"] / max(i["agents"], 1) for i in ims])),
        "strain_at_max_frac": float(np.mean([i["strain_at_max"] / max(i["agents"], 1) for i in ims])),
        "freeze_mean": float(np.mean([i["freeze_mean"] for i in ims])),
    }


class ExperimentLedger:
    def __init__(self, window=100):
        self.window = int(window)
        self.header = {}
        self.rows = []
        self.events = []
        self.lifecycle = {}
        self._chain = 0
        self.autosave_path = None
        self.autosave_every = 500
        self._kills = {}

    def _new_record(self, p, birth_t, kind, parent):
        return {"id": int(p.id), "lineage_id": int(p.lineage_id), "birth_t": birth_t,
                "birth_kind": kind, "parent_id": parent, "death_t": None,
                "death_cause": None, "age_at_death": None, "final": None}

    def before(self, eng):
        snap = {}
        for p in eng.patterns:
            pid = int(p.id)
            if pid not in self.lifecycle:
                self.lifecycle[pid] = self._new_record(p, -1, "initial", None)
            snap[pid] = (p, str(p.semantic_state), str(p.role_type), dict(p.event_counts),
                         float(p.protection_level))
        self._hook_before = dict(eng._death_hook_calls)
        return snap

    def after(self, eng, t, pre):
        cur = {int(p.id): p for p in eng.patterns}
        ev = Counter()
        births = deaths = divisions = 0
        for pid, p in cur.items():
            if pid not in pre:
                kind, parent = _birth_info(p)
                self.lifecycle[pid] = self._new_record(p, t, kind, parent)
                births += 1
                if kind == "division":
                    divisions += 1
                self.events.append((t, pid, "birth", kind, parent))
                for k, v in p.event_counts.items():
                    ev[k] += v
        unlogged = []
        for pid, (p0, st0, role0, ec0, prot0) in pre.items():
            p = cur.get(pid)
            obj = p if p is not None else p0
            n_exec = obj.event_counts.get("feral_execution", 0) - ec0.get("feral_execution", 0)
            if n_exec > 0:
                found = 0
                for rec in reversed(list(obj.biography)):
                    if rec.get("type") == "feral_execution" and "victim" in rec:
                        self._kills[int(rec["victim"])] = (int(t), int(pid))
                        found += 1
                        if found >= n_exec:
                            break
            for k, v in obj.event_counts.items():
                d = v - ec0.get(k, 0)
                if d:
                    ev[k] += d
            if p is None:
                deaths += 1
                cause = ",".join(sorted(k for k, v in obj.event_counts.items()
                                        if k.startswith("death_") and v > ec0.get(k, 0)))
                rec = self.lifecycle[pid]
                rec["death_t"] = t
                rec["age_at_death"] = int(obj.age)
                rec["final"] = {n: float(getattr(obj, n)) for n in LEDGER_SCALARS}
                rec["final"]["protection_level"] = float(obj.protection_level)
                rec["final"]["gene_metabolic_cost"] = float(obj.genome.get("metabolic_cost", float("nan")))
                rec["protection_before_tick"] = prot0
                rec["was_subject"] = bool(obj._subject_detected)
                rec["was_narrative"] = bool(obj._narrative_agent)
                rec["imprint_final"] = imprint_agent_summary(obj)
                if cause:
                    rec["death_cause"] = cause
                    self.events.append((t, pid, "death", cause, None))
                elif pid in self._kills:
                    kt, killer = self._kills[pid]
                    rec["death_cause"] = "feral_execution_victim"
                    rec["killed_by"] = killer
                    self.events.append((t, pid, "death", "feral_execution_victim", killer))
                else:
                    unlogged.append(pid)
            else:
                st1, role1 = str(p.semantic_state), str(p.role_type)
                if st1 != st0:
                    self.events.append((t, pid, "state_change", st0, st1))
                if role1 != role0:
                    self.events.append((t, pid, "role_change", role0, role1))
        if unlogged:
            hook = {k: v - self._hook_before.get(k, 0) for k, v in eng._death_hook_calls.items()}
            cands = {k: v for k, v in hook.items() if v and k != "natural_death"}
            label = "unlogged:ambiguous"
            if len(cands) == 1 and sum(cands.values()) == len(unlogged):
                label = "unlogged:" + next(iter(cands))
            elif not cands:
                label = "unlogged:no_hook"
            for pid in unlogged:
                self.lifecycle[pid]["death_cause"] = label
                self.events.append((t, pid, "death", label, None))
        alive = list(cur.values())
        row = {"t": int(t), "n": len(alive), "births": births, "deaths": deaths,
               "divisions": divisions, "cells": int(sum(len(p.cells) for p in alive)),
               "field_energy": float(np.sum(eng.field[:, :, CH["energy"]])),
               "gene_mc_neg": int(sum(1 for p in alive if p.genome.get("metabolic_cost", 0.0) < 0)),
               "gene_mob_neg": int(sum(1 for p in alive if p.genome.get("mobility", 0.0) < 0)),
               "gene_mc_mean": (float(np.mean([p.genome.get("metabolic_cost", np.nan) for p in alive]))
                                if alive else float("nan")),
               "meta_pos": int(sum(1 for p in alive if p._meta_surprise > 0)),
               "meta_mean": (float(np.mean([p._meta_surprise for p in alive])) if alive else float("nan")),
               "cns_hi": int(sum(1 for p in alive if p._concept_narrative_score > 0.55)),
               "sig_hit": int(sum(1 for p in alive if p.role_type != "disorganizer"
                                  and p._concept_narrative_score > 0.55 and _sig_in_edges(p))),
               "protected": int(sum(1 for p in alive if p.protection_level > PROTECTED_THRESHOLD)),
               "subjects": int(sum(1 for p in alive if p._subject_detected)),
               "narrative": int(sum(1 for p in alive if p._narrative_agent)),
               "ev": dict(ev)}
        for name in LEDGER_SCALARS:
            row[name] = float(np.mean([getattr(p, name) for p in alive])) if alive else float("nan")
        row["imprint"] = eng.imprint_tick_row()
        row["imprint_contacts"] = eng.imprint_tick_contacts()
        row["imprint_track"] = eng.imprint_track_row()
        if t % LEDGER_IMPRINT_EVERY == 0:
            row["imprint_net"] = eng.imprint_summary(t)
        field_crc = zlib.crc32(np.ascontiguousarray(eng.field).tobytes())
        rng_pos = int(eng._given_rng.get_state()[2])
        agents_crc = zlib.crc32(repr(sorted((pid, _agent_crc(p), _cells_crc(p))
                                            for pid, p in cur.items())).encode("utf-8"))
        self._chain = zlib.crc32(repr((self._chain, t, field_crc, rng_pos, agents_crc)).encode("utf-8"))
        row["chain"] = self._chain
        self.rows.append(row)

    def windows(self, size=None):
        size = int(size or self.window)
        out = []
        for i in range(0, len(self.rows), size):
            ch = self.rows[i:i + size]
            evs = Counter()
            for r in ch:
                evs.update(r["ev"])
            w = {"t0": ch[0]["t"], "t1": ch[-1]["t"], "ticks": len(ch),
                 "n_mean": float(np.mean([r["n"] for r in ch])),
                 "births": sum(r["births"] for r in ch),
                 "deaths": sum(r["deaths"] for r in ch),
                 "divisions": sum(r["divisions"] for r in ch), "events": dict(evs),
                 "protected_frac": float(np.mean([r["protected"] / r["n"] for r in ch if r["n"]]))
                 if any(r["n"] for r in ch) else float("nan"),
                 "mc_neg_frac": _ledger_frac(ch, "gene_mc_neg"), "mob_neg_frac": _ledger_frac(ch, "gene_mob_neg"),
                 "meta_pos_frac": _ledger_frac(ch, "meta_pos"), "cns_hi_frac": _ledger_frac(ch, "cns_hi"),
                 "sig_hit_frac": _ledger_frac(ch, "sig_hit"),
                 "meta_mean": (float(np.nanmean([r["meta_mean"] for r in ch]))
                               if all("meta_mean" in r for r in ch) else float("nan")),
                 "mc_mean": (float(np.nanmean([r["gene_mc_mean"] for r in ch]))
                             if all("gene_mc_mean" in r for r in ch) else float("nan")),
                 "subjects_mean": float(np.mean([r["subjects"] for r in ch])),
                 "narrative_mean": float(np.mean([r["narrative"] for r in ch]))}
            for name in LEDGER_SCALARS:
                w[name] = float(np.nanmean([r[name] for r in ch]))
            w["imprint"] = _imprint_window(ch)
            out.append(w)
        return out

    def series(self, key):
        return np.array([r[key] for r in self.rows], dtype=float)

    def event_series(self, event_type):
        return np.array([r["ev"].get(event_type, 0) for r in self.rows], dtype=float)

    def report(self, max_windows=12):
        h = self.header
        print("=" * 70)
        print("EXPERIMENT LEDGER")
        print("=" * 70)
        print(f"given_seed={h.get('given_seed')}  steps_requested={h.get('steps')}  "
              f"ticks_observed={len(self.rows)}  config_hash={h.get('config_hash')}")
        if h.get("overrides"):
            print(f"overrides={h['overrides']}")
        if h.get("input_fp_before") is not None:
            print(f"input_fp_before={h['input_fp_before']}")
            print(f"input_fp_after ={h.get('input_fp_after')}")
        if not self.rows:
            print("(пусто)")
            return
        total_births = sum(r["births"] for r in self.rows)
        total_div = sum(r["divisions"] for r in self.rows)
        total_deaths = sum(r["deaths"] for r in self.rows)
        print(f"рождений={total_births} (из них делений={total_div})  смертей={total_deaths}  "
              f"агентов в конце={self.rows[-1]['n']}")
        causes = Counter(rec["death_cause"] for rec in self.lifecycle.values() if rec["death_t"] is not None)
        if causes:
            print("причины смерти:", dict(causes.most_common()))
        evt = Counter()
        for r in self.rows:
            evt.update(r["ev"])
        print("топ-10 событий (сумма за прогон):", dict(evt.most_common(10)))
        ev_kinds = Counter(e[2] for e in self.events)
        print("структурные записи:", dict(ev_kinds))
        ws = self.windows()
        if len(ws) > max_windows:
            idx = np.linspace(0, len(ws) - 1, max_windows).round().astype(int)
            ws = [ws[i] for i in sorted(set(idx))]
        print("\n   окно         n_mean  births deaths  div  energy  scar   soul   gap   coh  prot%  subj  narr  mc<0%  mc_mean")
        for w in ws:
            print(f"  {w['t0']:>5}-{w['t1']:<5} {w['n_mean']:>7.1f} {w['births']:>6} {w['deaths']:>6} "
                  f"{w['divisions']:>4}  {w['energy']:>6.3f} {w['epistemic_scar']:>5.3f} "
                  f"{w['soul_weight']:>5.3f} {w['spirit_gap']:>5.3f} {w['coherence']:>5.3f} "
                  f"{100 * w['protected_frac']:>5.1f} {w['subjects_mean']:>5.1f} {w['narrative_mean']:>5.1f} "
                  f"{100 * w['mc_neg_frac']:>6.1f} {w['mc_mean']:>8.4f}")
        print("\n   окно         _meta_surprise>0%  meta_mean   concept_score>0.55%   сигнатура найдена в edges%")
        for w in ws:
            print(f"  {w['t0']:>5}-{w['t1']:<5} {100 * w['meta_pos_frac']:>14.1f} {w['meta_mean']:>11.4f} "
                  f"{100 * w['cns_hi_frac']:>18.1f} {100 * w['sig_hit_frac']:>24.2f}")
        dead = [r for r in self.lifecycle.values() if r["death_t"] is not None]
        if dead:
            prot = [r for r in dead if r.get("protection_before_tick", 0.0) > PROTECTED_THRESHOLD]
            print(f"\nсмерти: защищённых на начало тика смерти = {len(prot)} из {len(dead)}")
            for title, grp in (("защищённые", prot), ("незащищённые", [r for r in dead if r not in prot])):
                if grp:
                    print(f"  {title}: " + str(dict(Counter(r['death_cause'] for r in grp).most_common())))
            print(f"  среди умерших: бывшие субъекты={sum(1 for r in dead if r.get('was_subject'))}, "
                  f"narrative-агенты={sum(1 for r in dead if r.get('was_narrative'))}")
        self._report_imprint()
        print(f"\nchain(last)={self.rows[-1]['chain']}  final_state={h.get('final_state')}")

    def _report_imprint(self, max_windows=12):
        """Блок отчёта: след встречи A -> B (подробный вариант смотри в Master Observatory, секция L)."""
        ws = [w for w in self.windows() if w.get("imprint")]
        if not ws:
            return
        cfg = self.header.get("imprint_config") or {}
        print("\n" + "=" * 70)
        print("IMPRINT: след встречи A -> B")
        print("=" * 70)
        if cfg:
            print("конфиг:", {k.replace("IMPRINT_", ""): v for k, v in sorted(cfg.items())})
        if len(ws) > max_windows:
            idx = np.linspace(0, len(ws) - 1, max_windows).round().astype(int)
            ws = [ws[i] for i in sorted(set(idx))]
        print("\n   окно        конт/тик match% conf% over% prior% quiet%  strain/к  новых повтор%  Δстрейн(знак-чужой)  "
              "imprints  агентов_со_следом")
        for w in ws:
            im = w["imprint"]
            c = max(im["contacts"], 1)
            cs = im["case"]
            rep = im["repeat"]
            dk = (im["repeat_known"] - im["repeat_stranger"]) / max(rep, 1)
            print(f"  {w['t0']:>5}-{w['t1']:<5} {im['contacts_per_tick']:>7.1f} {100 * cs['match'] / c:>6.1f} "
                  f"{100 * cs['conflict'] / c:>5.1f} {100 * cs['overload'] / c:>5.1f} {100 * cs['prior'] / c:>6.1f} "
                  f"{100 * cs['quiet'] / c:>6.1f} {im['strain_per_contact']:>9.4f} {im['new']:>6} "
                  f"{100 * rep / c:>7.1f} {dk:>+19.4f} {im['imprints_end']:>9} {im['agents_with_imprint']:>12.1f}")
        print("\n   окно        strain_mean  strain>0.1%  на_потолке%  freeze  | мембрана: n(closing/neutral/opening) "
              "Δgrav(closing/neutral/opening)")
        for w in ws:
            im = w["imprint"]
            rg = im["recept"]
            ns = [int(rg[g]["n"]) for g in ("closing", "neutral", "opening")]
            dg = [rg[g]["dgrav"] / max(rg[g]["n"], 1) for g in ("closing", "neutral", "opening")]
            print(f"  {w['t0']:>5}-{w['t1']:<5} {im['strain_mean']:>11.4f} {100 * im['strain_gt01_frac']:>11.1f} "
                  f"{100 * im['strain_at_max_frac']:>11.1f} {im['freeze_mean']:>7.3f}  | "
                  f"{ns[0]:>6}/{ns[1]:>6}/{ns[2]:>6}   {dg[0]:>+8.5f}/{dg[1]:>+8.5f}/{dg[2]:>+8.5f}")
        tot = _imprint_window([r for r in self.rows])
        if tot:
            print("\nза весь прогон: случаи", {k: int(v) for k, v in tot["case"].items()},
                  "| strain/контакт по случаям",
                  {k: round(tot["case_strain"][k] / max(tot["case"][k], 1), 4) for k in tot["case"]})
            print("руление (по парам-тикам; toward = A сместился к B, если двигался):")
            for b in ("repel", "neutral", "attract"):
                st = tot["steer"][b]
                mv = max(st["moved"], 1)
                print(f"  {b:<8} n={int(st['n']):>7} двигался={100 * st['moved'] / max(st['n'], 1):>5.1f}% "
                      f"к B среди двигавшихся={100 * st['toward'] / mv:>5.1f}% средняя проекция={st['proj'] / mv:>+8.4f}")
            sb = tot["sameB"]
            if sb["n_b"]:
                md = sb["diff"] / sb["n_b"]
                print(f"один B / один тик / разные A: пар={int(sb['n_b'])}  средний Δgravity(самый открытый − самый закрытый)={md:+.5f}")
        dead = [r for r in self.lifecycle.values() if r.get("death_t") is not None and r.get("imprint_final")]
        if dead:
            by = {}
            for r in dead:
                by.setdefault(r["death_cause"], []).append(r["imprint_final"])
            print("\nсмерти и след (по причине): n, средн. число следов, средн. strain в момент смерти, средн. danger_max")
            for cause, lst in sorted(by.items(), key=lambda kv: -len(kv[1]))[:6]:
                print(f"  {str(cause):<28} n={len(lst):>3} следов={np.mean([x['n'] for x in lst]):>5.1f} "
                      f"strain={np.mean([x['strain'] for x in lst]):>6.3f} "
                      f"danger_max={np.mean([x.get('danger_max', 0.0) for x in lst]):>6.3f}")

    def lifecycle_matrix(self):
        names = ["age_at_death"] + list(LEDGER_SCALARS)
        ids, X = [], []
        for pid, rec in sorted(self.lifecycle.items()):
            if rec["death_t"] is None or rec["final"] is None:
                continue
            ids.append(pid)
            X.append([rec["age_at_death"]] + [rec["final"][n] for n in LEDGER_SCALARS])
        return np.array(X, dtype=float), ids, names

    def save(self, path):
        data = {"header": self.header, "rows": self.rows,
                "events": [list(e) for e in self.events],
                "lifecycle": list(self.lifecycle.values())}
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, path)

    @classmethod
    def load(cls, path):
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        led = cls()
        led.header, led.rows = data["header"], data["rows"]
        led.events = [tuple(e) for e in data["events"]]
        led.lifecycle = {rec["id"]: rec for rec in data["lifecycle"]}
        led._chain = led.rows[-1]["chain"] if led.rows else 0
        return led


class LedgerEngine(EvolutionEngine):
    ledger = None

    def step(self, t):
        led = self.ledger
        pre = led.before(self) if led is not None else None
        result = super().step(t)
        if led is not None:
            led.after(self, t, pre)
            if led.autosave_path and (t + 1) % led.autosave_every == 0:
                led.header["complete"] = False
                led.save(led.autosave_path)
        return result


def compare_ledgers(a, b):
    n = min(len(a.rows), len(b.rows))
    for i in range(n):
        if a.rows[i]["chain"] != b.rows[i]["chain"]:
            return {"identical": False, "first_divergence_t": a.rows[i]["t"], "ticks_compared": i + 1}
    return {"identical": len(a.rows) == len(b.rows), "first_divergence_t": None,
            "ticks_compared": n, "len_a": len(a.rows), "len_b": len(b.rows)}


ARCHIVE_DIR_LEDGER = "/content/drive/MyDrive/832_Archive"
LEDGER_GUARD_DIR = ARCHIVE_DIR_LEDGER.rstrip("/") + "_ledger_guard"
_LEDGER_EXTRA_FILES = [
    "/content/drive/MyDrive/832_eternal_subjects.json",
    "/content/drive/MyDrive/832_ark_seed_patterns.json",
    "832_ark_seed_patterns.json",
    "832_eternal_subjects.json",
]


def _input_fingerprint():
    """crc32+размер внешних файлов, из которых прогон читает старт. Только чтение.
    Нужен, чтобы при расхождении chain отличать "разошёлся код" от "разошёлся вход"."""
    fp = {}
    paths = [LIVING_WORLD_PATH, _CHORUS_STATE_PATH] + list(_LEDGER_EXTRA_FILES)
    for fpth in paths:
        if os.path.isfile(fpth):
            try:
                with open(fpth, "rb") as f:
                    b = f.read()
                fp[os.path.basename(fpth)] = [len(b), zlib.crc32(b)]
            except Exception as e:
                fp[os.path.basename(fpth)] = ["err", type(e).__name__]
    arch = ARCHIVE_DIR_LEDGER
    if os.path.isdir(arch):
        tot = 0
        crc = 0
        for root, _, files in sorted(os.walk(arch)):
            for fn in sorted(files):
                fpath = os.path.join(root, fn)
                try:
                    tot += os.path.getsize(fpath)
                    crc = zlib.crc32(f"{fn}:{os.path.getsize(fpath)}".encode(), crc)
                except Exception:
                    continue
        fp["archive_dir"] = [tot, crc]
    return fp


class _WorldGuard:
    def __init__(self, work=LEDGER_GUARD_DIR):
        self.work = work
        self.marker = os.path.join(work, "IN_PROGRESS")
        self.manifest_path = os.path.join(work, "manifest.json")

    def snapshot(self):
        if os.path.exists(self.marker):
            raise RuntimeError(
                f"Предыдущий прогон не завершился: исходное состояние лежит в {self.work}. "
                f"Верни его вызовом guard_recover() и повтори запуск.")
        shutil.rmtree(self.work, ignore_errors=True)
        os.makedirs(self.work)
        archive_root = os.path.abspath(ARCHIVE_DIR_LEDGER)
        man = {"had_world": os.path.exists(LIVING_WORLD_PATH),
               "had_archive": os.path.isdir(ARCHIVE_DIR_LEDGER), "extra": {}}
        if man["had_world"]:
            shutil.copy(LIVING_WORLD_PATH, os.path.join(self.work, "world"))
        if man["had_archive"]:
            shutil.copytree(ARCHIVE_DIR_LEDGER, os.path.join(self.work, "archive"))
        for i, fp in enumerate(_LEDGER_EXTRA_FILES + [_CHORUS_STATE_PATH]):
            if os.path.abspath(fp).startswith(archive_root + os.sep):
                continue
            if os.path.exists(fp):
                shutil.copy(fp, os.path.join(self.work, f"extra_{i}"))
                man["extra"][fp] = f"extra_{i}"
            else:
                man["extra"][fp] = None
        with open(self.manifest_path, "w", encoding="utf-8") as f:
            json.dump(man, f)
        with open(self.marker, "w") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S"))

    def restore(self):
        with open(self.manifest_path, "r", encoding="utf-8") as f:
            man = json.load(f)
        if man["had_world"]:
            shutil.copy(os.path.join(self.work, "world"), LIVING_WORLD_PATH)
        elif os.path.exists(LIVING_WORLD_PATH):
            os.remove(LIVING_WORLD_PATH)
        if man["had_archive"]:
            tmp = ARCHIVE_DIR_LEDGER.rstrip("/") + "_ledger_restore_tmp"
            shutil.rmtree(tmp, ignore_errors=True)
            shutil.copytree(os.path.join(self.work, "archive"), tmp)
            shutil.rmtree(ARCHIVE_DIR_LEDGER, ignore_errors=True)
            os.replace(tmp, ARCHIVE_DIR_LEDGER)
        else:
            shutil.rmtree(ARCHIVE_DIR_LEDGER, ignore_errors=True)
        for fp, name in man["extra"].items():
            if name is not None:
                shutil.copy(os.path.join(self.work, name), fp)
            elif os.path.exists(fp):
                os.remove(fp)
        globals()["_chorus_state"] = _load_chorus_state()

    def close(self):
        shutil.rmtree(self.work, ignore_errors=True)


def guard_recover():
    g = _WorldGuard()
    if not os.path.exists(g.marker):
        print("Незавершённых прогонов нет: восстанавливать нечего.")
        return False
    g.restore()
    g.close()
    print(f"Состояние восстановлено из {g.work}, снимок удалён.")
    return True


def _execute(seed, steps, overrides, engine_cls, ledger, verbose):
    overrides = dict(overrides or {})
    for name in overrides:
        if not hasattr(Config, name):
            raise AttributeError(f"Config не содержит параметра '{name}' (опечатка в overrides?)")
    saved = {name: getattr(Config, name) for name in list(overrides) + ["FORCE_GIVEN_SEED", "STEPS"]}
    guard = _WorldGuard()
    guard.snapshot()
    fp_before = _input_fingerprint()
    try:
        Config.FORCE_GIVEN_SEED, Config.STEPS = int(seed), int(steps)
        for name, value in overrides.items():
            setattr(Config, name, value)
        globals()["_chorus_state"] = _load_chorus_state()
        sink = io.StringIO()
        with (contextlib.nullcontext() if verbose else contextlib.redirect_stdout(sink)):
            eng = engine_cls()
            if ledger is not None:
                eng.ledger = ledger
                ledger.header = {"given_seed": int(eng.given_seed), "steps": int(steps),
                                 "overrides": overrides, "started": time.strftime("%Y-%m-%d %H:%M:%S"),
                                 "config_hash": zlib.crc32(repr(sorted(_config_snapshot().items())).encode("utf-8")),
                                 "input_fp_before": fp_before,
                                 "imprint_config": {k: v for k, v in vars(Config).items() if k.startswith("IMPRINT_")}}
            init_all_chronic_counters(eng)
            eng.run(force_fresh_seed=True)
        fp = _state_fingerprint(eng)
        if ledger is not None:
            ledger.header["final_state"] = fp
            ledger.header["input_fp_after"] = _input_fingerprint()
        del eng
        gc.collect()
        return fp
    finally:
        for name, value in saved.items():
            setattr(Config, name, value)
        guard.restore()
        guard.close()


def run_with_ledger(seed, steps, overrides=None, window=100, verbose=False,
                    save_path=None, save_every=500):
    ledger = ExperimentLedger(window=window)
    ledger.autosave_path, ledger.autosave_every = save_path, int(save_every)
    t0 = time.time()
    try:
        _execute(seed, steps, overrides, LedgerEngine, ledger, verbose)
        ledger.header["complete"] = True
    finally:
        ledger.header["wall_seconds"] = round(time.time() - t0, 1)
        if save_path and ledger.rows:
            ledger.save(save_path)
    return ledger


def check_observer_purity(steps=40, seed=118951255):
    print("=" * 70)
    print(f"ПРОВЕРКА НАБЛЮДАТЕЛЯ: {steps} тиков, given_seed={seed}")
    print("=" * 70)
    fp_plain = _execute(seed, steps, None, EvolutionEngine, None, False)
    print("  прогон без наблюдателя: готов")
    led1 = ExperimentLedger()
    fp_led1 = _execute(seed, steps, None, LedgerEngine, led1, False)
    print("  прогон с наблюдателем #1: готов")
    led2 = ExperimentLedger()
