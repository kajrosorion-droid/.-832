# ============================================================
# ЯЧЕЙКА: САМОРЕГУЛЯЦИЯ АГЕНТОВ v2.0 (ВСЕ 10 УРОВНЕЙ)
# Вставить ПОСЛЕ ячейки Морзе, ПЕРЕД Cell 4a
# ============================================================

import numpy as np
from collections import deque, defaultdict

# === КОНФИГИ ===
_sr_cfg = {
    'ENABLE_SELF_REGULATION': True,
    # Медитация
    'SR_MEDITATION_COOLDOWN': 80,
    'SR_MEDITATION_MIN_AGE': 30,
    'SR_MEDITATION_GRIEF_THR': 0.5,
    'SR_MEDITATION_GRIEF_RELIEF': 0.06,
    'SR_MEDITATION_TENSION_RELIEF': 0.08,
    # Целевая саморегуляция
    'SR_GOAL_PERF_WINDOW': 30,
    'SR_GOAL_REPLACE_MIN_AGE': 20,
    'SR_GOAL_PERF_FLOOR': -0.05,
    # Рефлексивные пороги
    'SR_THR_ADJUST_RATE': 0.005,
    'SR_GRIEF_THR_MIN': 0.2, 'SR_GRIEF_THR_MAX': 0.9,
    'SR_ALARM_THR_MIN': 0.2, 'SR_ALARM_THR_MAX': 0.8,
    # Голосование
    'SR_VOTE_INTERVAL': 100,
    'SR_VOTE_THRESHOLD': 0.6,
    'SR_VOTE_QUORUM': 5,
    # Нормотворчество
    'SR_NORM_MIN_REPS': 5,
    'SR_NORM_SUCCESS_THR': 0.7,
    # Конфликты через диалог
    'SR_CONFLICT_TRUST_THR': 0.7,
    # Экономика доверия
    'SR_TRADE_COOLDOWN': 50,
    'SR_TRADE_MIN_TRUST': 0.5,
    'SR_TRADE_RADIUS': 6,
    # Самомодификация генов
    'SR_GENE_MUT_RATE': 0.05,
    'SR_GENE_MUT_COOLDOWN': 200,
    # Экологическая саморегуляция
    'SR_HEAL_COOLDOWN': 30,
    'SR_HEAL_ENERGY_COST': 0.01,
}
for _k, _v in _sr_cfg.items():
    if not hasattr(Config, _k):
        setattr(Config, _k, _v)

# === ИНИЦИАЛИЗАЦИЯ ===
def _sr_init(self):
    if hasattr(self, '_sr_initialized'):
        return
    self._sr_initialized = True
    self._sr_last_meditation = -Config.SR_MEDITATION_COOLDOWN
    self._sr_meditation_count = 0
    self._sr_goal_feedback = {}
    self._sr_goals_replaced = 0
    self._sr_grief_threshold = 0.5
    self._sr_alarm_threshold = 0.5
    self._sr_thresholds_adjusted = 0
    self._sr_proposals_made = 0
    self._sr_last_proposal_t = -Config.SR_VOTE_INTERVAL
    self._sr_votes_cast = 0
    self._sr_proposals_passed = 0
    self._sr_action_history = deque(maxlen=50)
    self._sr_norms_inferred = 0
    self._sr_conflicts_resolved = 0
    self._sr_last_trade_t = -Config.SR_TRADE_COOLDOWN
    self._sr_trades_done = 0
    self._sr_constitution = []
    self._sr_last_gene_mut = -Config.SR_GENE_MUT_COOLDOWN
    self._sr_gene_mutations = 0
    self._sr_last_heal_t = -Config.SR_HEAL_COOLDOWN
    self._sr_field_heals = 0

# === УРОВЕНЬ 1: МЕДИТАЦИЯ ===
def _sr_should_meditate(self, t):
    if not Config.ENABLE_SELF_REGULATION: return False
    if self.age < Config.SR_MEDITATION_MIN_AGE: return False
    if t - self._sr_last_meditation < Config.SR_MEDITATION_COOLDOWN: return False
    if not self.alive or self.in_dream: return False
    grief = float(self.emotional_memory.get('grief', 0.0))
    # ФИКС: раньше здесь читалась плоская константа Config.SR_MEDITATION_GRIEF_THR,
    # хотя self._sr_grief_threshold -- уже существующий per-agent адаптивный порог
    # (двигается в _sr_adjust_thresholds по прожитому опыту, см. Уровень 10) --
    # никогда не подключался к реальному условию. Теперь подключен.
    if grief > self._sr_grief_threshold: return True
    if getattr(self, 'semantic_state_age', 0) > 40:
        bad = sum(1 for fb in self._sr_goal_feedback.values() if fb.get('perf', 0) < Config.SR_GOAL_PERF_FLOOR)
        if bad > 0: return True
    if self.age % 200 == 0 and self.age > 0: return True
    return False

def _sr_meditate(self, field, t):
    self._sr_last_meditation = t
    self._sr_meditation_count += 1
    old_grief = float(self.emotional_memory.get('grief', 0.0))
    old_tension = float(self.cognitive_tension)
    self.emotional_memory['grief'] = max(0.0, old_grief - Config.SR_MEDITATION_GRIEF_RELIEF)
    self.cognitive_tension = max(0.0, old_tension - Config.SR_MEDITATION_TENSION_RELIEF)
    self.soul_weight = min(1.0, self.soul_weight + 0.005)
    replaced = self._sr_reevaluate_goals()
    self._sr_adjust_thresholds()
    if old_grief > 0.6:
        self._sr_evolve_genes()
    self._log_event("sr_meditation", grief_before=round(old_grief, 3),
                    grief_after=round(float(self.emotional_memory['grief']), 3), goals_replaced=replaced)
    if self.world and hasattr(self.world, 'witness'):
        self.world.witness.record(self.id, "sr_meditation",
                                  grief_relief=round(old_grief - float(self.emotional_memory['grief']), 3),
                                  goals_replaced=replaced)

# === УРОВЕНЬ 1.5/8: ЦЕЛЕВАЯ САМОРЕГУЛЯЦИЯ ===
def _sr_track_goals(self):
    if not Config.ENABLE_SELF_REGULATION: return
    state = (float(self.emotional_memory.get('grief', 0.0)),
             float(self.emotional_memory.get('gratitude', 0.0)),
             float(self.soul_weight), float(self.cognitive_tension))
    active = set()
    for g in self.goals:
        gt = g.get('type')
        if gt is None: continue
        active.add(gt)
        if gt not in self._sr_goal_feedback:
            self._sr_goal_feedback[gt] = {'start_age': self.age, 'start_state': state, 'perf': 0.0}
        else:
            fb = self._sr_goal_feedback[gt]
            elapsed = self.age - fb['start_age']
            if 0 < elapsed <= Config.SR_GOAL_PERF_WINDOW:
                sg, sg0 = state[0], fb['start_state'][0]
                gr, gr0 = state[1], fb['start_state'][1]
                sw, sw0 = state[2], fb['start_state'][2]
                tn, tn0 = state[3], fb['start_state'][3]
                delta = (sg0 - sg)*0.3 + (gr - gr0)*0.3 + (sw - sw0)*0.2 + (tn0 - tn)*0.2
                fb['perf'] = 0.9 * fb['perf'] + 0.1 * delta
    for gt in list(self._sr_goal_feedback.keys()):
        if gt not in active: del self._sr_goal_feedback[gt]

def _sr_reevaluate_goals(self):
    replaced = 0
    to_remove, to_add = [], []
    for g in self.goals:
        gt = g.get('type')
        if gt is None: continue
        if g.get('age', 0) < Config.SR_GOAL_REPLACE_MIN_AGE: continue
        fb = self._sr_goal_feedback.get(gt)
        if fb is None: continue
        if fb['perf'] < Config.SR_GOAL_PERF_FLOOR:
            alt = self._sr_suggest_goal(gt)
            if alt and alt != gt:
                to_remove.append(g)
                to_add.append({'type': alt, 'priority': g.get('priority', 1.0)*0.9,
                               'target': g.get('target'), 'age': 0, 'persistence': 30,
                               '_source': 'sr_reevaluated', '_replaced_from': gt})
                replaced += 1
    for g in to_remove:
        self.goals.remove(g)
        if g.get('type') in self._sr_goal_feedback: del self._sr_goal_feedback[g['type']]
    for g in to_add:
        self.goals.append(g)
        self._log_event("sr_goal_replaced", old=g.get('_replaced_from','?'), new=g['type'])
    self._sr_goals_replaced += replaced
    return replaced

def _sr_suggest_goal(self, old_type):
    grief = float(self.emotional_memory.get('grief', 0.0))
    grat = float(self.emotional_memory.get('gratitude', 0.0))
    tension = float(self.cognitive_tension)
    alts = {'explore': ['cooperate','rest','seek_help'],
            'cooperate': ['explore','rest','introspect'],
            'seek_help': ['cooperate','rest','explore'],
            'rest': ['explore','cooperate','introspect'],
            'introspect': ['explore','cooperate','rest']}
    cands = alts.get(old_type)
    if not cands: return None
    filtered = []
    for c in cands:
        if c == 'cooperate' and grat < 0.3: continue
        if c == 'explore' and tension > 0.8: continue
        if c == 'seek_help' and grief < 0.3: continue
        filtered.append(c)
    if not filtered: filtered = cands
    # [ФИКС] hash(old_type) — строковый Python hash(), рандомизирован
    # PYTHONHASHSEED между запусками (см. коммент про _stable_hash в
    # Cell 1b: та же проблема, что уже чинили для concept-хэшей). Без
    # фикса выбор альтернативной цели не воспроизводим между прогонами
    # с одним и тем же GIVEN_SEED. _stable_hash уже есть в Cell 1b.
    return filtered[int(phi_hash(self.id, self.age, _stable_hash(old_type) % 10000)) % len(filtered)]

# === УРОВЕНЬ 10: РЕФЛЕКСИВНЫЕ ПОРОГИ ===
def _sr_adjust_thresholds(self):
    grief = float(self.emotional_memory.get('grief', 0.0))
    grat = float(self.emotional_memory.get('gratitude', 0.0))
    rate = Config.SR_THR_ADJUST_RATE
    changed = False
    if grief > self._sr_grief_threshold + 0.1 and self.age > 100:
        self._sr_grief_threshold = min(Config.SR_GRIEF_THR_MAX, self._sr_grief_threshold + rate); changed = True
    # ПОДКЛЮЧЕНО (аудит): _sr_alarm_threshold раньше двигался здесь, но нигде
    # не читался как условие. Теперь используется в Pattern.generate_goals
    # (Cell 5) вместо плоского alarm_level > 0.3.
    elif grat > 0.6 and self._sr_alarm_threshold > Config.SR_ALARM_THR_MIN:
        self._sr_alarm_threshold = max(Config.SR_ALARM_THR_MIN, self._sr_alarm_threshold - rate); changed = True
    elif grief < 0.2 and self._sr_grief_threshold > Config.SR_GRIEF_THR_MIN:
        self._sr_grief_threshold = max(Config.SR_GRIEF_THR_MIN, self._sr_grief_threshold - rate*0.5); changed = True
    if changed: self._sr_thresholds_adjusted += 1

# === УРОВЕНЬ 2: ГОЛОСОВАНИЕ (v2.1 — настоящее, межагентное) ===
# [ФИКС v2.1] В v2.0 предложение и голос хранились НА САМОМ АГЕНТЕ
# (self._sr_proposals) — по факту каждый агент предлагал и голосовал
# сам за себя (1 голос из 1 → порог 0.6 всегда проходил). Второй
# советник предложил транслировать голосование через Морзе — не
# годится: Морзе у нас физический канал с шумом (~20-40% искажений по
# вашей же статистике decode), для подсчёта кворума нужна надёжная
# доставка. Вместо этого — общий реестр предложений НА EvolutionEngine
# (self.world.sr_proposals), по той же схеме, что уже используется для
# witness/pattern_dict: агенты и так имеют прямой (не физический)
# доступ к своему миру для служебных данных.
def _sr_propose(self, field, t):
    if not Config.ENABLE_SELF_REGULATION: return
    if not self.world or not hasattr(self.world, 'sr_proposals'): return
    if t - self._sr_last_proposal_t < Config.SR_VOTE_INTERVAL: return
    grief = float(self.emotional_memory.get('grief', 0.0))
    if grief <= 0.6: return
    self._sr_last_proposal_t = t
    prop_id = f"{self.id}_{t}"
    self.world.sr_proposals[prop_id] = {
        'type': 'reduce_grief', 'author': self.id, 't': t,
        'votes': {self.id: True},
    }
    self._sr_proposals_made += 1
    self._log_event("sr_proposal", proposal=prop_id)

def _sr_vote(self, field, t):
    if not Config.ENABLE_SELF_REGULATION: return
    if not self.world or not hasattr(self.world, 'sr_proposals'): return
    grief = float(self.emotional_memory.get('grief', 0.0))
    for prop_id, prop in list(self.world.sr_proposals.items()):
        if self.id not in prop['votes']:
            # Голосуем "за", если сами страдаем от того же (высокое горе) —
            # это не альтруизм, а честная модель self-interest voting.
            prop['votes'][self.id] = grief > 0.5
            self._sr_votes_cast += 1
        total_votes = len(prop['votes'])
        timed_out = (t - prop['t']) > 200
        if total_votes >= Config.SR_VOTE_QUORUM or timed_out:
            yes = sum(1 for v in prop['votes'].values() if v)
            if total_votes > 0 and yes / total_votes >= Config.SR_VOTE_THRESHOLD:
                if prop['type'] == 'reduce_grief':
                    for voter_id, vote in prop['votes'].items():
                        if not vote or voter_id not in self.world.pattern_dict:
                            continue
                        voter = self.world.pattern_dict[voter_id]
                        if voter.alive:
                            voter.emotional_memory['grief'] = max(
                                0.0, float(voter.emotional_memory.get('grief', 0.0)) * 0.9)
                self._sr_proposals_passed += 1
                self._log_event("sr_proposal_passed", proposal=prop_id, voters=total_votes)
            del self.world.sr_proposals[prop_id]

# === УРОВЕНЬ 2.5/9: НОРМОТВОРЧЕСТВО ===
def _sr_infer_norms(self):
    if not Config.ENABLE_SELF_REGULATION: return
    if len(self._sr_action_history) < Config.SR_NORM_MIN_REPS: return
    action_success = defaultdict(lambda: {'total': 0, 'success': 0})
    for entry in self._sr_action_history:
        action = entry.get('action')
        if action:
            action_success[action]['total'] += 1
            if entry.get('success', False): action_success[action]['success'] += 1
    for action, stats in action_success.items():
        if stats['total'] >= Config.SR_NORM_MIN_REPS:
            rate = stats['success'] / stats['total']
            if rate > Config.SR_NORM_SUCCESS_THR:
                norm_sig = (0.9, 0.9, 0.9, f"sr_norm_{action}")
                if norm_sig not in self.concept_graph.nodes:
                    self.concept_graph.update(norm_sig, np.array([0.1, 0.1, 0.9, 1.0]))
                    self.concept_graph.nodes[norm_sig]['eternal'] = True
                    self._sr_norms_inferred += 1
                    self._log_event("sr_norm_inferred", action=action, rate=round(rate, 3))
                    if self.world and hasattr(self.world, 'witness'):
                        self.world.witness.record(self.id, "sr_norm_inferred", action=action)

# === УРОВЕНЬ 4: ЭКОНОМИКА ДОВЕРИЯ ===
def _sr_try_trade(self, field, t):
    if not Config.ENABLE_SELF_REGULATION: return
    if t - self._sr_last_trade_t < Config.SR_TRADE_COOLDOWN: return
    if not self.world or not self.world.pattern_dict: return
    # [ФИКС] Оригинал искал партнёра ПО ВСЕЙ таблице доверия (trust_ledger
    # копит записи за всю жизнь агента) без проверки дистанции — энергия
    # телепортировалась между любой парой на карте, в отличие от
    # compete()/exchange_meanings(), которые требуют реального
    # пересечения клеток. Добавлена проверка радиуса (тороидально, как
    # и остальные пространственные проверки в проекте).
    cx, cy = self._get_center_cell()
    ws = Config.WORLD_SIZE
    best_partner, best_trust = None, 0
    for pid, trust in self.trust_ledger.entries.items():
        if trust <= best_trust or pid not in self.world.pattern_dict:
            continue
        partner = self.world.pattern_dict[pid]
        if not partner.alive:
            continue
        px, py = partner._get_center_cell()
        dx = min(abs(px - cx), ws - abs(px - cx))
        dy = min(abs(py - cy), ws - abs(py - cy))
        if max(dx, dy) > Config.SR_TRADE_RADIUS:
            continue
        best_partner, best_trust = partner, trust
    if best_partner is None or best_trust < Config.SR_TRADE_MIN_TRUST: return
    self._sr_last_trade_t = t
    if self.energy > 0.3 and best_partner.energy < 0.2:
        # [ДОБАВЛЕНО v2.1] Цена как функция доверия: чем ниже доверие,
        # тем дороже сделка обходится дающему (трение низкого доверия) —
        # получатель всегда получает фиксированный transfer, а платит
        # даритель больше при низком best_trust.
        transfer = 0.05
        price = 1.0 + (1.0 - best_trust) * 2.0
        cost = transfer * price
        if self.energy - cost < 0:
            return
        self._x2_change('X2.selfreg_trade_out', self.energy - cost)
        best_partner._x2_change('X2.selfreg_trade_in', best_partner.energy + transfer)
        self.trust_ledger.update(best_partner.id, 'helpful', multiplier=0.5)
        best_partner.trust_ledger.update(self.id, 'helpful', multiplier=0.5)
        self._sr_trades_done += 1
        self._log_event("sr_trade", partner=best_partner.id, amount=transfer, price=round(price, 2))

# === УРОВЕНЬ 1.5 (доп.): СОЗДАНИЕ НОВЫХ ЦЕЛЕЙ ===
# [ДОБАВЛЕНО v2.1] _sr_reevaluate_goals только ЗАМЕНЯЕТ существующие
# цели — если у агента целей вообще мало (после смертей/фильтрации),
# заменять нечего. Добавляем создание с нуля.
def _sr_create_new_goal(self):
    if not Config.ENABLE_SELF_REGULATION: return
    if len(self.goals) >= 2: return
    candidates = ['explore', 'cooperate', 'seek_help', 'rest']
    existing = {g.get('type') for g in self.goals}
    valid = [c for c in candidates if c not in existing]
    if not valid: return
    new_type = valid[int(phi_hash(self.id, self.age, 9999) * len(valid)) % len(valid)]
    self.goals.append({'type': new_type, 'priority': 0.5, 'target': None,
                       'age': 0, 'persistence': 20, '_source': 'sr_created'})
    self._log_event("sr_goal_created", type=new_type)

# === УРОВЕНЬ 5: КОНСТИТУЦИЯ ===
def _sr_update_constitution(self, field, t):
    if not Config.ENABLE_SELF_REGULATION: return
    if self.age % 300 != 0: return
    if self._sr_trades_done > 3 and 'reciprocity' not in [r.get('name') for r in self._sr_constitution]:
        self._sr_constitution.append({'name': 'reciprocity', 't': t})
        self._sr_add_constitution_concept('reciprocity')
        self._log_event("sr_constitution_rule", rule='reciprocity')
    if self._sr_conflicts_resolved > 2 and 'nonviolence' not in [r.get('name') for r in self._sr_constitution]:
        self._sr_constitution.append({'name': 'nonviolence', 't': t})
        self._sr_add_constitution_concept('nonviolence')
        self._log_event("sr_constitution_rule", rule='nonviolence')

def _sr_add_constitution_concept(self, rule_name):
    """[ДОБАВЛЕНО v2.1] Правило конституции — ещё и вечный концепт в
    concept_graph (как archive_* концепты), а не только запись в
    _sr_constitution, которая умирает вместе с агентом. Так правило
    может пережить агента и разойтись через exchange_meanings/Морзе
    как обычный культурный концепт."""
    sig = (0.9, 0.9, 0.9, f"constitution_{rule_name}")
    if sig not in self.concept_graph.nodes:
        self.concept_graph.update(sig, np.array([0.1, 0.1, 0.9, 1.0]))
        self.concept_graph.nodes[sig]['eternal'] = True

# === УРОВЕНЬ 6: САМОМОДИФИКАЦИЯ ГЕНОВ ===
def _sr_evolve_genes(self):
    if not Config.ENABLE_SELF_REGULATION: return
    if self.age - self._sr_last_gene_mut < Config.SR_GENE_MUT_COOLDOWN: return
    self._sr_last_gene_mut = self.age
    grief = float(self.emotional_memory.get('grief', 0.0))
    if grief > 0.6 and 'scar_resistance' in self.genome:
        self.genome['scar_resistance'] = min(1.5, self.genome['scar_resistance'] + Config.SR_GENE_MUT_RATE)
        self._sr_gene_mutations += 1
        self._log_event("sr_gene_evolved", gene='scar_resistance')

# === УРОВЕНЬ 7: ЭКОЛОГИЧЕСКАЯ САМОРЕГУЛЯЦИЯ ===
def _sr_heal_field(self, field, t):
    if not Config.ENABLE_SELF_REGULATION: return
    if t - self._sr_last_heal_t < Config.SR_HEAL_COOLDOWN: return
    if self.energy < Config.SR_HEAL_ENERGY_COST * 2: return
    self._sr_last_heal_t = t
    cx, cy = self._get_center_cell()
    for dx in range(-2, 3):
        for dy in range(-2, 3):
            nx = (cx + dx) % Config.WORLD_SIZE
            ny = (cy + dy) % Config.WORLD_SIZE
            field[nx, ny, CH['scar']] *= 0.7
            field[nx, ny, CH['binding']] = min(1.0, field[nx, ny, CH['binding']] + 0.1)
    self._x2_change('X2.selfreg_heal_cost', self.energy - Config.SR_HEAL_ENERGY_COST)
    self._sr_field_heals += 1
    self._log_event("sr_field_healed", x=cx, y=cy)

# === ГЛАВНЫЙ МЕТОД ===
def _sr_update(self, field, t):
    if not Config.ENABLE_SELF_REGULATION: return
    if not hasattr(self, '_sr_initialized'): _sr_init(self)
    self._sr_track_goals()
    if self.intent:
        self._sr_action_history.append({'action': self.intent.get('type', 'none'),
                                        'success': float(self.emotional_memory.get('gratitude', 0.0)) > 0.5, 't': t})
    if self._sr_should_meditate(t): self._sr_meditate(field, t)
    self._sr_propose(field, t)
    self._sr_vote(field, t)
    if self.age % 50 == 0: self._sr_infer_norms()
    self._sr_try_trade(field, t)
    self._sr_update_constitution(field, t)
    if self.age % 40 == 0: self._sr_create_new_goal()
    if self.age % 100 == 0 and self.soul_weight > 0.6: self._sr_heal_field(field, t)

# === СЛОЙ САМОРЕГУЛЯЦИИ — подклассы над Pattern и EvolutionEngine (без подмены методов) ===
# Базовое поведение зовётся через super(). Повторный запуск ячейки безопасен.
if "extend_class" not in globals():
    raise RuntimeError("Нет extend_class: сначала выполни ячейку Cell 3f (Substates Engine).")


class SelfRegMixin:
    _sr_init = _sr_init
    _sr_should_meditate = _sr_should_meditate
    _sr_meditate = _sr_meditate
    _sr_track_goals = _sr_track_goals
    _sr_reevaluate_goals = _sr_reevaluate_goals
    _sr_suggest_goal = _sr_suggest_goal
    _sr_adjust_thresholds = _sr_adjust_thresholds
    _sr_propose = _sr_propose
    _sr_vote = _sr_vote
    _sr_infer_norms = _sr_infer_norms
    _sr_try_trade = _sr_try_trade
    _sr_create_new_goal = _sr_create_new_goal
    _sr_update_constitution = _sr_update_constitution
    _sr_add_constitution_concept = _sr_add_constitution_concept
    _sr_evolve_genes = _sr_evolve_genes
    _sr_heal_field = _sr_heal_field
    _sr_update = _sr_update

    def __init__(self, pid, cells, parent=None, world=None):
        super().__init__(pid, cells, parent, world)
        self._sr_init()

    def update_model(self, field, lineage_counts=None, given_counter=None, t=None, witness=None):
        result = super().update_model(field, lineage_counts, given_counter, t, witness)
        if Config.ENABLE_SELF_REGULATION and self.alive:
            self._sr_update(field, t if t is not None else 0)
        return result

    def compete(self, other, field):
        # ПРИМЕЧАНИЕ (важно для интерпретации метрики sr_conflicts_resolved):
        # у compete() уже ЕСТЬ встроенный no-fight при обоюдном доверии >0.8
        # (см. Cell 3a). Эта проверка идёт РАНЬШЕ и с более низким порогом
        # (0.7), поэтому реально расширяет "мирную зону" на диапазон
        # 0.7-0.8, а для диапазона >0.8 просто озвучивает (логирует) то,
        # что раньше происходило молча. Значит sr_conflicts_resolved
        # включает оба случая — не только "новые" мирные исходы.
        if Config.ENABLE_SELF_REGULATION:
            ts = self.trust_ledger.get(other.id, 0.5)
            to = other.trust_ledger.get(self.id, 0.5)
            if ts > Config.SR_CONFLICT_TRUST_THR and to > Config.SR_CONFLICT_TRUST_THR:
                self._sr_conflicts_resolved += 1
                self._log_event("sr_conflict_resolved", partner=other.id)
                return
        super().compete(other, field)


class SelfRegEngineMixin:
    """Общий реестр предложений для межагентного голосования."""
    def __init__(self):
        super().__init__()
        self.sr_proposals = {}


Pattern = extend_class(Pattern, SelfRegMixin)
EvolutionEngine = extend_class(EvolutionEngine, SelfRegEngineMixin)

print("✅ САМОРЕГУЛЯЦИЯ v2.1: все 10 уровней + честное межагентное голосование через world.sr_proposals,")
print("   цена сделки от доверия, создание новых целей, конституция как вечный концепт")
print("   Фиксы: _stable_hash вместо hash() (детерминизм), радиус в торговле (без телепортации энергии), реальный кворум голосования")
