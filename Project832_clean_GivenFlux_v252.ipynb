def _scream_publish(world, kind, **data):
    st = _st(world)
    evt = {"t": int(data.get("t", 0)), "type": f"scream_{kind}"}
    evt.update({k: (v if not isinstance(v, np.generic) else v.item())
                for k, v in data.items() if k != "t"})
    if len(st.events) < SCREAM_EVENTS_MAX:
        st.events.append(evt)
    _emit(world, st, dict(evt), f"scream_{kind}", SCREAM_EVENTS_MAX)

def _scream_dist(a, b, W):
    dx = abs(int(a[0]) - int(b[0])); dx = min(dx, W - dx)
    dy = abs(int(a[1]) - int(b[1])); dy = min(dy, W - dy)
    return float(np.hypot(dx, dy))

def _scream_nearest_step(src, dst, W):
    dx = int(dst[0]) - int(src[0]); dy = int(dst[1]) - int(src[1])
    if dx > W / 2: dx -= W
    elif dx < -W / 2: dx += W
    if dy > W / 2: dy -= W
    elif dy < -W / 2: dy += W
    return (0 if dx == 0 else (1 if dx > 0 else -1)), (0 if dy == 0 else (1 if dy > 0 else -1))

_IDX4 = np.arange(-4, 5)

def _scream_try(self, field, now):
    if self.role_type == "feral" or not self.alive or not self.cells or field is None:
        return
    st = _st(self.world)
    sens = min(1.0, float(getattr(self, "_scream_sensitivity", 1.0)) + SENS_RECOVERY_PER_TICK)
    self._scream_sensitivity = sens
    W = Config.WORLD_SIZE
    cx, cy = self.get_center()
    cx, cy = int(cx) % W, int(cy) % W
    feral_near = float(field[:, :, CH["signal_feral"]][
        np.ix_((cx + _IDX4) % W, (cy + _IDX4) % W)].mean(dtype=np.float64))
    alarm = float(getattr(self, "alarm_level", 0.0))
    if feral_near > FERAL_NEAR_THRESHOLD:
        alarm = min(1.0, alarm + 0.4)
        self.alarm_level = alarm
    emotional = getattr(self, "emotional_memory", {}) or {}
    grief = float(emotional.get("grief", 0.0))
    init_done = getattr(self, "_scream_init_done", False)
    prev_alarm = float(getattr(self, "_scream_prev_alarm", alarm))
    prev_grief = float(getattr(self, "_scream_prev_grief", grief))
    self._scream_prev_alarm, self._scream_prev_grief = alarm, grief
    if not init_done:
        self._scream_init_done = True
        return
    d_state = max(0.0, alarm - prev_alarm) + max(0.0, grief - prev_grief)
    rise_trigger = d_state > RISE_TRIGGER_BASE / max(sens, SENS_MIN)
    feral_trigger = feral_near > FERAL_TRIGGER_BASE * (1.5 / max(sens, SENS_MIN))
    if not (rise_trigger or feral_trigger):
        if d_state > RISE_TRIGGER_BASE * 0.5 or feral_near > FERAL_TRIGGER_BASE:
            st.scream["habituation_blocked"] += 1
        return
    reason = "feral" if feral_trigger else "rise"
    # ИСПРАВЛЕНО: строгая оплата. Без allow_partial.
    paid = self._consume_action('scream')
    if paid is None:
        st.scream['cost_blocked'] += 1
        return
    self._scream_boost_until = now + SCREAM_BOOST_DURATION
    self._last_scream_t, self._last_scream_pos = now, (cx, cy)
    self._scream_sensitivity = max(SENS_MIN, sens * SENS_DROP_ON_SCREAM)
    st.recent[self.id] = {"t": now, "pos": (cx, cy)}
    st.scream["total"] += 1
    st.scream["feral" if reason == "feral" else "rise"] += 1
    dxs, dys, dist = _disc(SCREAM_RADIUS)
    # NB: CH["signal_alarm"] — ИНФОРМАЦИОННЫЙ канал. Насыщение np.minimum(1.0, ...)
    # не является энергетической утечкой. Аудит энергии — через ledger.
    chan = field[:, :, CH["signal_alarm"]]
    xi, yi = (cx + dxs) % W, (cy + dys) % W
    chan[xi, yi] = np.minimum(
        1.0, chan[xi, yi] + SCREAM_ALARM_STRENGTH * (1.0 - dist / SCREAM_RADIUS))
    # Единый крик: скалярный пик в поле дополняется ФОРМОЙ в журнале сигналов (bk.tx) — иначе провенанс 'unknown',
    # а ни доверия к крикуну, ни закрепления формы не будет. Деньги уже уплачены выше (action 'scream').
    if self._sig_cry(field, now):
        st.scream["cry_as_form"] += 1
    _scream_publish(self.world, "scream", t=now, id=self.id, reason=reason,
                    feral_near=round(feral_near, 4), alarm=round(alarm, 4),
                    grief=round(grief, 4), d_state=round(d_state, 4),
                    sens_before=round(sens, 3),
                    sens_after=round(self._scream_sensitivity, 3),
                    cost=round(float(paid), 5),
                    fatigue=round(self._action_fatigue.get('scream', 0.0), 2),
                    pos=(cx, cy))
    self._log_event("scream", reason=reason, feral_near=round(feral_near, 3))

def _scream_check_response_arrival(world, now):
    W = Config.WORLD_SIZE
    st = _st(world)
    for p in world.patterns:
        if not p.alive or not p.cells:
            continue
        goals = getattr(p, "goals", None)
        if not goals:
            continue
        for goal in list(goals):
            if goal.get("_source") != "scream_response":
                continue
            target = goal.get("target")
            if target is None:
                continue
            cx, cy = p.get_center()
            here = (int(cx) % W, int(cy) % W)
            if _scream_dist(here, target, W) <= 2.0:
                st.scream["response_reached"] += 1
                _scream_publish(world, "response_reached", t=now, id=p.id,
                                source_id=goal.get("_source_id"),
                                target=tuple(target),
                                time_to_reach=int(now) - int(goal.get("_created_t", now)),
                                pos=here)
                goals.remove(goal)
                p._scream_target = None

def _fatigue_stats(world):
    alive = [p for p in world.patterns if p.alive]
    if not alive:
        return 0.0, 0.0
    fs = [p._fatigue_state() for p in alive]
    return float(sum(fs) / len(fs)), float(max(fs))

def _flat(world):
    st = _st(world)
    s, kg = st.scream, st.kill_gate
    fa, fm = _fatigue_stats(world)
    return {
        "scr_cry": s["total"], "scr_cry_feral": s["feral"], "scr_cry_rise": s["rise"],
        "scr_hab_ticks": s["habituation_blocked"], "scr_cost_blocked": s["cost_blocked"],
        "scr_repel": s["repel"], "scr_resp_goal": s["response_goal"],
        "scr_resp_reached": s["response_reached"],
        "scr_kill": s["kill"], "scr_kill_energy": float(s["kill_energy_moved"]),
        "scr_meat": s["meat_kills"], "scr_meat_energy": float(s["meat_energy"]),
        "scr_kill_ebw": st.kill_energy_balance_warnings,
        "scr_kill_neg_e": st.kill_negative_feral_energy,
        "intent_sw_blocked_pre": st.intent_switch_blocked_pre,
        "kg_attempts": kg["attempts"], "kg_signal_low": kg["signal_low"],
        "kg_screamers_low": kg["screamers_low"],
        "kg_passed": kg["passed"], "kg_alarm_max": st.alarm_max,
        "kg_core_max": st.core_max, "kg_screamers_max": st.screamers_max,
        "act_spent": float(sum(st.spent.values())),
        "act_blocked": int(sum(v for k, v in st.actions.items()
                              if "blocked" in k or "unpaid" in k)),
        "act_fatigue_avg": fa, "act_fatigue_max": fm,
        "act_fatigue_peak": st.fatigue_peak,
        "x2g_min": (st.x2_min if st.x2_min != float("inf") else 0.0),
        "x2g_max": (st.x2_max if st.x2_max != float("-inf") else 0.0),
        "x2g_neg_ticks": st.x2_neg_ticks,
        "x2g_nonfinite_ticks": st.x2_nonfinite_ticks,
    }

def _feral_meat(world, feral, screamers, field, now):
    """«Мясо»: энергия X1 под клетками убитого ферала → крикунам. Одна парная запись X1→X2.

    Поле списывается напрямую; X2 растёт через _x2_change, который САМ пишет строку X2 в леджер —
    второй записи в X2 здесь нет (иначе X2 учтётся дважды и closure сломается).
    Берём то, что реально ушло из поля (с учётом float32), а не то, что собирались взять."""
    if not Config.FERAL_MEAT_ENABLE or not screamers or not feral.cells:
        return 0.0
    st = _st(world)
    cells = list(feral.cells)
    xs = np.fromiter((c[0] for c in cells), dtype=np.int64, count=len(cells))
    ys = np.fromiter((c[1] for c in cells), dtype=np.int64, count=len(cells))
    ch = CH["energy"]
    before = field[xs, ys, ch].astype(np.float64)
    want = np.minimum(float(Config.FERAL_MEAT_PER_CELL), np.maximum(0.0, before))
    total_want = float(want.sum())
    if total_want <= 0.0:
        st.scream["meat_empty"] += 1
        return 0.0
    cap = float(Config.FERAL_MEAT_MAX_TOTAL)
    if cap > 0.0 and total_want > cap:
        want *= cap / total_want
    field[xs, ys, ch] -= want
    take = float((before - field[xs, ys, ch].astype(np.float64)).sum())
    if take <= 0.0:
        return 0.0
    share = take / len(screamers)
    got = 0.0
    for s in screamers:
        got += float(s._x2_change("X2.feral_meat_reward", float(s.energy) + share))
    world._ledger_add("X1.feral_meat_transfer", -take)
    st.scream["meat_kills"] += 1
    st.scream["meat_energy"] += got
    _scream_publish(world, "meat_from_feral", t=now, feral=feral.id, amount=round(take, 6),
                    received=round(got, 6), screamers=[s.id for s in screamers], cells=len(cells))
    return take


class P832PatternMixin:
    """Слой p832 над Pattern: NO-CLIP энергия, усталость и строгая оплата действий, крик (scream).
    Базовое поведение — через super(). Подключается один раз через extend_class."""

    # NO-CLIP: собственный дескриптор энергии слоя без клипа (дескриптор базы не изменяется).
    energy = FloatField('energy', default=Pattern.energy.default, clamp_min=None, clamp_max=None)

    # ---- усталость и стоимость действий ----

    def _fatigue_init(self):
        if "_action_fatigue" not in self.__dict__:
            self._action_fatigue = {}

    def _fatigue_state(self):
        self._fatigue_init()
        return sum(self._action_fatigue.values()) if self._action_fatigue else 0.0

    def _action_cost(self, action, base_cost=None):
        self._fatigue_init()
        if base_cost is None:
            base_cost = ACTION_COSTS.get(action, 0.01)
        return base_cost * (1.0 + self._action_fatigue.get(action, 0.0) * FATIGUE_MULT)

    def _can_afford(self, action, base_cost=None):
        return float(self.energy) >= self._action_cost(action, base_cost)

    def _consume_action(self, action, base_cost=None, allow_partial=False):
        self._fatigue_init()
        cost = self._action_cost(action, base_cost)
        cur = float(self.energy)
        if not np.isfinite(cur):
            return None
        if cur < cost:
            if allow_partial and cur > 0:
                cost = cur
            else:
                return None
        self._x2_change(f'X2.action_{action}', cur - cost)
        f = self._action_fatigue.get(action, 0.0) + 1.0
        if FATIGUE_CAP is not None:
            f = min(f, FATIGUE_CAP)
        self._action_fatigue[action] = f
        st = _st(self.world)
        st.spent[action] += cost
        st.fatigue_peak = max(st.fatigue_peak, f)
        return cost

    def _recover_fatigue(self):
        self._fatigue_init()
        for k in list(self._action_fatigue.keys()):
            self._action_fatigue[k] *= FATIGUE_DECAY
            if self._action_fatigue[k] < FATIGUE_MIN:
                del self._action_fatigue[k]


    def _tick_goal_cost(self):
        # Атомарная цена: одна транзакция за все цели.
        # Если энергии не хватает — просрочиваем хвост списка.
        goals = getattr(self, 'goals', None)
        if not goals:
            return
        per_cost = ACTION_COSTS['goal_hold']
        n_goals = len(goals)
        total_cost = per_cost * n_goals
        cur = float(self.energy)
        st = _st(self.world)
        if cur >= total_cost:
            self._x2_change('X2.action_goal_hold', cur - total_cost)
            st.spent['goal_hold'] += total_cost
            return
        can_pay = max(0, int(cur / per_cost))
        if can_pay > 0:
            paid = can_pay * per_cost
            self._x2_change('X2.action_goal_hold', cur - paid)
            st.spent['goal_hold'] += paid
        for g in goals[can_pay:]:
            g['age'] = g.get('persistence', 9999) + 1

    # ---- действия: оплата → базовый метод (super) ----

    def _send_morse(self, text, field, recipient_id=None):
        paid = self._consume_action('morse_send')
        if paid is None:
            _st(self.world).actions['morse_send_blocked'] += 1
            return
        _action_publish(self.world, 'morse_send', self.id, paid,
                        self._action_fatigue.get('morse_send', 0))
        return super()._send_morse(text, field, recipient_id)

    def update_intent(self):
        # АТОМАРНОСТЬ: проверка энергии ДО вызова базового метода.
        # Неоплаченного переключения намерения быть не может.
        if not self._can_afford('intent_switch'):
            _st(self.world).actions['intent_switch_blocked_pre'] += 1
            _st(self.world).intent_switch_blocked_pre += 1
            self.cognitive_tension = min(Config.MAX_METRIC,
                                         float(self.cognitive_tension) + 0.02)
            return
        prev_age = self.last_intent_switch_age
        super().update_intent()
        switched = (self.last_intent_switch_age != prev_age
                    and self.last_intent_switch_age == self.age)
        if switched:
            paid = self._consume_action('intent_switch')
            if paid is None:
                # Возможно только при гонке с другим списанием в том же тике.
                _st(self.world).actions['intent_switch_unpaid'] += 1
                self._log_event('intent_switch_unpaid')
            else:
                _action_publish(self.world, 'intent_switch', self.id, paid,
                                self._action_fatigue.get('intent_switch', 0))

    def can_divide(self):
        if not super().can_divide():
            return False
        if not self._can_afford('divide'):
            _st(self.world).actions['divide_blocked_cost'] += 1
            return False
        return True

    def divide(self, field, next_id):
        paid = self._consume_action('divide')
        if paid is None:
            return None, next_id
        _action_publish(self.world, 'divide', self.id, paid,
                        self._action_fatigue.get('divide', 0))
        return super().divide(field, next_id)

    def introspect(self):
        self._last_introspect_step = -10**9  # НАМЕРЕННЫЙ обход cooldown (см. шапку)
        if not self._can_afford('introspect'):
            _st(self.world).actions['introspect_blocked'] += 1
            return None
        paid = self._consume_action('introspect')
        _action_publish(self.world, 'introspect', self.id, paid,
                        self._action_fatigue.get('introspect', 0))
        return super().introspect()

    def _sr_meditate(self, field, t):
        self._sr_last_meditation = -10**9  # НАМЕРЕННЫЙ обход cooldown
        paid = self._consume_action('meditation')
        if paid is None:
            _st(self.world).actions['meditation_blocked'] += 1
            return
        _action_publish(self.world, 'meditation', self.id, paid,
                        self._action_fatigue.get('meditation', 0))
        return super()._sr_meditate(field, t)

    def _sr_try_trade(self, field, t):
        self._sr_last_trade_t = -10**9  # НАМЕРЕННЫЙ обход cooldown
        if not self._can_afford('trade'):
            return
        paid = self._consume_action('trade')
        _action_publish(self.world, 'trade', self.id, paid,
                        self._action_fatigue.get('trade', 0))
        return super()._sr_try_trade(field, t)

    def _sr_heal_field(self, field, t):
        self._sr_last_heal_t = -10**9  # НАМЕРЕННЫЙ обход cooldown
        if not self._can_afford('heal_field'):
            return
        paid = self._consume_action('heal_field')
        _action_publish(self.world, 'heal_field', self.id, paid,
                        self._action_fatigue.get('heal_field', 0))
        return super()._sr_heal_field(field, t)

    def apply_given_operator(self, field, forced=False, witness=None):
        # ИСПРАВЛЕНО: строгая оплата. Без allow_partial.
        self.given_cooldown = 0
        paid = self._consume_action('given')
        if paid is None:
            _st(self.world).actions['given_blocked'] += 1
            return
        _action_publish(self.world, 'given', self.id, paid,
                        self._action_fatigue.get('given', 0))
        return super().apply_given_operator(field, forced=forced, witness=witness)

    # ---- движение, добыча, цели, убийство ферала ----

    def move(self, field, t):
        now = int(getattr(self.world, "age", t))
        target = getattr(self, "_scream_target", None)
        if target is not None and self.alive and self.cells:
            W = Config.WORLD_SIZE
            cx, cy = self.get_center()
            src = (int(cx) % W, int(cy) % W)
            if _scream_dist(src, target, W) > 2:
                sx, sy = _scream_nearest_step(src, target, W)
                if (sx, sy) != (0, 0):
                    self._dir_momentum = (float(sx), float(sy))
        if not getattr(self, "_scream_boost_until", -1) > now:
            return super().move(field, t)
        old_mobility = self.genome.get("mobility", 0.1)
        self.genome["mobility"] = min(0.5, old_mobility * SCREAM_MOBILITY_BOOST)
        try:
            return super().move(field, t)
        finally:
            self.genome["mobility"] = old_mobility

    def _find_prey(self, field, world, min_cells=5, radius=20):
        prey, direction, dist = super()._find_prey(field, world, min_cells=min_cells, radius=radius)
        if direction is None or field is None:
            return prey, direction, dist
        W = Config.WORLD_SIZE
        cx, cy = self.get_center()
        cx, cy = int(cx) % W, int(cy) % W
        steps = max(1, min(int(dist) if dist else 10, 15))
        alarm_ahead = 0.0
        for r in range(1, steps + 1):
            alarm_ahead += float(field[
                int((cx + direction[0] * r) % W),
                int((cy + direction[1] * r) % W),
                CH["signal_alarm"]])
        alarm_ahead /= steps
        if alarm_ahead > 0.4:
            now = int(world.age if world is not None else self.age)
            roll = phi_hash(self.id, now, 7777)
            if roll < min(0.95, alarm_ahead * FERAL_ALARM_REPEL):
                _st(world).scream["repel"] += 1
                _scream_publish(world, "repel", t=now, feral=self.id,
                                alarm_ahead=round(alarm_ahead, 4),
                                roll=round(roll, 4), pos=(cx, cy))
                self._log_event("feral_repelled_by_scream", alarm=round(alarm_ahead, 3))
                if prey is not None:
                    _bo = getattr(self, '_feral_backoff', None)
                    if _bo is None:
                        _bo = {}
                        self._feral_backoff = _bo
                    _bo[prey.id] = now + Config.FERAL_MISS_BACKOFF_TICKS
                    prey._feral_scar_count = getattr(prey, '_feral_scar_count', 0) + 1
                return None, None, None
        return prey, direction, dist

    def generate_goals(self, field):
        super().generate_goals(field)
        if field is None or not self.alive or not self.cells or self.role_type == "feral":
            return
        if any(g.get("_source") == "scream_response" for g in self.goals):
            return
        st = _st(self.world)
        W = Config.WORLD_SIZE
        xs = [c[0] for c in self.cells]; ys = [c[1] for c in self.cells]
        local_alarm = float(np.mean(field[xs, ys, CH["signal_alarm"]]))
        noise_floor = max(BG_FLOOR_MIN,
                          (st.bg_alarm if self.world is not None else 0.0) * BG_FLOOR_MULT)
        if local_alarm < noise_floor:
            return
        cx, cy = self.get_center()
        here = (int(cx) % W, int(cy) % W)
        now = int(getattr(self.world, "age", self.age))
        best, best_score = None, 0.0
        for sid, rec in list(st.recent.items()):
            age = now - int(rec["t"])
            if age < 0 or age > SCREAM_SOURCE_TTL:
                if age > SCREAM_SOURCE_TTL:
                    st.recent.pop(sid, None)
                continue
            if sid == self.id:
                continue
            d = _scream_dist(here, rec["pos"], W)
            if d < 1.0:
                continue
            reach = float(field[rec["pos"][0], rec["pos"][1], CH["signal_alarm"]]) \
                / (1.0 + d / max(SCREAM_RADIUS, 1))
            if reach < noise_floor:
                continue
            if reach > best_score:
                best_score, best = reach, (sid, rec["pos"], d, age)
        if best is None:
            return
        sid, target, dist, age = best
        if self._consume_action('scream_response') is None:
            return
        self.goals.append({"type": "explore", "priority": 1.5 + local_alarm,
                           "target": tuple(target), "age": 0, "persistence": 20,
                           "_source": "scream_response", "_source_id": sid,
                           "_created_t": now})
        self._scream_target = tuple(target)
        st.scream["response_goal"] += 1
        _scream_publish(self.world, "response_goal", t=now, id=self.id,
                        source_id=sid, target=tuple(target), distance=round(dist, 3),
                        source_age=age, local_alarm=round(local_alarm, 4),
                        noise_floor=round(noise_floor, 4),
                        reach=round(best_score, 4), pos=here)

    def feral_execute(self, other, field):
        orig = super().feral_execute
        if self.role_type != "feral" or field is None or not self.cells or self.world is None:
            return orig(other, field)
        st = _st(self.world)
        W = Config.WORLD_SIZE
        cx, cy = self.get_center()
        here = (int(cx) % W, int(cy) % W)
        now = int(self.world.age)
        chan = field[:, :, CH["signal_alarm"]]
        alarm_at_center = _disc_mean(chan, here[0], here[1], KILL_SIGNAL_RADIUS, W)
        core = _disc_mean(chan, here[0], here[1], KILL_CORE_RADIUS, W)
        st.kill_gate["attempts"] += 1
        st.alarm_max, st.core_max = max(st.alarm_max, alarm_at_center), max(st.core_max, core)
        st.alarm_hist[f"{min(int(alarm_at_center * 10), 10) / 10:.1f}"] += 1
        if alarm_at_center < KILL_MIN_SIGNAL_AT_CENTER:
            st.kill_gate["signal_low"] += 1
            return orig(other, field)
        screamers = []
        for p in self.world.patterns:
            if (not p.alive or not p.cells or p.id == self.id
                    or getattr(p, "role_type", None) == "feral"):
                continue
            last_t = int(getattr(p, "_last_scream_t", -10**9))
            if now - last_t < 0 or now - last_t > KILL_SCREAM_FRESH:
                continue
            pos = getattr(p, "_last_scream_pos", None)
            if pos is not None and _scream_dist(pos, here, W) < 10:
                screamers.append(p)
        st.screamers_max = max(st.screamers_max, len(screamers))
        st.screamers_hist[str(min(len(screamers), 9))] += 1
        if len(screamers) < KILL_MIN_SCREAMERS:
            st.kill_gate["screamers_low"] += 1
            return orig(other, field)
        feral_energy = float(self.energy)
        if not np.isfinite(feral_energy) or feral_energy < 0.0:
            st.kill_gate["energy_invalid"] += 1
            st.kill_negative_feral_energy += 1
            _scream_publish(self.world, "kill_blocked", t=now, feral=self.id,
                            energy=repr(feral_energy))
            return orig(other, field)

        # Явный контроль энергобаланса
        st.kill_gate["passed"] += 1
        _e_before_kill = float(self.energy)
        self._x2_change("X2.scream_kill_feral_loss", 0.0)
        _e_after_kill = float(self.energy)
        _actual_feral_loss = _e_before_kill - _e_after_kill
        if abs(_actual_feral_loss - feral_energy) > 1e-6:
            st.kill_energy_balance_warnings += 1
            _scream_publish(self.world, "energy_balance_warning", t=now,
                            feral=self.id,
                            feral_energy=round(feral_energy, 8),
                            actual_loss=round(_actual_feral_loss, 8),
                            delta=round(_actual_feral_loss - feral_energy, 8))

        share = feral_energy / len(screamers)
        for s in screamers:
            s._x2_change("X2.scream_kill_reward", float(s.energy) + share)
            s._scream_saved_count = getattr(s, "_scream_saved_count", 0) + 1

        st.scream["kill"] += 1
        st.scream["kill_energy_moved"] += feral_energy
        _scream_publish(self.world, "kill", t=now, feral=self.id,
                        screamers=[s.id for s in screamers],
                        feral_energy_before=round(feral_energy, 8),
                        energy_distributed=round(share * len(screamers), 8),
                        share_each=round(share, 8),
                        actual_feral_loss=round(_actual_feral_loss, 8),
                        alarm_at_center=round(alarm_at_center, 4),
                        alarm_core=round(core, 4), pos=here)
        # «Мясо»: пока клетки ещё за фералом — энергия поля под ним уходит крикунам (X1→X2).
        _feral_meat(self.world, self, screamers, field, now)
        try:
            self.world.witness.record(self.id, "feral_killed_by_scream",
                                      screamers=[s.id for s in screamers])
        except Exception as exc:
            _scream_publish(self.world, "error", t=now, where="witness", err=repr(exc))
        try:
            self.world._record_death_drag(self, "scream_kill")
        except Exception as exc:
            _scream_publish(self.world, "error", t=now, where="death_drag", err=repr(exc))
        for x, y in list(self.cells):
            field[x, y, CH["owner"]] = 0
        self.cells = set()
        self.alive = False
        return True


class P832EngineMixin:
    """Слой p832 над EvolutionEngine: гомеостат поля выключен, сбор метрик, независимый аудит, шаг после семантики."""

    def _conservation_check(self, t):
        # Намеренно: гомеостат поля отключён, чтобы не маскировать расхождения.
        # Независимый аудит — res1/res2 в _audit_close_tick.
        return


    def _collect_metrics(self, t):
        m = super()._collect_metrics(t)
        if self.patterns:
            m.update(_flat(self))
        return m

    def _audit_close_tick(self, t, de_x1, res_x1, x2_step0):
        super()._audit_close_tick(t, de_x1, res_x1, x2_step0)
        st = _st(self)
        en = np.array([float(p.energy) for p in self.patterns if p.alive], dtype=np.float64)
        bad = int((~np.isfinite(en)).sum()) if en.size else 0
        fin = en[np.isfinite(en)] if en.size else en
        if fin.size:
            st.x2_min, st.x2_max = min(st.x2_min, float(fin.min())), max(st.x2_max, float(fin.max()))
        neg = int((fin < 0.0).sum()) if fin.size else 0
        if neg:
            st.x2_neg_ticks += 1
        if bad:
            st.x2_nonfinite_ticks += 1
            if st.x2_nonfinite_ticks == 1:
                print(f"[t={t}] ⚠️ NO-CLIP: не-конечная энергия у {bad} агентов. "
                      f"Сторож только наблюдает.")
        cur = {"cry": st.scream["total"], "repel": st.scream["repel"],
               "resp": st.scream["response_goal"],
               "reach": st.scream["response_reached"],
               "kill": st.scream["kill"],
               "spent": float(sum(st.spent.values())),
               "blocked": int(sum(v for k, v in st.actions.items()
                                  if "blocked" in k or "unpaid" in k))}
        pv = st.prev
        row = self._audit_rows[-1]
        row.update({
            "scr_cry": cur["cry"] - pv.get("cry", 0),
            "scr_repel": cur["repel"] - pv.get("repel", 0),
            "scr_resp": cur["resp"] - pv.get("resp", 0),
            "scr_reach": cur["reach"] - pv.get("reach", 0),
            "scr_kill": cur["kill"] - pv.get("kill", 0),
            "act_spent": cur["spent"] - pv.get("spent", 0.0),
            "act_blocked": cur["blocked"] - pv.get("blocked", 0),
            "x2_min": float(fin.min()) if fin.size else 0.0,
            "x2_neg": neg, "x2_nonfinite": bad,
            "kill_ebw": st.kill_energy_balance_warnings,
            "kill_neg_e": st.kill_negative_feral_energy,
            "intent_sw_blocked_pre": st.intent_switch_blocked_pre,
        })
        st.prev = cur

    def audit_summary(self):
        S = super().audit_summary()
        st = _st(self)
        # Солнце → поле X1 → агенты X2 (схема «Given_Flux»): приход, переданное агентам, невязка.
        # NB: «передано агентам» — всё, что агенты сняли с поля (Солнце + прежний запас поля),
        # а не только свет: Given_Flux ≠ Given_Flux_Extracted, это не второй источник.
        _x1 = S["x1"]["ledger"]
        _sun_in = float(_x1.get("X1.Given_Flux", {}).get("net", 0.0))
        _given = {k: -float(v["net"]) for k, v in _x1.items()
                  if k in ("X1.field_to_agent_harvest", "X1.division_ready_transfer", "X1.feral_meat_transfer")}
        _given_sum = float(sum(_given.values()))
        S["sun_flow"] = {
            "mode": Config.GIVEN_FLUX_MODE, "cycle": Config.GIVEN_FLUX_CYCLE,
            "period": int(Config.GIVEN_FLUX_PERIOD), "power": float(Config.GIVEN_FLUX_POWER),
            "radius": float(Config.GIVEN_FLUX_RADIUS),
            "sum_given_flux": _sun_in,
            "extracted_by_agents": _given, "sum_extracted_by_agents": _given_sum,
            "extracted_over_given": (_given_sum / _sun_in) if _sun_in > 0 else None,
            "residual_x1": dict(S["x1"]["residual"]), "residual_x2": dict(S["x2"]["residual"]),
        }
        S["patches"] = {
            "manifest": _MANIFEST,
            "seed_policy": {
                "given_seed": int(self.given_seed),
                "force_given_seed": Config.FORCE_GIVEN_SEED,
                "given_rng_enabled": bool(Config.ENABLE_GIVEN_SEED),
                "deterministic_seed": int(Config.DETERMINISTIC_SEED),
                "note": "Given-RNG сидируется на прогон; φ-шум фиксирован DETERMINISTIC_SEED",
            },
            "scream": {k: (float(v) if isinstance(v, float) else int(v))
                       for k, v in st.scream.items()},
            "actions": dict(st.actions),
            "action_spent": {k: round(float(v), 6) for k, v in st.spent.items()},
            "kill_gate": {**dict(st.kill_gate),
                          "alarm_max": st.alarm_max, "core_max": st.core_max,
                          "screamers_max": st.screamers_max,
                          "alarm_hist": dict(sorted(st.alarm_hist.items())),
                          "screamers_hist": dict(sorted(st.screamers_hist.items())),
                          "min_signal": KILL_MIN_SIGNAL_AT_CENTER,
                          "min_screamers": KILL_MIN_SCREAMERS,
                          "signal_radius": KILL_SIGNAL_RADIUS,
                          "core_radius": KILL_CORE_RADIUS,
                          "energy_balance_warnings": st.kill_energy_balance_warnings,
                          "negative_feral_energy": st.kill_negative_feral_energy},
            "intent_switch_blocked_pre": st.intent_switch_blocked_pre,
            "x2_guard": {
                "min": (st.x2_min if st.x2_min != float("inf") else None),
                "max": (st.x2_max if st.x2_max != float("-inf") else None),
                "neg_ticks": st.x2_neg_ticks,
                "nonfinite_ticks": st.x2_nonfinite_ticks,
                "fatigue_peak": st.fatigue_peak,
            },
            "events": {
                "emitted": dict(st.emitted),
                "dropped": dict(st.dropped),
                "cap_action": ACTION_EVENTS_CAP,
                "cap_scream": SCREAM_EVENTS_MAX,
            },
        }
        return S

    def _post_semantic_step(self, t):
        st = _st(self)
        st.bg_alarm = float(np.mean(self.field[:, :, CH["signal_alarm"]]))
        super()._post_semantic_step(t)
        now = int(self.age)
        if now % SCREAM_ALARM_DECAY_EVERY == 0:
            self.field[:, :, CH["signal_alarm"]] *= SCREAM_ALARM_DECAY
        if now % FATIGUE_DECAY_EVERY == 0:
            for p in self.patterns:
                if p.alive:
                    p._recover_fatigue()
                    p._tick_goal_cost()
        for p in self.patterns:
            if p.alive:
                _scream_try(p, self.field, now)
        _scream_check_response_arrival(self, now)

        if now % SNAPSHOT_EVERY == 0 and now > 0:
            flat = _flat(self)
            rich = getattr(self, "rich", None)
            if rich is not None and hasattr(rich, "events"):
                try:
                    rich.events.append({"t": now, "type": "p832_snapshot", **flat})
                except Exception:
                    st.dropped["rich_error"] += 1
            s = st.scream
            r_frac = (s["response_reached"] / s["response_goal"] * 100.0) \
                if s["response_goal"] else 0.0
            print(
                f"\n[t={now}] FATIGUE avg={flat['act_fatigue_avg']:.2f} "
                f"max={flat['act_fatigue_max']:.2f} "
                f"spent={flat['act_spent']:.2f}  "
                f"X2 min={flat['x2g_min']:.3f} max={flat['x2g_max']:.2f} "
                f"neg_ticks={flat['x2g_neg_ticks']} "
                f"nonfinite={flat['x2g_nonfinite_ticks']}\n"
                f"[SCREAM t={now}] CRY={s['total']}(feral:{s['feral']} rise:{s['rise']}) "
                f"hab_ticks={s['habituation_blocked']} "
                f"cost_block={s['cost_blocked']}\n"
                f"           REPEL={s['repel']}  "
                f"RESPONSE={s['response_goal']}→{s['response_reached']} "
                f"({r_frac:.0f}% дошли)  KILL={s['kill']} "
                f"energy_moved={s['kill_energy_moved']:.2f} "
                f"meat={s['meat_kills']}({s['meat_energy']:.2f}) "
                f"ebw={flat['scr_kill_ebw']} neg_e={flat['scr_kill_neg_e']}\n"
                f"[KILL-GATE t={now}] попыток={st.kill_gate['attempts']} "
                f"режет сигнал={st.kill_gate['signal_low']} "
                f"режет кричащие={st.kill_gate['screamers_low']} "
                f"прошло={st.kill_gate['passed']} | "
                f"alarm max={st.alarm_max:.3f} (порог {KILL_MIN_SIGNAL_AT_CENTER}), "
                f"core{KILL_CORE_RADIUS} max={st.core_max:.3f}, "
                f"кричащих max={st.screamers_max} (нужно {KILL_MIN_SCREAMERS})\n"
                f"[ACTIONS] " + " ".join(f"{k}:{v}" for k, v in sorted(st.actions.items())) + "\n"
                f"           intent_sw_blocked_pre={st.intent_switch_blocked_pre} "
                f"bg_alarm={st.bg_alarm:.4f}",
                flush=True,
            )

# ------------------------------------------------------------
# 10. Подключение слоёв (один раз, через extend_class — подкласс, а не патч)
