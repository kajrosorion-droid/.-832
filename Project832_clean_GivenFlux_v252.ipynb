    p.intent = dict(_raw_intent) if isinstance(_raw_intent, dict) else None
    p._forsaken = bool(data.get('_forsaken', False))
    p._scar_of_light = bool(data.get('_scar_of_light', False))

    p.concept_graph = ConceptGraph()

    import ast
    def _safe_parse_key(key_str):
        try:
            parsed = ast.literal_eval(key_str)
            if isinstance(parsed, (tuple, list)):
                return tuple(
                    float(x) if isinstance(x, (int, float)) else x
                    for x in parsed
                )
            return parsed
        except (ValueError, SyntaxError):
            return key_str

    for key_str, node_data in data.get('concept_graph', {}).items():
        key = _safe_parse_key(key_str)
        # === ИСПРАВЛЕНО: Загрузка eternal и embed правильной размерности ===
        p.concept_graph.nodes[key] = {
            "count": float(node_data['count']),
