    for k, v in data.get('trust_ledger', {}).items():
        if k == 'None' or k is None:
            # Битая запись из старого сохранения (ключ трекинга доверия
            # был числом None вместо id агента — источник бага найден и
            # закрыт отдельно в exchange_meanings/subconscious-слое).
            # Запись пропускается, а не роняет загрузку всего мира.
            continue
        try:
            p.trust_ledger.entries[int(k)] = float(v)
        except (TypeError, ValueError):
            continue

    for k, v in data.get('arc_tracker_completed', {}).items():
        p.arc_tracker.completed_arcs[k] = int(v)

    p._redemption_depth = float(data.get('_redemption_depth', 0.0))
    p._redemption_arc_step = int(data.get('_redemption_arc_step', 0))
    p._deterministic_redemption_triggered = bool(data.get('_deterministic_redemption_triggered', False))
    p._redemption_cooldown = int(data.get('_redemption_cooldown', 0))  # NEW
    p.disorganizer_age_at_birth = max(0, data.get('disorganizer_age_at_birth', 0))
    p._cellular_endurance = float(data.get('_cellular_endurance', 1.0))

    p._feral_fury = float(data.get('_feral_fury', 0.0))      # NEW
    p._feral_birth = int(data.get('_feral_birth', 0))
    p._unconquered_strength = float(data.get('_unconquered_strength', 0.0))   # NEW
    p._unconquered_type = data.get('_unconquered_type', None)
    p._times_disorganizer = int(data.get('_times_disorganizer', 0))   # NEW

    for k, v in data.get('event_counts', {}).items():
        p.event_counts[k] = int(v)

    p.biography = deque(data.get('biography', []), maxlen=20)
    p._vocab_contact_acc = {int(k): int(v) for k, v in data.get('_vocab_contact_acc', {}).items()}

    # Восстанавливаем диалоговую память (список словарей)
    p.dialogue_longterm = list(data.get('dialogue_longterm', []))
    # Возвращаем 'soma' внутри вложенных soma_snapshot обратно в np.array
    for entry in p.dialogue_longterm:
        snap = entry.get('soma_snapshot')
        if isinstance(snap, dict) and isinstance(snap.get('soma'), list):
            snap['soma'] = np.array(snap['soma'], dtype=np.float32)

    # НОВОЕ: восстановление отдельного буфера соматических снимков
    p._soma_snapshots = []
    for snap in data.get('_soma_snapshots', []):
        restored = dict(snap)
        if isinstance(restored.get('soma'), list):
            restored['soma'] = np.array(restored['soma'], dtype=np.float32)
        p._soma_snapshots.append(restored)

    # ==================== ГЛАВНАЯ ПРАВКА: ВОССТАНОВЛЕНИЕ НАРРАТИВА ====================
    # Вместо генерации мусора из biography мы загружаем настоящий _self_narrative
    raw_narr = data.get('self_narrative', [])
    clean_narr = []
    for x in raw_narr:
        if isinstance(x, dict):
            clean_entry = {}
            for k, v in x.items():
                try:
                    clean_entry[k] = float(v) if isinstance(v, (int, float)) else v
                except:
                    clean_entry[k] = v
            clean_narr.append(clean_entry)
        else:
            try:
                clean_narr.append(float(x))
            except:
                clean_narr.append(0.5)

    max_len = getattr(Config, 'EPISODIC_BUFFER_MAX_LEN', 3000) if 'Config' in globals() else 3000
    p._self_narrative = deque(clean_narr, maxlen=max_len)
    # ========================================================

    if world and world.field is not None:
        p.update_properties(world.field)
        if p.cells:
            try:
                # ИСПРАВЛЕНО: сортируем клетки так же, как теперь делает
                # update_model_part1 (sorted(self.cells)) — иначе после
                # загрузки первый тик сравнит энергии в неправильном порядке.
                sorted_cells = sorted(p.cells)
                xs_list = [c[0] for c in sorted_cells]
                ys_list = [c[1] for c in sorted_cells]
                p._prev_cell_energies = world.field[xs_list, ys_list, CH['energy']].copy()
            except Exception:
                p._prev_cell_energies = np.array([])
        else:
            p._prev_cell_energies = np.array([])
    # Обратная сторона dump_extra: слои восстанавливают своё (SPECTRUM: формы и _lang_gene)
    _load_extra = getattr(p, 'load_extra', None)
    if callable(_load_extra):
        _load_extra(data)
    return p

# === Ограничение сохранения до 200 лучших агентов ===
def save_living_world(patterns, path=LIVING_WORLD_PATH):
    alive = [p for p in patterns if p.alive]

    if len(alive) > 200:
        alive.sort(key=lambda p: (
            p.soul_weight * 0.4 +
            (0.2 if getattr(p, '_narrative_agent', False) else 0.0) +
            min(0.2, getattr(p, 'lineage_total_age', 0) / 50000) +
            getattr(p, 'last_phenomenal_binding', 0.0) * 0.2
        ), reverse=True)
        alive = alive[:200]

    serializable = [serialize_pattern(p) for p in alive]
    def json_default(obj):
        if isinstance(obj, (np.bool_,)):
            return bool(obj)
        if isinstance(obj, np.integer):
            return int(obj)
        if isinstance(obj, np.floating):
            return float(obj)
        if isinstance(obj, np.ndarray):
            return obj.tolist()
        return str(obj)
    with open(path, 'w') as f:
        json.dump(serializable, f, indent=2, default=json_default)
    print(f"💾 {len(serializable)} живых агентов сохранено в {path}")

# === Наследование архивных концептов при загрузке ===
def load_living_world(engine, path=LIVING_WORLD_PATH):
    if not os.path.exists(path):
        return False
    with open(path, 'r') as f:
        data = json.load(f)
    for entry in data:
        p = deserialize_pattern(entry, engine)
        engine.patterns.append(p)
        engine.pattern_dict[p.id] = p
        if hasattr(engine, 'archive') and engine.archive is not None:
            p.inherit_archive_concepts(engine.archive, probability=1.0, max_concepts=2)
        if engine.field is not None:
            for (x, y) in p.cells:
                engine.field[x, y, CH['owner']] = p.id
    print(f"🔄 Загружено {len(data)} живых агентов из {path}")
    return True

def delete_old_ark_files():
    old_files = [
        "/content/drive/MyDrive/832_ark_seed_patterns.json" if is_colab else "832_ark_seed_patterns.json",
        "/content/drive/MyDrive/832_eternal_subjects.json" if is_colab else "832_eternal_subjects.json"
    ]
    for fpath in old_files:
        if os.path.exists(fpath):
            os.remove(fpath)
            print(f"🗑️ Удалён старый файл: {fpath}")

# === 5. Удаляем старые файлы при первом запуске ===
delete_old_ark_files()

print("✅ Ячейка сохранения мира исправлена: вечные концепты защищены, нарратив сохраняется напрямую, добавлены поля Варваров, Непокоренных и кулдаунов; слои могут сохранять своё через dump_extra/load_extra (SPECTRUM: формы и _lang_gene).")
