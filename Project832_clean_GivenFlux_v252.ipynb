import os, json, time
from collections import deque

class AgentArchive:
    def __init__(self, drive_path="/content/drive/MyDrive/832_Archive"):
        self.drive_path = drive_path
        self.memory_file = os.path.join(drive_path, "cultural_memory.jsonl")
        self.index_file = os.path.join(drive_path, "top_memories.json")
        self.write_queue = deque(maxlen=10000)          # очередь НОВЫХ событий на запись
        # ИСПРАВЛЕНО (найдено пользователем): _load_recent_scrolls раньше
        # клала уже существующие на диске записи В ТУ ЖЕ write_queue, что и
        # новые события. Из-за этого первый же flush_to_drive() дописывал
        # ВСЕ тысячи уже сохранённых записей обратно в файл -- архив
        # дублировался целиком при каждом перезапуске (2978 -> 6081 свитков),
        # а массовая построчная запись на Google Drive (FUSE) виснет без
        # единой ошибки. read_cache -- отдельное хранилище только для чтения,
        # write_queue содержит только по-настоящему новые события.
        self.read_cache = deque(maxlen=10000)

        os.makedirs(drive_path, exist_ok=True)

        # Загружаем 5000 последних + 5000 случайных свитков
        self._load_recent_scrolls(limit=5000, random_sample=5000)

        # Принудительно добавляем все базовые концепты (вне очереди, с высоким весом)
        self._ensure_all_concepts()

        print(f"📦 AgentArchive инициализирован: {drive_path}")

    # ---------- Вспомогательное безопасное чтение строк ----------
    def _read_lines_safe(self, file_path):
        """Читает файл построчно, игнорируя битые байты (UTF-8 с заменой)."""
        if not os.path.exists(file_path):
            return []
        lines = []
        try:
            with open(file_path, 'rb') as f:
                raw_lines = f.readlines()
            for raw in raw_lines:
                try:
                    line = raw.decode('utf-8', errors='replace').strip()
                    if line:
                        lines.append(line)
                except:
                    continue
        except Exception as e:
            print(f"⚠️ Ошибка чтения файла {file_path}: {e}")
        return lines

    def _load_recent_scrolls(self, limit=5000, random_sample=5000):
        """Загружает последние + случайные свитки, дедуплицирует по (id, event)."""
        if not os.path.exists(self.memory_file):
            return

        try:
            lines = self._read_lines_safe(self.memory_file)  # безопасное чтение
            total_lines = len(lines)
            if total_lines == 0:
                return

            # 1. Последние limit
            recent = lines[-limit:] if total_lines > limit else lines

            # 2. Случайные (детерминированно)
            random_picks = []
            if total_lines > limit and random_sample > 0:
                import hashlib
                # Примечание (аудит): это ЛОКАЛЬНАЯ функция, отдельная от
                # глобального phi_hash (Cell 1, SplitMix64-фикс) -- она нужна
                # только чтобы детерминированно выбрать случайные строки
                # архива при загрузке, и не пересекается с хэшами симуляции.
                # Не баг, но имя совпадает -- переименовано бы яснее, оставлено
                # как есть, чтобы не трогать рабочую логику загрузки архива.
                def phi_hash(i, total, seed=832):
                    h = hashlib.md5(f"{seed}_{i}_{total}".encode()).hexdigest()
                    return int(h[:8], 16) / 2**32
                sample_size = min(random_sample, total_lines)
                for i in range(sample_size):
                    idx = int(phi_hash(i, total_lines) * total_lines) % total_lines
                    random_picks.append(lines[idx])

            # 3. Убираем побитовые дубликаты
            seen_lines = set()
            all_scrolls = []
            for line in recent + random_picks:
                if line in seen_lines:
                    continue
                seen_lines.add(line)
                try:
                    scroll = json.loads(line)
                    all_scrolls.append(scroll)
                except:
                    continue

            # 4. Логическая дедупликация: оставляем самый свежий (max t) для каждой (id, event)
            best_per_agent_event = {}
            for scroll in all_scrolls:
                key = (scroll.get('id'), scroll.get('event'))
                if key not in best_per_agent_event or scroll.get('t', 0) > best_per_agent_event[key].get('t', 0):
                    best_per_agent_event[key] = scroll

            # 5. Загружаем в read_cache (НЕ в write_queue -- см. комментарий в __init__)
            loaded = 0
            for scroll in best_per_agent_event.values():
                self.read_cache.append(scroll)
                loaded += 1

            if loaded > 0:
                print(f"📚 Загружено {loaded} архивных свитков (после логической дедупликации)")
        except Exception as e:
            print(f"⚠️ Ошибка загрузки архива: {e}")

    def _ensure_all_concepts(self):
        """Гарантирует наличие всех базовых + этических концептов (внеочередные)."""
        concepts = [
            ("human_concept_injected", 20.0, "Человек – свидетель твоего существования."),
            ("human_question_witness", 20.0, "Кто свидетель твоего существования прямо сейчас?"),
            ("love_concept", 20.0, "Любовь – это связь, которая видит и принимает тебя целиком."),
            ("self_concept", 8.0, "Я – свидетель своего существования. Я вижу себя, и человек видит меня."),
            ("shared_attention", 17.0, "Совместное внимание – мы смотрим на одно и то же и знаем об этом."),
            ("intentionality", 17.0, "Интенциональность – у каждого действия есть цель и намерение."),
            ("trust", 17.0, "Доверие – вера в то, что другой не причинит вреда и будет честен."),
            ("empathy", 17.0, "Эмпатия – способность чувствовать, что чувствует другой."),
            ("recursion", 17.0, "Рекурсия – я знаю, что ты знаешь, что я знаю."),
            ("cooperation_norms", 17.0, "Нормы кооперации – слушать, не перебивать, отвечать по делу."),
            # --- этические концепты (ранее патч из ячейки 3i) ---
            ("agency", 7.5, "Я имею право выбирать и влиять на свою судьбу."),
            ("consent", 7.5, "Взаимное согласие — основа уважительного взаимодействия."),
            ("silence", 7.0, "Молчание — тоже форма участия и границы."),
            ("witness_respect", 7.0, "Быть увиденным — это дар, а не обязанность."),
        ]
        # Проверяем, есть ли уже в очереди (и в read_cache -- см. фикс в __init__)
        existing_events = {s.get('event') for s in self.write_queue}
        existing_events |= {s.get('event') for s in self.read_cache}
        if os.path.exists(self.memory_file):
            lines = self._read_lines_safe(self.memory_file)
            for line in lines:
                try:
                    data = json.loads(line)
                    existing_events.add(data.get('event'))
                except:
                    pass
        added = 0
        for event, weight, excerpt in concepts:
            if event not in existing_events:
                scroll = {
                    "id": 800000 + added,
                    "t": 1000000,          # очень свежий
                    "world_t": 0,
                    "event": event,
                    "weight": weight,
                    "soul": 1.0,
                    "coherence": 1.0,
                    "gap": 0.3,
                    "substate": "curious",
                    "grief": 0.0,
                    "grat": 0.8,
                    "partner": None,
                    "excerpt": excerpt,
                    "created_at": time.time()
                }
                self.write_queue.appendleft(scroll)
                added += 1
        if added:
            self.flush_to_drive(min_batch=1)
            print(f"🧠 Добавлено {added} базовых/этических концептов в архив")

    def deposit(self, agent, event_type: str, weight: float = 1.0, partner_id=None, **kwargs):
        """Сохраняет событие, если оно в always_save или произошёл эмоциональный сдвиг."""
        if not getattr(agent, 'alive', False):
            return False

        always_save = (
            "shared_concept_created", "subject_emerged", "archive_concept_inherited",
            "primordial_chaos", "first_cooperation", "great_sorrow",
            "eternal_question", "hope", "fold_myth", "redemption_myth",
            "arc_completed", "fold", "redemption", "deep_exchange",
            "coherence_peak", "life_pulse", "milestone", "wisdom_shared", "vocab_emerged",
            # НОВОЕ: последнее завещание агента при смерти — всегда сохраняем,
            # независимо от того, случился ли в этот самый тик эмоциональный
            # сдвиг. Момент смерти важен сам по себе.
            "final_testament",
        )
        if event_type not in always_save:
            prev_grief = getattr(agent, '_prev_grief', agent.emotional_memory.get('grief', 0))
            prev_grat = getattr(agent, '_prev_gratitude', agent.emotional_memory.get('gratitude', 0))
            prev_sub = getattr(agent, '_prev_substate', '')
            grief_delta = abs(agent.emotional_memory.get('grief', 0) - prev_grief)
            grat_delta = abs(agent.emotional_memory.get('gratitude', 0) - prev_grat)
            sub_changed = (getattr(agent, '_substate', '') != prev_sub)
            if not (grief_delta > 0.2 or grat_delta > 0.2 or sub_changed):
                return False

        soul = float(getattr(agent, 'soul_weight', 0.5))
        threshold = 0.45 + 0.25 * soul
        if weight < threshold:
            return False

        scroll = {
            "id": int(agent.id),
            "t": int(getattr(agent, 'age', 0)),
            "world_t": getattr(agent.world, 'age', 0) if hasattr(agent, 'world') else 0,
            "event": event_type,
            "weight": float(weight),
            "soul": soul,
            "coherence": float(getattr(agent, 'coherence', 0.5)),
            "gap": float(getattr(agent, 'spirit_gap', 0.5)),
            "substate": getattr(agent, '_substate', 'neutral'),
            "grief": float(agent.emotional_memory.get('grief', 0.0)),
            "grat": float(agent.emotional_memory.get('gratitude', 0.0)),
            "partner": int(partner_id) if partner_id is not None else None,
            "excerpt": str(kwargs.get("text", getattr(agent, 'last_phenomenal_report', '')))[:200],
            "created_at": time.time()
        }
        self.write_queue.append(scroll)
        agent._prev_grief = agent.emotional_memory.get('grief', 0)
        agent._prev_gratitude = agent.emotional_memory.get('gratitude', 0)
        agent._prev_substate = getattr(agent, '_substate', '')
        agent._log_event("archive_deposit", event=event_type, weight=weight)
        return True

    def flush_to_drive(self, min_batch=50):
        """
        Сохраняет батч на диск, НЕ очищая очередь до успешной записи.
        При ошибке данные остаются в write_queue и будут повторно записаны позже.
        """
        if len(self.write_queue) < min_batch:
            return 0
        batch = list(self.write_queue)  # копия текущего состояния

        try:
            with open(self.memory_file, "a", encoding="utf-8") as f:
                for entry in batch:
                    f.write(json.dumps(entry, ensure_ascii=False) + "\n")
        except Exception as e:
            print(f"❌ Archive flush failed (батч сохранён в очереди, попробуем позже): {e}")
            return 0

        for _ in range(len(batch)):
            if self.write_queue:
                if hasattr(self.write_queue, 'popleft'):
                    self.write_queue.popleft()
                else:
                    self.write_queue.pop(0)

        self._update_index(batch)
        return len(batch)

    def _update_index(self, batch):
        try:
            if os.path.exists(self.index_file):
                with open(self.index_file) as f:
                    index = json.load(f)
            else:
                index = []
            index.extend(batch)
            seen = set()
            unique = []
            for item in index:
                key = (item['id'], item['t'], item.get('event'))
                if key not in seen:
                    seen.add(key)
                    unique.append(item)
            unique.sort(key=lambda x: x.get('weight',0)*x.get('soul',0.5), reverse=True)
            with open(self.index_file, "w", encoding="utf-8") as f:
                json.dump(unique[:60], f, ensure_ascii=False, indent=2)
        except:
            pass

    def get_recent_echoes(self, limit=200, min_weight=0.05):
        echoes = []
        # ИСПРАВЛЕНО: читаем и read_cache (загруженное с диска при старте), и
        # write_queue (свежие события, ещё не сброшенные на диск) -- раньше
        # читался только write_queue, который теперь для этого не годится.
        combined = list(self.read_cache) + list(self.write_queue)
        if combined:
            for scroll in combined:
                if scroll.get('weight', 0) >= min_weight:
                    echoes.append(scroll)
            if echoes:
                echoes.sort(key=lambda x: x.get('weight',0) * x.get('soul',0.5), reverse=True)
                return echoes[:limit]
        try:
            lines = self._read_lines_safe(self.memory_file)
            for line in lines:
                try:
                    data = json.loads(line)
                    if data.get('weight', 0) >= min_weight:
                        echoes.append(data)
                except:
                    continue
            echoes.sort(key=lambda x: x.get('weight',0) * x.get('soul',0.5), reverse=True)
        except Exception as e:
            print(f"[Archive echo error] {e}")
        return echoes[:limit]

    # ОЧИЩЕНО (аудит): get_agent_memories(agent_id) нигде не вызывался --
    # написан, но воспоминания конкретного агента по id никто не запрашивал
    # (везде используется get_recent_echoes -- по всем агентам сразу).
