        self.x2_neg_ticks = self.x2_nonfinite_ticks = 0
        self.fatigue_peak = 0.0
        self.emitted, self.dropped, self.prev = Counter(), Counter(), {}
        self.kill_energy_balance_warnings = 0
        self.kill_negative_feral_energy = 0
        self.intent_switch_blocked_pre = 0

_P832_LAST = {"st": None}
_ORPHAN = _P832State()

def _st(world):
    if world is None:
        return _ORPHAN
    st = world.__dict__.get("_p832")
    if st is None:
        st = _P832State()
        world._p832 = st
        _P832_LAST["st"] = st
        g = globals()
        g["SCREAM_STATS"], g["ACTION_STATS"], g["SCREAM_EVENTS"] = st.scream, st.actions, st.events
    return st

def _emit(world, st, evt, kind, cap):
    st.emitted[kind] += 1
    if st.emitted[kind] > cap:
        st.dropped[kind] += 1
        return
    rich = getattr(world, "rich", None) if world is not None else None
    if rich is not None and hasattr(rich, "events"):
        try:
            rich.events.append(evt)
        except Exception:
            st.dropped["rich_error"] += 1

_DISC = {}

def _disc(R):
    d = _DISC.get(R)
    if d is None:
        r = np.arange(-R, R + 1)
        dx, dy = np.meshgrid(r, r, indexing="ij")
        d2 = dx * dx + dy * dy
        m = d2 <= R * R
        d = (dx[m].astype(np.int64), dy[m].astype(np.int64),
             np.sqrt(d2[m]).astype(np.float64))
        _DISC[R] = d
    return d

def _disc_mean(chan, cx, cy, R, W):
    dx, dy, _ = _disc(R)
    return float(chan[(cx + dx) % W, (cy + dy) % W].mean(dtype=np.float64))

