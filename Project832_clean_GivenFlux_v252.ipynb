    if not agent1.concept_graph.nodes or not agent2.concept_graph.nodes:
        return None
    top1 = max(agent1.concept_graph.nodes.items(), key=lambda x: x[1]['count'])
    top2 = max(agent2.concept_graph.nodes.items(), key=lambda x: x[1]['count'])
    s1, s2 = top1[0], top2[0]
