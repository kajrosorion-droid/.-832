class _P832State:

    def __init__(self):
        self.scream, self.actions, self.spent = Counter(), Counter(), Counter()
        self.events, self.recent, self.bg_alarm = [], {}, 0.0
        self.kill_gate, self.alarm_hist, self.screamers_hist = Counter(), Counter(), Counter()
