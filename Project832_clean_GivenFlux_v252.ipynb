def imprint_contacts(owner_grid, radius, wall_x=None):
    own = np.asarray(owner_grid).astype(np.int32)
    occ = own > 0
    if not occ.any():
        return {}
    side = None
    if wall_x is not None:
        side = np.broadcast_to((np.arange(own.shape[0])[:, None] < wall_x), own.shape)
    got_a, got_b = [], []
    for dx in range(-radius, radius + 1):
        for dy in range(-radius, radius + 1):
            if dx == 0 and dy == 0:
                continue
            sh = np.roll(own, shift=(-dx, -dy), axis=(0, 1))
            m = occ & (sh > 0) & (own != sh)
            if side is not None:
                m &= (side == np.roll(side, shift=(-dx, -dy), axis=(0, 1)))
            if m.any():
                got_a.append(own[m])
                got_b.append(sh[m])
    if not got_a:
        return {}
    a = np.concatenate(got_a).astype(np.int64)
    b = np.concatenate(got_b).astype(np.int64)
    K = int(max(a.max(), b.max())) + 1
    uniq, cnt = np.unique(a * K + b, return_counts=True)
    return {(int(k // K), int(k % K)): int(c) for k, c in zip(uniq, cnt)}


def imprint_receptivity(a):
    gh, sh = a._gap_history, a._soul_history
    if len(gh) < 8 or len(sh) < 8:
        return 1.0
    d_gap = (gh[-1] + gh[-2] + gh[-3] + gh[-4]) / 4.0 - (gh[-5] + gh[-6] + gh[-7] + gh[-8]) / 4.0
    d_soul = (sh[-1] + sh[-2] + sh[-3] + sh[-4]) / 4.0 - (sh[-5] + sh[-6] + sh[-7] + sh[-8]) / 4.0
    return float(1.0 + np.tanh(-Config.IMPRINT_RECEPT_GAP * d_gap + Config.IMPRINT_RECEPT_SOUL * d_soul))


def encounter_touch(a, b, imp):
    dB = _imp_c01(_imp_f(b.emotional_memory.get("grief", 0.0)))
    grief_a = _imp_c01(_imp_f(a.emotional_memory.get("grief", 0.0)))
    scar_a = _imp_c01(_imp_f(a.epistemic_scar))
    wound = 1.0 - (1.0 - scar_a) * (1.0 - grief_a)
    coh = _imp_c01(_imp_f(a.coherence))
    e = _imp_c01(_imp_f(a._cellular_endurance, 1.0))
    loud = dB * dB
    res = dB * wound
    conf = loud * (1.0 - wound) * coh
    over = loud * (1.0 - e) ** 2
    prior = (imp.danger * (1.0 - dB)) if imp is not None else 0.0
    return res, conf, over, prior


def encounter_strain(res, conf, over, prior, w):
    s = w * (Config.IMPRINT_G_RES * res + Config.IMPRINT_G_CONF * conf
             + Config.IMPRINT_G_OVER * over + Config.IMPRINT_G_PRIOR * prior)
    return float(min(1.0, s))


def encounter_response(a, b, imp, w=1.0):
    res, conf, over, prior = encounter_touch(a, b, imp)
    rec = imprint_receptivity(a)
    strain = encounter_strain(res * rec, conf, over * (2.0 - rec), prior, w)
    steer = 0.0 if imp is None else float(imp.gravity)
    return strain, steer


def _grow(x, target, rate, heal):
    r = rate if target > x else rate * heal
    return x + r * (target - x)


def _grow_signed(x, target, rate, heal):
    r = rate if abs(target) > abs(x) else rate * heal
    return x + r * (target - x)


def imprint_contact_update(a, b, w, t):
    imp = a.imprints.get(b.id)
    repeat = imp is not None
    res, conf, over, prior = encounter_touch(a, b, imp)
    rec = imprint_receptivity(a)
    res_eff = res * rec
    over_eff = over * (2.0 - rec)
    s = encounter_strain(res_eff, conf, over_eff, prior, w)
    s_stranger = encounter_strain(res_eff, conf, over_eff, 0.0, w)
    danger_obs = _imp_c01(s)
    if imp is None:
        imp = a.imprints.open(b.id)
    g0, r0, d0 = imp.gravity, imp.resonance, imp.danger
    rate = Config.IMPRINT_RATE * w
    heal = Config.IMPRINT_HEAL
    imp.resonance = _grow(imp.resonance, res, rate, heal)
    imp.danger = _grow(imp.danger, danger_obs, rate, heal)
    imp.gravity = _grow_signed(imp.gravity, res_eff - danger_obs, rate, heal)
    imp.n += 1
    imp.last_t = t
    a.imprints.trim(Config.IMPRINT_CAP)
    return (s, res, conf, over, prior, s_stranger, repeat,
            rec, imp.gravity - g0, imp.resonance - r0, imp.danger - d0)


def imprint_pull(a):
    book = a.imprints.by_other
    world = a.world
    if not book or world is None or not a.cells:
        return 0.0, 0.0
    ws = Config.WORLD_SIZE
    cx, cy = a.get_center()
    px = py = 0.0
    for bid in sorted(book):
        g = book[bid].gravity
        if g == 0.0:
            continue
        b = world.pattern_dict.get(bid)
        if b is None or not b.alive or not b.cells:
            continue
        bx, by = b.get_center()
        dx = (bx - cx + ws / 2) % ws - ws / 2
        dy = (by - cy + ws / 2) % ws - ws / 2
        d = float(np.hypot(dx, dy))
        if d < 1e-6 or d > Config.IMPRINT_PULL_RANGE:
            continue
        k = g / (1.0 + d / Config.IMPRINT_PULL_SCALE) / d
        px += k * dx
        py += k * dy
    return px, py


