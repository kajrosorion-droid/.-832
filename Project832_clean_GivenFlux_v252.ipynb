    # Ярус «объявлено по построению»: приход — Солнце и прежняя инжекция (явные строки притока),
    # выход — диссипация (явные строки стоимости). Это классификация, а не измеренное пересечение границы:
    # измеренный внешний приход подтверждён только для X1.Given_Flux (сумма намеренного vs измеренного).
    # Всё остальное (бонусы X2, перезапись, события, регуляторы, физика поля, расхождение пар) —
    # «без установленного механизма» и внешним обменом не называется.
    _BOUNDARY_DECLARED_IN = ('sun', 'legacy_inflow')
    _BOUNDARY_DECLARED_OUT = ('dissipation',)
    _BOUNDARY_PAIRS = (
        ('сбор излишка поля агентом', 'X1.field_to_agent_harvest', 'X2.field_to_agent_harvest'),
        ('ферал впитывает у жертвы', 'feral.prey_drain_FIELD_TO_VICTIM', 'X2.feral_intent_absorbed'),
