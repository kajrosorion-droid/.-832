# Cell 3e: SelfRegulationEngine v3.4 (оптимизированная скука, разделение ответственности)
import numpy as np
from collections import deque, Counter

# АУДИТ: из 25 методов этого класса 11 нигде не вызывались (написаны, но не
# подключены). Подключено 6 (см. Cell 5 Pattern.can_divide/should_die и
# Cell 10 EvolutionEngine.spawn_unknown_patterns/scar-injection/validate_invariants):
# can_agent_divide, get_max_age, get_max_cells_per_agent, get_unknown_spawn_prob,
# get_agent_scar_multiplier (сигнатура расширена параметром base= -- см. ниже),
# get_validation_interval.
# Осознанно НЕ подключены (вытеснены более новой/богатой логикой в других местах):
# get_given_probability (замена в update_model: base_prob = stagnation*energy_factor*...),
# get_form_concepts_interval (замена: form_concepts() гейтится по age%5/CRISIS/tension).
# get_semantic_exchange_interval -- НЕ подключён, там осознанный патч
# ('ПРАВКА 1: интервал 3 шага для ускоренного обмена'), трогать не стоит.
# get_soul_recovery_bonus -- спорно: добавил бы автоматический бонус агентам при
# коллапсе популяционной души, это тот же класс 'невидимой руки', который
# сам проект критиковал (emergency_rescue/sanctuary) -- решение за автором проекта.
# get_subject_check_interval -- возвращал константу 200 без единой связи с
# состоянием где-либо ещё в проекте; похоже на несостоявшуюся задумку, а не
# забытый провод -- подключать не к чему.
class SelfRegulationEngine:
    def __init__(self):
        self.reset()

    def reset(self):
        self.boredom = 0.0
        self.avg_gap = 0.5
        self.avg_soul = 0.5
        self.energy_drift = 0.0
        self.population = 0
        self.avg_binding = 0.0
        self.fatigue_ratio = 0.0
        self.phase = "growth"
        self.turbulence_factor = 1.0
        self.low_gap_pressure = 0.0
        self.soul_protection_active = False
        self._smooth_gap = deque(maxlen=10)
        self._smooth_soul = deque(maxlen=10)
        self._phase_history = deque(maxlen=500)
        self._obs_gap_zones = {'confused': 0, 'blind': 0}
        self.field_ref = None
        self._patterns_ref = None
        # Состояние calculate_boredom (Cell 2) живёт в атрибуте функции, то есть в
        # процессе, а не в мире: без сброса второй engine.run() в той же сессии
        # стартует с чужим baseline скуки.
        reset_boredom_baseline()

    def update_system_metrics(self, field, patterns, drift, t):
        # 1. Фильтруем живых агентов
        alive = [p for p in patterns if p.alive]
        self.population = len(alive)
        self.field_ref = field
        self._patterns_ref = patterns

        # 2. Обновляем скуку (только по живым, чтобы снизить нагрузку)
        self.boredom = calculate_boredom(alive, field) if alive else 0.0

        # 3. Остальные метрики
        confused = 0
        blind = 0
        if alive:
            gaps = []
            souls = []
            bindings = []
            fatigued = 0
            for p in alive:
                gap = float(getattr(p, 'spirit_gap', 0.5))
                gaps.append(gap)
                souls.append(float(getattr(p, 'soul_weight', 0.5)))
                bindings.append(float(getattr(p, 'last_phenomenal_binding', 0.5)))
                if getattr(p, '_kinematic_fatigue', 0.0) > 0.3:
                    fatigued += 1
                if gap > 0.6:
                    blind += 1
                elif gap > 0.3:
                    confused += 1

            self._obs_gap_zones['confused'] = confused
            self._obs_gap_zones['blind'] = blind

            self._smooth_gap.extend(gaps)
            self._smooth_soul.extend(souls)
            self.avg_gap = float(np.mean(self._smooth_gap)) if self._smooth_gap else 0.5
            self.avg_soul = float(np.mean(self._smooth_soul)) if self._smooth_soul else 0.5
            self.avg_binding = float(np.mean(bindings))
            self.fatigue_ratio = fatigued / max(1, self.population)
        else:
            self.avg_gap = self.avg_soul = self.avg_binding = self.fatigue_ratio = 0.5
            self._obs_gap_zones['confused'] = 0
            self._obs_gap_zones['blind'] = 0

        self.energy_drift = abs(drift)
        self.low_gap_pressure = max(0.0, (0.45 - self.avg_gap) * 3.5)
        self.soul_protection_active = (self.avg_soul < 0.25)

        # 4. Определение фазы
        if self.avg_gap < 0.15:
            self.phase = "stagnation"
            self.turbulence_factor = min(2.5, 1.0 + self.low_gap_pressure * 2.0)
        elif self.low_gap_pressure > 0.3:
            self.phase = "stagnation"
            if self.soul_protection_active:
                self.turbulence_factor = min(1.8, 1.0 + self.low_gap_pressure * 1.0)
            else:
                self.turbulence_factor = min(2.5, 1.0 + self.low_gap_pressure * 1.8)
        elif self.boredom > 0.6 and self.avg_gap < 0.4:
            self.phase = "stagnation"
            self.turbulence_factor = min(1.8, 1.0 + self.boredom * 1.0)
        elif self.energy_drift > 300 or self.fatigue_ratio > 0.25:
            self.phase = "crisis"
            self.turbulence_factor = 0.7
        elif self.population < 25:
            self.phase = "recovery"
            self.turbulence_factor = 1.3
        else:
            self.phase = "growth"
            self.turbulence_factor = 1.0

        self._phase_history.append(self.phase)

    # --- остальные методы без изменений ---
    def get_phase_log(self):
        if not self._phase_history:
            return "no data"
        cnt = Counter(self._phase_history)
        total = len(self._phase_history)
        return " | ".join(
            f"{phase}: {cnt[phase]}/{total} ({cnt[phase]/total:.1%})"
            for phase in ["growth", "stagnation", "crisis", "recovery"] if cnt[phase] > 0
        )

    def is_stuck_in_phase(self, phase_name, min_steps=150):
        if len(self._phase_history) < min_steps:
            return False
        return all(p == phase_name for p in list(self._phase_history)[-min_steps:])

    def get_unknown_spawn_interval(self):
        base = max(3, int(8 - self.boredom * 5))
        return max(1, int(base / self.turbulence_factor))

    def get_labyrinth_interval(self):
        if self.phase == "crisis":
            return 100
        if self.population > 70:
            return 25
        return 50

    def get_labyrinth_penalty_multiplier(self):
        base = 1.0
        if self.avg_gap < 0.35:
            base += (0.35 - self.avg_gap) * 7.0
        if self.soul_protection_active:
            base = min(base, 2.2)
        if self.phase == "crisis":
            base *= 0.8
        return np.clip(base, 0.8, 3.0)

    def free_cells(self):
        """Сколько клеток карты никому не принадлежит (owner == 0)."""
        owner = self.field_ref[:, :, CH['owner']]
        return int(owner.size - np.count_nonzero(owner))

    def space_brake(self):
        """Тормоз по занятости карты: 1.0 — места полно, 0.0 — карта забита.
        Линейно падает между POP_FILL_SOFT и POP_FILL_HARD (доля занятых клеток)."""
        if self.field_ref is None:
            return 1.0
        owner = self.field_ref[:, :, CH['owner']]
        fill = np.count_nonzero(owner) / owner.size
        span = max(1e-6, Config.POP_FILL_HARD - Config.POP_FILL_SOFT)
        return float(np.clip((Config.POP_FILL_HARD - fill) / span, 0.0, 1.0))

    def get_dynamic_pop_cap(self):
        """Ёмкость среды в агентах: живые сейчас + сколько новорождённых
        поместится в свободное место. Фиксированного числа нет: потолок
        двигают размеры агентов, смерти и охота феролов (они освобождают клетки)."""
        if self.phase == "crisis":
            return max(20, int(self.population * 0.7))
        if self.phase == "recovery":
            return self.population + 40
        if self.field_ref is None:
            return self.population + 40
        return self.population + self.free_cells() // Config.POP_SPAWN_FOOTPRINT

    def get_division_capacity(self, current_pop):
        """Сколько делений за тик. Малую популяцию подталкиваем, дальше темп
        режет тормоз занятости карты; в кризисе — не больше одного."""
        if current_pop < 15:
            return 15
        if current_pop < 30:
            return 10
        if current_pop < 50:
            return 8
        if current_pop < 70:
            return 6
        base = 4 if current_pop < 100 else 5
        if self.phase == "crisis" and current_pop >= 100:
            base = 1
        return int(base * self.space_brake() + 0.5)

    def get_division_energy_threshold(self):
        if self.phase == "recovery":
            return 0.015
        if self.phase == "crisis":
            return 0.05
        if self.population < 30:
            return 0.02
        return 0.03

    def can_agent_divide(self, agent):
        if self.phase == "crisis":
            return False
        if agent.age < 15:
            return False
        if agent.soul_weight < 0.25:
            return False
        if agent.energy < self.get_division_energy_threshold():
            return False
        if self.phase == "stagnation":
            return agent.soul_weight > 0.35
        return True

    def get_agent_scar_multiplier(self, agent, base=None):
        # ПОДКЛЮЧЕНО (аудит): раньше нигде не вызывался. base= добавлен, чтобы
        # вызывающий код мог передать уже посчитанный (и, возможно, дополнительно
        # отмасштабированный) scar_mult вместо пересчёта с нуля -- см. место
        # вызова в EvolutionEngine, где к get_scar_injection_multiplier() уже
        # применяется *4.4. Кап теперь ОТНОСИТЕЛЬНЫЙ (x2 от base), а не
        # абсолютной константой 12.0 -- та константа была откалибрована под
        # немасштабированный base (~2.5-6.0) и не имела смысла при base*4.4.
        if base is None:
            base = self.get_scar_injection_multiplier()
        if getattr(agent, 'age', 0) > 1000:
            return base * 2.0
        return base

    def get_validation_interval(self):
        # ИСПРАВЛЕНО: метод был реально удалён при первой чистке этой ячейки,
        # но комментарий в шапке класса (и вызов в Cell 10, validate_invariants)
        # уже считал его подключённым -- забыл вернуть само тело. AttributeError
        # на первом прогоне. Восстановлено.
        if self.energy_drift > 500:
            return 1
        if self.energy_drift > 150:
            return 5
        return 15

    def get_energy_injection_multiplier(self):
        if self.phase == "recovery":
            return 2.5
        if self.phase == "crisis":
            return 1.5
        if self.population > 80:
            return 0.8
        return 1.0

    def get_scar_injection_multiplier(self):
        if self.soul_protection_active:
            return min(3.5, 2.5 + self.low_gap_pressure * 1.2)
        if self.low_gap_pressure > 0.4:
            return min(6.0, 4.5 + self.low_gap_pressure * 2.5)
        if self.phase == "stagnation":
            return 4.0 + self.boredom * 1.5
        elif self.phase == "crisis":
            return 2.5
        elif self.phase == "recovery":
            return 3.5
        else:
            return 3.0 + self.boredom * 0.5

    def get_soul_recovery_multiplier(self):
        if self.avg_soul < 0.25:
            return 3.0
        elif self.avg_soul < 0.40:
            return 2.0
        return 1.0

    def get_social_decay_rate(self, crisis_level):
        if self.phase == 'crisis':
            return 0.88
        if self.phase == 'stagnation':
            return 0.96
        return 0.92 if crisis_level > 0.5 else 0.94

    def get_aging_rate_multiplier(self):
        if self.phase == "crisis":
            return 1.1
        if self.phase == "stagnation":
            return 1.15
        if self.phase == "recovery":
            return 0.75
        if self.soul_protection_active:
            return 0.65
        return 1.0

    def get_hunger_threshold(self):
        """Порог плотности, выше которого растёт голод (compute_hunger_multiplier).
        Чем забитее карта, тем ближе порог к 70% популяции; на свободной карте
        голода от скученности нет."""
        return self.population * (0.7 + 0.3 * self.space_brake())


    def get_max_age(self, agent):
        base_age = 600
        soul = getattr(agent, 'soul_weight', 0.5)
        base_age += int(soul * 200)
        if getattr(agent, '_narrative_agent', False):
            base_age += 200
        endurance = getattr(agent, '_cellular_endurance', 1.0)
        if endurance < 0.3:
            base_age -= 150
        if self.phase == "crisis":
            base_age = int(base_age * 0.8)
        elif self.phase == "recovery":
            base_age = int(base_age * 1.3)
        return max(100, base_age)

    def get_max_cells_per_agent(self):
        if self.phase == "recovery":
            return 200
        if self.phase == "crisis":
            return 80
        if self.phase == "stagnation":
            return 120
        return 140 + int(self.avg_soul * 30)

    def get_unknown_spawn_prob(self):
        base = (0.01 + self.boredom * 0.02) * self.turbulence_factor
        if self.avg_gap < 0.2:
            base += 0.04 * (0.2 - self.avg_gap) * 5.0
        if self.soul_protection_active:
            base *= 0.7
        if self.energy_drift > 500:
            base *= 0.5
        if self.population > 70:
            base *= 0.8
        if self.population < 30:
            base *= 1.5
        if self.phase == "crisis":
            base *= 0.5

        confused_blind_ratio = (self._obs_gap_zones.get('confused', 0) + self._obs_gap_zones.get('blind', 0)) / max(1, self.population)
        if confused_blind_ratio > 0.4:
            base *= 0.7

        return min(0.06 if self.population > 40 else 0.09, base)

# Создаём глобальный экземпляр
selfreg = SelfRegulationEngine()
