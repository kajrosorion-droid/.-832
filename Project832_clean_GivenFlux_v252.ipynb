from collections import Counter, deque

for _need in ("Pattern", "EvolutionEngine", "Config", "CH", "phi_hash", "_stable_hash"):
    if _need not in globals():
        raise RuntimeError(f"{_need} не найден: выполни ячейки ядра выше (Cell 1–4a).")
if any(k.__name__ in ("SpectrumMixin", "SignalMixin", "SignalChoiceMixin", "FeralObsPatternMixin", "FormCreditPatternMixin")
       for k in Pattern.__mro__):
    raise RuntimeError("В памяти уже есть слой сигналов (старый или этот). Runtime -> Restart session и запуск сверху вниз.")
for _n in ("LedgerEngine", "RichEngine"):
    _c = globals().get(_n)
    if _c is not None and not any(k.__name__ == "SignalEngineMixin" for k in _c.__mro__):
        raise RuntimeError(f"{_n} уже определён без SIGNAL. Эту ячейку нужно поставить ВЫШЕ Ledger/RichEngine, "
                           f"потом Runtime -> Restart session и запуск сверху вниз.")
if "extend_class" not in globals():
    def extend_class(base, mixin):
        if any(k.__name__ == mixin.__name__ for k in base.__mro__):
            return base
        return type(base.__name__, (mixin, base),
                    {"__module__": base.__module__, "__qualname__": base.__qualname__, "__doc__": base.__doc__})

