# ============================================================
# FERAL BOUNTY v1.1 — бонус агентам за убийство феролов (scream_kill)
#
# ГДЕ СТОИТ: рядом с SIGNAL→CHOICE — после FERAL v3, ВЫШЕ Ledger/RichEngine и ДО ячейки p832.
# Ячейка p832 (NO-CLIP + SCREAM) сама запускает прогон (RUN_ARMS в конце), поэтому всё, что стоит после неё,
# выполняется уже после эксперимента. Никаких запусков эта ячейка не делает: только подключает слой.
# После вставки: Runtime -> Restart session и запуск сверху вниз.
#
# Как работает (хуки на то, что p832 не подменяет):
#   • Pattern._x2_change: p832 при убийстве ферала зовёт у каждого крикуна
#     s._x2_change("X2.scream_kill_reward", ...) — запоминаем убийц в буфер.
#   • EvolutionEngine._record_death_drag(p, "scream_kill"): p = убитый ферал. Тут выдаём награду
#     всем запомненным убийцам и очищаем буфер.
#
# Награда каждому убийце:
#   • gratitude += FB_GRATITUDE · (1 + FB_FURY_SCALE · fury_norm)   — опаснее ферал → больше бонус
#   • grief     -= FB_GRIEF_RELIEF
#   • взаимное доверие 'helpful' между участниками убийства
#   • FB_ENERGY_BONUS (по умолчанию 0.0) — ОПЦИЯ: энергия из ничего. Пишется в леджер как
#     'X2.feral_bounty_CREATION'. Энергию ферала крикуны и так делят (X2.scream_kill_reward),
#     поэтому по умолчанию бонус НЕ энергетический: закон 832 не трогаем.
#
# Бонус меняет mood и trust → SIGNAL→CHOICE учится на этих дельтах (цели, ведущие к убийству, получают плюс).
# Выключатель: Config.FB_ENABLE. Отчёт: fb_report(); summary['feral_bounty'] в audit; fb_* в metrics_history.
# ============================================================
import numpy as np
from collections import Counter

for _need in ("Pattern", "EvolutionEngine", "extend_class", "Config"):
    if _need not in globals():
        raise RuntimeError(f"{_need} не найден: выполни ячейки движка и FERAL v3 перед этой.")
if not hasattr(Pattern, "_x2_change"):
    raise RuntimeError("Pattern._x2_change не найден.")
if not hasattr(EvolutionEngine, "_record_death_drag"):
    raise RuntimeError("EvolutionEngine._record_death_drag не найден.")
if any(k.__name__ == "FeralBountyMixin" for k in Pattern.__mro__):
    raise RuntimeError("FERAL BOUNTY уже подключён. Runtime -> Restart session и запуск сверху вниз.")
for _n in ("LedgerEngine", "RichEngine"):
    _c = globals().get(_n)
    if _c is not None and not any(k.__name__ == "FeralBountyEngineMixin" for k in _c.__mro__):
        raise RuntimeError(f"{_n} уже определён без слоя FERAL BOUNTY. Поставь эту ячейку ВЫШЕ Ledger/RichEngine.")
if "_p832_feral_exec" in globals():
    raise RuntimeError("Ячейка p832 уже выполнена (она и есть запуск). Эту ячейку надо ВЫШЕ неё, потом Restart session.")

_FB_DEFAULTS = {
    'FB_ENABLE': True,
    'FB_GRATITUDE': 0.15,      # базовый прирост gratitude на убийцу
    'FB_FURY_SCALE': 1.0,      # (1 + SCALE·fury_norm); fury_norm = (fury-1)/2 в [0,1]
    'FB_GRIEF_RELIEF': 0.05,   # снижение grief на убийцу
    'FB_TRUST': True,          # взаимное 'helpful' между участниками убийства
    'FB_TRUST_MULT': 1.0,
    'FB_ENERGY_BONUS': 0.0,    # ОПЦИЯ (>0 создаёт энергию; пишется как X2.feral_bounty_CREATION)
    'FB_VERBOSE': 3,           # сколько первых убийств напечатать
}
for _k, _v in _FB_DEFAULTS.items():
    if not hasattr(Config, _k):
        setattr(Config, _k, _v)

FB = {'world': None, 'stats': Counter(), 'last_err': None, 'buf': None}

def _fb_sync(world):
    if FB['world'] != id(world):
        FB['world'] = id(world)
        FB['stats'] = Counter()
        FB['last_err'] = None
        FB['buf'] = None

def _fb_err(e):
    FB['stats']['errors'] += 1
    if FB['last_err'] is None:
        print(f"[FERAL-BOUNTY] ⚠️ {e!r}", flush=True)
    FB['last_err'] = repr(e)

def _fb_note_killer(world, p):
    _fb_sync(world)
    now = int(getattr(world, 'age', 0))
    buf = FB['buf']
    if buf is None or buf['t'] != now:          # хвост прошлого тика не должен попасть в новое убийство
        if buf is not None and buf['killers']:
            FB['stats']['buf_stale_dropped'] += 1
        buf = FB['buf'] = {'t': now, 'killers': []}
    buf['killers'].append(p)

def _fb_reward(world, feral):
    _fb_sync(world)
    st = FB['stats']
    buf, FB['buf'] = FB['buf'], None
    now = int(getattr(world, 'age', 0))
    if buf is None or buf['t'] != now or not buf['killers']:
        st['kills_no_killers'] += 1
        return
    killers = [s for s in buf['killers'] if s.alive and getattr(s, 'role_type', None) != 'feral']
    if not killers:
        st['kills_no_killers'] += 1
        return
    fury = float(getattr(feral, '_feral_fury', 1.0))
    fury_norm = float(np.clip((fury - 1.0) / 2.0, 0.0, 1.0))
    grat = float(Config.FB_GRATITUDE) * (1.0 + float(Config.FB_FURY_SCALE) * fury_norm)
    st['kills'] += 1
    for s in killers:
        em = s.emotional_memory
        g0 = float(em['gratitude'])
        em['gratitude'] = min(1.0, g0 + grat)
        st['gratitude_added_x1000'] += int(1000 * (float(em['gratitude']) - g0))
        if Config.FB_GRIEF_RELIEF > 0:
            em['grief'] = max(0.0, float(em['grief']) - float(Config.FB_GRIEF_RELIEF))
        s._fb_kills = int(getattr(s, '_fb_kills', 0)) + 1
        if Config.FB_ENERGY_BONUS > 0:
            got = s._x2_change("X2.feral_bounty_CREATION", float(s.energy) + float(Config.FB_ENERGY_BONUS))
            st['energy_created_x1000'] += int(1000 * got)
        st['rewarded'] += 1
    if Config.FB_TRUST and len(killers) > 1:
        for a in killers:
            for b in killers:
                if a is not b:
                    a.trust_ledger.update(b.id, 'helpful', multiplier=float(Config.FB_TRUST_MULT))
                    st['trust_updates'] += 1
    if st['kills'] <= int(Config.FB_VERBOSE):
        print(f"[FERAL-BOUNTY t={now}] ферал {getattr(feral, 'id', '?')} убит; награждены {[s.id for s in killers]}: "
              f"gratitude +{grat:.3f} (fury={fury:.2f}), grief -{Config.FB_GRIEF_RELIEF}, "
              f"energy +{Config.FB_ENERGY_BONUS}", flush=True)

class FeralBountyMixin:
    def _x2_change(self, name, new_value, offered=None):
        actual = super()._x2_change(name, new_value, offered)
        if name == "X2.scream_kill_reward" and Config.FB_ENABLE and self.world is not None:
            try:
                _fb_note_killer(self.world, self)
            except Exception as e:
                _fb_err(e)
        return actual

def fb_report():
    st = FB['stats']
    return {
        'kills_rewarded': int(st['kills']), 'agents_rewarded': int(st['rewarded']),
        'kills_without_killers': int(st['kills_no_killers']), 'buf_stale_dropped': int(st['buf_stale_dropped']),
        'mean_killers_per_kill': round(st['rewarded'] / max(1, st['kills']), 2),
        'mean_gratitude_added': round(st['gratitude_added_x1000'] / 1000.0 / max(1, st['rewarded']), 4),
        'trust_updates': int(st['trust_updates']),
        'energy_created': round(st['energy_created_x1000'] / 1000.0, 4),
        'errors': int(st['errors']), 'last_err': FB['last_err'],
        'config': {k_: getattr(Config, k_) for k_ in _FB_DEFAULTS},
    }

class FeralBountyEngineMixin:
    def _record_death_drag(self, p, cause):
        super()._record_death_drag(p, cause)
        if cause == "scream_kill" and Config.FB_ENABLE:
            try:
                _fb_reward(self, p)
            except Exception as e:
                _fb_err(e)

    def audit_summary(self):
        S = super().audit_summary()
        try:
            S['feral_bounty'] = fb_report()
        except Exception as e:
            _fb_err(e)
        return S

def _fb_metrics(patterns, field, t, lexicon=None):
    try:
        st = FB['stats']
        return {'fb_kills': int(st['kills']), 'fb_rewarded': int(st['rewarded']),
                'fb_trust_updates': int(st['trust_updates']),
                'fb_energy_created': round(st['energy_created_x1000'] / 1000.0, 4),
                'fb_errors': int(st['errors'])}
    except Exception:
        return {}

Pattern = extend_class(Pattern, FeralBountyMixin)
EvolutionEngine = extend_class(EvolutionEngine, FeralBountyEngineMixin)

if "register_metrics" in globals():
    register_metrics("feral_bounty", _fb_metrics)

print("✅ FERAL BOUNTY v1.1: за убийство ферала убийцы получают gratitude (+ярость), облегчение grief и взаимное доверие.")
print(f"   GRAT={Config.FB_GRATITUDE} FURY_SCALE={Config.FB_FURY_SCALE} GRIEF_RELIEF={Config.FB_GRIEF_RELIEF} "
      f"TRUST={Config.FB_TRUST} ENERGY_BONUS={Config.FB_ENERGY_BONUS} (0 = закон 832 не трогаем)")
print("   Ячейка ничего не запускает. Следующая — Ledger/RichEngine, запуск делает p832.")
