        if not Config.ENABLE_WITNESS:
            return
        self.log.append({"id": pattern_id, "event": event, **kwargs})
        self.counts[event] += 1

    def snapshot(self):
        return list(self.log)

    def summary(self):
        return Counter(self.counts)


