                    if num is None: num = 0.5
                    p.emotional_memory[key] = num
                elif not isinstance(val, (int, float)):
                    try: p.emotional_memory[key] = float(val) if val is not None else 0.5
                    except Exception: p.emotional_memory[key] = 0.5

