                            getattr(
                                p, "_nci", 0.0
                            )
                        ),
                        4
                    ),
                    "soul": round(
                        float(p.soul_weight),
                        4
                    ),
                    "shield": float(
                        p.protection_level
                    ),
                    "narrative": bool(
                        getattr(
                            p,
                            "_narrative_agent",
                            False
                        )
